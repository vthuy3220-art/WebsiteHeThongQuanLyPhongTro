@model HeThongQuanLyPhongTro.Models.Phong

@{
    ViewData["Title"] = "Chi tiết phòng";
}

<div class="max-w-2xl mx-auto">
    <div class="bg-white rounded-xl shadow-md overflow-hidden">
        <div class="bg-gradient-to-r from-blue-500 to-blue-600 px-6 py-4">
            <h1 class="text-xl font-bold text-white">Chi tiết phòng</h1>
            <p class="text-blue-100 text-sm">Thông tin chi tiết về phòng trọ</p>
        </div>

        <div class="p-6 space-y-4">
            <div class="grid grid-cols-2 gap-4">
                <div class="flex py-2 border-b">
                    <dt class="w-32 font-medium text-gray-600">Mã phòng:</dt>
                    <dd class="flex-1">@Model.MaPhong</dd>
                </div>
                <div class="flex py-2 border-b">
                    <dt class="w-32 font-medium text-gray-600">Tên phòng:</dt>
                    <dd class="flex-1 font-semibold">@Model.TenPhong</dd>
                </div>
                <div class="flex py-2 border-b">
                    <dt class="w-32 font-medium text-gray-600">Tòa nhà:</dt>
                    <dd class="flex-1">@Model.ToaNha?.TenToaNha</dd>
                </div>
                <div class="flex py-2 border-b">
                    <dt class="w-32 font-medium text-gray-600">Cơ sở:</dt>
                    <dd class="flex-1">@Model.ToaNha?.CoSo?.TenCoSo</dd>
                </div>
                <div class="flex py-2 border-b">
                    <dt class="w-32 font-medium text-gray-600">Địa chỉ:</dt>
                    <dd class="flex-1">@Model.ToaNha?.DiaChi</dd>
                </div>
                <div class="flex py-2 border-b">
                    <dt class="w-32 font-medium text-gray-600">Giá phòng:</dt>
                    <dd class="flex-1 font-bold text-blue-600">@Model.GiaPhong.ToString("N0") đ/tháng</dd>
                </div>
                <div class="flex py-2 border-b">
                    <dt class="w-32 font-medium text-gray-600">Diện tích:</dt>
                    <dd class="flex-1">@Model.DienTich m²</dd>
                </div>
                <div class="flex py-2 border-b">
                    <dt class="w-32 font-medium text-gray-600">Số người ở:</dt>
                    <dd class="flex-1">@(Model.SoLuongNguoiO ?? 1) người</dd>
                </div>
                <div class="flex py-2 border-b">
                    <dt class="w-32 font-medium text-gray-600">Trạng thái:</dt>
                    <dd class="flex-1">
                        @if (Model.TrangThai == "Trống")
                        {
                            <span class="px-2 py-1 bg-green-100 text-green-700 rounded-full text-sm">
                                <i class="fas fa-check-circle"></i> Còn trống
                            </span>
                        }
                        else
                        {
                            <span class="px-2 py-1 bg-red-100 text-red-700 rounded-full text-sm">
                                <i class="fas fa-lock"></i> Đã thuê
                            </span>
                        }
                    </dd>
                </div>
            </div>

            <div class="flex justify-end space-x-3 pt-4 border-t">
                <a asp-action="Edit" asp-route-id="@Model.MaPhong" class="px-4 py-2 bg-yellow-500 text-white rounded-lg hover:bg-yellow-600">
                    <i class="fas fa-edit mr-2"></i> Sửa
                </a>
                <a asp-action="Delete" asp-route-id="@Model.MaPhong" class="px-4 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600">
                    <i class="fas fa-trash mr-2"></i> Xóa
                </a>
                <a asp-action="Index" class="px-4 py-2 border rounded-lg hover:bg-gray-50 transition-all">
                    <i class="fas fa-arrow-left mr-2"></i> Quay lại
                </a>
            </div>
        </div>
    </div>
</div>