@model HeThongQuanLyPhongTro.Models.Phong

@{
    ViewData["Title"] = "Chi tiết phòng - " + Model.TenPhong;

    // Nạp danh sách ảnh và cơ sở vật chất từ ViewBag mà Backend gửi sang
    var images = ViewBag.Images as List<HeThongQuanLyPhongTro.Models.PhongImage> ?? new List<HeThongQuanLyPhongTro.Models.PhongImage>();
    var csvcList = ViewBag.CSVCNhanh as List<HeThongQuanLyPhongTro.Models.CoSoVatChat> ?? new List<HeThongQuanLyPhongTro.Models.CoSoVatChat>();

    // Tìm tấm ảnh được đánh dấu là ảnh chính, nếu không có thì lấy tấm đầu tiên
    var anhChinh = images.FirstOrDefault(i => i.IsMain) ?? images.FirstOrDefault();
}

<div class="max-w-6xl mx-auto px-4 py-6">

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

        <div class="lg:col-span-7 space-y-4">
            <div class="bg-white rounded-2xl shadow-sm border overflow-hidden relative">
                <div class="h-[400px] flex items-center justify-center bg-gray-50 relative">
                    @if (anhChinh != null)
                    {
                        <img id="mainImage" src="@anhChinh.ImagePath" class="w-full h-full object-cover" />

                        <button type="button" onclick="moPopupXoaAnh(event, @anhChinh.MaImage, @Model.MaPhong)" class="absolute top-3 right-3 bg-red-500 hover:bg-red-600 text-white w-8 h-8 rounded-full flex items-center justify-center shadow transition-all focus:outline-none z-10">
                            <i class="fas fa-trash text-sm"></i>
                        </button>
                    }
                    else
                    {
                        <div class="text-center text-gray-400">
                            <i class="fas fa-image text-6xl mb-2"></i>
                            <p class="text-sm">Phòng này chưa được cập nhật hình ảnh</p>
                        </div>
                    }
                </div>
            </div>

            @if (images.Count > 0)
            {
                <div class="grid grid-cols-4 gap-3">
                    @foreach (var img in images)
                    {
                        <div class="group relative border-2 rounded-xl overflow-hidden cursor-pointer transition-all hover:border-blue-500 @(img.IsMain ? "border-blue-500 ring-2 ring-blue-100" : "border-gray-200")"
                             onclick="changeMainImage('@img.ImagePath', this)">
                            <img src="@img.ImagePath" class="w-full h-20 object-cover thumbnail-item" />

                            <button type="button" onclick="moPopupXoaAnh(event, @img.MaImage, @Model.MaPhong)" class="absolute top-1 right-1 opacity-0 group-hover:opacity-100 transition-opacity bg-red-500 hover:bg-red-600 text-white w-5 h-5 rounded-full flex items-center justify-center shadow focus:outline-none z-10">
                                <i class="fas fa-times text-[10px]"></i>
                            </button>
                        </div>
                    }
                </div>
            }

            <div class="bg-white p-5 rounded-2xl border shadow-sm space-y-3">
                <h3 class="text-sm font-bold text-gray-700 flex items-center">
                    <i class="fas fa-camera mr-2 text-gray-500"></i> Thêm ảnh mới
                </h3>
                <form asp-action="UploadImage" method="post" enctype="multipart/form-data" class="flex flex-col sm:flex-row items-start sm:items-center gap-3">
                    <input type="hidden" name="maPhong" value="@Model.MaPhong" />

                    <input type="file" name="file" required class="flex-1 text-sm text-gray-500 border p-2 rounded-lg w-full bg-gray-50 file:mr-4 file:py-1 file:px-3 file:rounded-full file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" />

                    <div class="flex items-center space-x-4 w-full sm:w-auto justify-between sm:justify-start">
                        <label class="flex items-center space-x-2 text-sm text-gray-600 cursor-pointer select-none">
                            <input type="checkbox" name="isMain" value="true" class="w-4 h-4 rounded text-blue-600 border-gray-300 focus:ring-blue-500" />
                            <span>Ảnh chính</span>
                        </label>
                        <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2 rounded-lg text-sm font-semibold shadow transition-all">
                            Upload
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="lg:col-span-5">
            <div class="bg-white rounded-2xl shadow-sm border overflow-hidden">
                <div class="bg-blue-600 p-5 text-white">
                    <h2 class="text-lg font-bold tracking-wide">Chi tiết phòng</h2>
                    <p class="text-xs text-blue-100 mt-1">Thông tin chi tiết về phòng trọ và cơ sở hạ tầng</p>
                </div>

                <div class="p-6 space-y-3.5 text-sm">
                    <div class="flex justify-between py-2 border-b border-gray-100">
                        <span class="text-gray-500 font-medium">Mã phòng:</span>
                        <span class="font-mono text-gray-700 font-semibold">#@Model.MaPhong</span>
                    </div>
                    <div class="flex justify-between py-2 border-b border-gray-100">
                        <span class="text-gray-500 font-medium">Tên phòng:</span>
                        <span class="font-bold text-gray-900 text-base">@Model.TenPhong</span>
                    </div>
                    <div class="flex justify-between py-2 border-b border-gray-100">
                        <span class="text-gray-500 font-medium">Tòa nhà:</span>
                        <span class="font-semibold text-gray-800">@(Model.ToaNha?.TenToaNha ?? "Chưa rõ")</span>
                    </div>
                    <div class="flex justify-between py-2 border-b border-gray-100">
                        <span class="text-gray-500 font-medium">Cơ sở:</span>
                        <span class="font-semibold text-gray-800">@(Model.ToaNha?.CoSo?.TenCoSo ?? "Chưa rõ")</span>
                    </div>
                    <div class="flex justify-between py-2 border-b border-gray-100">
                        <span class="text-gray-500 font-medium">Địa chỉ:</span>
                        <span class="font-medium text-gray-600 text-right max-w-[65%]">@(Model.ToaNha?.DiaChi ?? "Chưa cập nhật")</span>
                    </div>
                    <div class="flex justify-between py-2 border-b border-gray-100 items-center">
                        <span class="text-gray-500 font-medium">Giá phòng:</span>
                        <span class="text-xl font-black text-blue-600">@Model.GiaPhong.ToString("N0") đ/tháng</span>
                    </div>
                    <div class="flex justify-between py-2 border-b border-gray-100">
                        <span class="text-gray-500 font-medium">Diện tích:</span>
                        <span class="font-bold text-gray-800">@Model.DienTich m²</span>
                    </div>
                    <div class="flex justify-between py-2 border-b border-gray-100 items-start">
                        <span class="text-gray-500 font-medium shrink-0">Cơ sở vật chất:</span>
                        <span class="font-medium text-right text-xs text-gray-700 max-w-[65%] leading-relaxed">
                            @if (csvcList.Any())
                            {
                                @string.Join(", ", csvcList.Select(c => c.TenThietBi))
                            }
                            else
                            {
                                <span class="text-gray-400 italic font-normal">Chưa thiết lập thiết bị</span>
                            }
                        </span>
                    </div>

                    <div class="flex justify-between py-2 border-b border-gray-100 items-center">
                        <span class="text-gray-500 font-medium">Trạng thái:</span>
                        <div>
                            @if (Model.TrangThai == "Trống")
                            {
                                <span class="px-2.5 py-1 bg-green-100 text-green-700 rounded-full text-xs font-bold flex items-center">
                                    <i class="fas fa-check-circle mr-1"></i> Còn trống
                                </span>
                            }
                            else
                            {
                                <span class="px-2.5 py-1 bg-red-100 text-red-700 rounded-full text-xs font-bold flex items-center">
                                    <i class="fas fa-lock mr-1"></i> Đã thuê
                                </span>
                            }
                        </div>
                    </div>

                    <div class="grid grid-cols-3 gap-2 pt-4">
                        <a asp-action="Edit" asp-route-id="@Model.MaPhong" class="bg-yellow-500 hover:bg-yellow-600 text-white text-center py-2 rounded-xl font-bold text-xs transition flex items-center justify-center">
                            <i class="fas fa-edit mr-1"></i> Sửa
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.MaPhong" class="bg-red-500 hover:bg-red-600 text-white text-center py-2 rounded-xl font-bold text-xs transition flex items-center justify-center">
                            <i class="fas fa-trash mr-1"></i> Xóa
                        </a>
                        <a asp-action="Index" class="border border-gray-300 hover:bg-gray-50 text-gray-700 text-center py-2 rounded-xl font-bold text-xs transition flex items-center justify-center">
                            <i class="fas fa-arrow-left mr-1"></i> Quay lại
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="deleteImageModal" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 hidden flex items-center justify-center opacity-0 transition-opacity duration-300">
    <div id="deleteImageModalContent" class="bg-white rounded-2xl shadow-2xl w-full max-w-sm mx-4 overflow-hidden transform scale-95 transition-transform duration-300 border border-gray-100">
        <div class="p-5 bg-slate-50 border-b border-slate-100 flex justify-between items-center">
            <h3 class="font-bold text-slate-800 text-sm md:text-base">Xác nhận xóa ảnh</h3>
            <button type="button" onclick="dongPopupXoaAnh()" class="p-1.5 text-slate-400 hover:text-slate-600 hover:bg-slate-200/50 rounded-lg transition-colors focus:outline-none">
                <i class="fas fa-times text-base"></i>
            </button>
        </div>
        <div class="p-6 space-y-4 text-sm text-slate-600 text-center">
            <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-2">
                <i class="fas fa-trash-alt text-red-500 text-2xl"></i>
            </div>
            <p>Bạn có chắc chắn muốn xóa vĩnh viễn hình ảnh này khỏi phòng không?</p>
        </div>
        <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex justify-end gap-2.5">
            <button type="button" onclick="dongPopupXoaAnh()" class="px-4 py-2 bg-gray-200 text-gray-700 font-bold text-xs rounded-xl hover:bg-gray-300 transition-colors focus:outline-none">
                Hủy
            </button>
            <form asp-action="DeleteImage" method="post" id="formDeleteImageModal" class="m-0 p-0">
                <input type="hidden" name="maImage" id="modalMaImage" value="" />
                <input type="hidden" name="maPhong" id="modalMaPhong" value="" />
                <button type="submit" id="btnConfirmDeleteImage" class="px-4 py-2 bg-red-500 hover:bg-red-600 text-white font-bold text-xs rounded-xl shadow-md shadow-red-500/10 transition-colors flex items-center justify-center min-w-[100px]">
                    Xác nhận
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    // Hàm hoán đổi ảnh lớn trên giao diện chi tiết phòng
    function changeMainImage(src, element) {
        document.getElementById('mainImage').src = src;

        document.querySelectorAll('.thumbnail-item').forEach(item => {
            item.parentElement.classList.remove('border-blue-500', 'ring-2', 'ring-blue-100');
            item.parentElement.classList.add('border-gray-200');
        });

        element.classList.remove('border-gray-200');
        element.classList.add('border-blue-500', 'ring-2', 'ring-blue-100');
    }

    // Hàm mở popup modal xóa hình ảnh độc lập (Không bị lan click event)
    function moPopupXoaAnh(e, maImage, maPhong) {
        if (e) {
            e.stopPropagation(); // Chặn hiện tượng lan sự kiện click
            e.preventDefault();
        }

        document.getElementById('modalMaImage').value = maImage;
        document.getElementById('modalMaPhong').value = maPhong;

        const modal = document.getElementById('deleteImageModal');
        const content = document.getElementById('deleteImageModalContent');

        modal.classList.remove('hidden');

        setTimeout(() => {
            modal.classList.remove('opacity-0');
            if (content) {
                content.classList.remove('scale-95');
            }
        }, 10);
    }

    // Hàm ẩn popup modal xóa ảnh
    function dongPopupXoaAnh() {
        const modal = document.getElementById('deleteImageModal');
        const content = document.getElementById('deleteImageModalContent');

        modal.classList.add('opacity-0');
        if (content) {
            content.classList.add('scale-95');
        }

        setTimeout(() => {
            modal.classList.add('hidden');
        }, 300);
    }

    // Thêm hiệu ứng loading spinner khi nhấn nút Xác nhận xóa
    document.getElementById('formDeleteImageModal').addEventListener('submit', function() {
        const btn = document.getElementById('btnConfirmDeleteImage');
        btn.style.pointerEvents = 'none';
        btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Đang xóa...';
    });
</script>