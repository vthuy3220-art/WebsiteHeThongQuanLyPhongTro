@model HeThongQuanLyPhongTro.Models.PhongImage

@{
    ViewData["Title"] = "Xác nhận xóa ảnh";
}

<div class="max-w-md mx-auto mt-10 p-6 bg-white rounded-lg shadow-md border border-gray-200">
    <h2 class="text-xl font-bold text-gray-800 mb-4 flex items-center gap-2">
        <i class="fas fa-exclamation-triangle text-red-500"></i> Xác nhận xóa ảnh
    </h2>

    <p class="text-gray-600 mb-6">Bạn có chắc chắn muốn xóa vĩnh viễn bức ảnh này khỏi hệ thống không? Hành động này không thể hoàn tác.</p>

    <div class="w-full h-48 bg-gray-100 rounded-lg overflow-hidden mb-6 border">
        <img src="@Model.ImagePath" alt="Ảnh xác nhận xóa" class="w-full h-full object-cover" />
    </div>

    <form asp-action="DeleteImage" method="post" asp-route-maImage="@Model.MaImage" asp-route-maPhong="@Model.MaPhong">
        <div class="flex gap-4">
            <a asp-action="Details" asp-route-id="@Model.MaPhong" class="flex-1 bg-gray-500 hover:bg-gray-600 text-white text-center py-2 rounded-lg transition-colors">
                <i class="fas fa-arrow-left mr-1"></i> Hủy bỏ
            </a>
            <button type="submit" class="flex-1 bg-red-500 hover:bg-red-600 text-white py-2 rounded-lg font-semibold transition-colors">
                <i class="fas fa-trash-alt mr-1"></i> Xác nhận Xóa
            </button>
        </div>
    </form>
</div>