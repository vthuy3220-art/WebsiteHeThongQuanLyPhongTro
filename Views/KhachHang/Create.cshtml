@model HeThongQuanLyPhongTro.Models.KhachHang

@{
    ViewData["Title"] = "Thêm khách hàng";
    Layout = "_Layout";
}

<div class="container mx-auto px-4 py-8">
    <div class="max-w-2xl mx-auto bg-white rounded-xl shadow-md overflow-hidden">
        <div class="bg-gradient-to-r from-blue-600 to-indigo-700 px-6 py-4">
            <h2 class="text-xl font-bold text-white flex items-center gap-2">
                <i class="fas fa-user-plus"></i> Thêm khách hàng mới
            </h2>
        </div>

        <div class="p-6">
            <form asp-action="Create" method="post">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="mb-4">
                        <label asp-for="HoTen" class="block text-gray-700 font-medium mb-2">Họ tên</label>
                        <input asp-for="HoTen" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" required />
                        <span asp-validation-for="HoTen" class="text-red-500 text-sm"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="SoDienThoai" class="block text-gray-700 font-medium mb-2">Số điện thoại</label>
                        <input asp-for="SoDienThoai" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                        <span asp-validation-for="SoDienThoai" class="text-red-500 text-sm"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="CCCD" class="block text-gray-700 font-medium mb-2">CCCD</label>
                        <input asp-for="CCCD" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                        <span asp-validation-for="CCCD" class="text-red-500 text-sm"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Email" class="block text-gray-700 font-medium mb-2">Email</label>
                        <input asp-for="Email" type="email" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                        <span asp-validation-for="Email" class="text-red-500 text-sm"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="DiaChi" class="block text-gray-700 font-medium mb-2">Địa chỉ</label>
                        <input asp-for="DiaChi" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                        <span asp-validation-for="DiaChi" class="text-red-500 text-sm"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="NgaySinh" class="block text-gray-700 font-medium mb-2">Ngày sinh</label>
                        <input asp-for="NgaySinh" type="date" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                        <span asp-validation-for="NgaySinh" class="text-red-500 text-sm"></span>
                    </div>
                </div>

                <div class="bg-blue-50 p-4 rounded-lg mb-4">
                    <h4 class="font-semibold text-blue-800 mb-2">🔐 Tạo tài khoản đăng nhập (tùy chọn)</h4>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-gray-700 font-medium mb-2">Tên đăng nhập</label>
                            <input type="text" name="tenDangNhap" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                        </div>
                        <div>
                            <label class="block text-gray-700 font-medium mb-2">Mật khẩu</label>
                            <input type="password" name="matKhau" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                        </div>
                    </div>
                    <p class="text-xs text-blue-600 mt-2">Để trống nếu chưa muốn tạo tài khoản ngay</p>
                </div>

                <div class="flex gap-3">
                    <button type="submit" class="flex-1 bg-green-500 hover:bg-green-600 text-white py-2 rounded-lg transition-all">
                        <i class="fas fa-save mr-2"></i> Lưu
                    </button>
                    <a asp-action="QuanLy" class="flex-1 bg-gray-300 hover:bg-gray-400 text-gray-700 text-center py-2 rounded-lg transition-all">
                        <i class="fas fa-arrow-left mr-2"></i> Hủy
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}