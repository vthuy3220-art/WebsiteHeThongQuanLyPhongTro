@model IEnumerable<HeThongQuanLyPhongTro.Models.HoaDon>

@{
    ViewData["Title"] = "Hóa đơn của tôi";
    Layout = "_Layout";
}

<div class="space-y-6">
    <div class="bg-white rounded-xl shadow-md overflow-hidden">
        <div class="bg-gradient-to-r from-orange-500 to-red-600 px-6 py-4">
            <h2 class="text-xl font-bold text-white flex items-center gap-2">
                <i class="fas fa-receipt"></i> Danh sách hóa đơn
            </h2>
        </div>

        <div class="p-6">
            @if (Model != null && Model.Any())
            {
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-4 py-3 text-left">Mã hóa đơn</th>
                                <th class="px-4 py-3 text-left">Tháng/Năm</th>
                                <th class="px-4 py-3 text-right">Tổng tiền</th>
                                <th class="px-4 py-3 text-left">Trạng thái</th>
                                <th class="px-4 py-3 text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr class="border-b hover:bg-gray-50">
                                    <td class="px-4 py-3">@item.MaHoaDon</td>
                                    <td class="px-4 py-3">@item.Thang/@item.Nam</td>
                                    <td class="px-4 py-3 text-right font-semibold @(item.TrangThai == "Chưa thanh toán" ? "text-red-600" : "text-green-600")">
                                        @String.Format("{0:N0}", item.TongTien) VNĐ
                                    </td>
                                    <td class="px-4 py-3">
                                        @if (item.TrangThai == "Chưa thanh toán")
                                        {
                                            <span class="px-2 py-1 bg-red-100 text-red-700 rounded-full text-xs">Chưa thanh toán</span>
                                        }
                                        else
                                        {
                                            <span class="px-2 py-1 bg-green-100 text-green-700 rounded-full text-xs">Đã thanh toán</span>
                                        }
                                    </td>
                                    <td class="px-4 py-3 text-center">
                                        <a asp-controller="KhachHang" asp-action="HoaDonChiTiet" asp-route-id="@item.MaHoaDon">
                                            <i class="fas fa-eye"></i> Chi tiết
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-12">
                    <i class="fas fa-receipt text-gray-300 text-5xl mb-3"></i>
                    <p class="text-gray-500">Chưa có hóa đơn nào</p>
                </div>
            }
        </div>
    </div>
</div>