@{
    ViewData["Title"] = "Đổi mật khẩu";
    Layout = "_Layout";
}

<div class="container mx-auto px-4 py-8">
    <div class="max-w-md mx-auto bg-white rounded-xl shadow-md overflow-hidden">
        <div class="bg-gradient-to-r from-blue-600 to-indigo-700 px-6 py-4">
            <h2 class="text-xl font-bold text-white flex items-center gap-2">
                <i class="fas fa-key"></i> Đổi mật khẩu
            </h2>
        </div>

        <div class="p-6">
            @if (TempData["Success"] != null)
            {
                <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-3 mb-4 rounded">
                    <i class="fas fa-check-circle mr-2"></i> @TempData["Success"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-3 mb-4 rounded">
                    <i class="fas fa-exclamation-circle mr-2"></i> @TempData["Error"]
                </div>
            }

            <form method="post">
                <div class="mb-4">
                    <label class="block text-gray-700 font-medium mb-2">Mật khẩu cũ</label>
                    <input type="password" name="matKhauCu" required
                           class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>

                <div class="mb-4">
                    <label class="block text-gray-700 font-medium mb-2">Mật khẩu mới</label>
                    <input type="password" name="matKhauMoi" required minlength="6"
                           class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <p class="text-xs text-gray-500 mt-1">Mật khẩu phải có ít nhất 6 ký tự</p>
                </div>

                <div class="mb-6">
                    <label class="block text-gray-700 font-medium mb-2">Xác nhận mật khẩu mới</label>
                    <input type="password" name="xacNhanMatKhau" required
                           class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>

                <div class="flex gap-3">
                    <button type="submit" class="flex-1 bg-blue-500 hover:bg-blue-600 text-white py-2 rounded-lg transition-all">
                        <i class="fas fa-save mr-2"></i> Đổi mật khẩu
                    </button>
                    <a asp-action="Dashboard" class="flex-1 bg-gray-300 hover:bg-gray-400 text-gray-700 text-center py-2 rounded-lg transition-all">
                        <i class="fas fa-arrow-left mr-2"></i> Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>