@model IEnumerable<HeThongQuanLyPhongTro.Models.KhachHang>

@{
    ViewData["Title"] = "Quản lý khách hàng";
    Layout = "_Layout";
}

<div class="space-y-6">

    <!-- Alert Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 border-l-4 border-green-500 text-green-700 p-4 rounded-xl shadow-sm text-sm font-medium">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="bg-red-50 border-l-4 border-red-500 text-red-700 p-4 rounded-xl shadow-sm text-sm font-medium">
            @TempData["Error"]
        </div>
    }

    <!-- Search -->
    <div class="bg-white rounded-xl shadow-md p-4 border border-slate-100">
        <form method="get" class="flex gap-4">
            <div class="flex-1">
                <div class="relative">
                    <i class="fas fa-search absolute left-3 top-3 text-gray-400"></i>
                    <input type="text" name="searchString" value="@ViewBag.SearchString"
                           placeholder="Tìm theo tên, SĐT, CCCD..."
                           class="w-full pl-10 pr-4 py-2 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500">
                </div>
            </div>
            <button type="submit" class="bg-blue-500 text-white px-6 py-2 rounded-lg hover:bg-blue-600 transition-all font-semibold shadow-sm">
                Tìm kiếm
            </button>
        </form>
    </div>

    <!-- Table -->
    <div class="bg-white rounded-xl shadow-md overflow-hidden border border-slate-100">
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-gray-50 border-b border-gray-100">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Mã KH</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Họ tên</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">SĐT</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">CCCD</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Email</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Tài khoản</th>
                        <th class="px-6 py-3 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-gray-50/80 transition-colors font-medium text-slate-700">
                            <td class="px-6 py-4 font-mono text-slate-400 text-sm">@item.MaKhachHang</td>
                            <td class="px-6 py-4 font-bold text-slate-900">@item.HoTen</td>
                            <td class="px-6 py-4 font-mono text-sm">@item.SoDienThoai</td>
                            <td class="px-6 py-4 font-mono text-sm">@item.CCCD</td>
                            <td class="px-6 py-4 text-sm">@item.Email</td>
                            <td class="px-6 py-4">
                                @if (item.MaTaiKhoan.HasValue && item.MaTaiKhoan.Value > 0)
                                {
                                    <span class="px-3 py-1 bg-emerald-50 text-emerald-600 border border-emerald-200 rounded-md text-xs font-bold whitespace-nowrap inline-block text-center w-20">
                                        Đã có
                                    </span>
                                }
                                else
                                {
                                    <span class="px-3 py-1 bg-red-50 text-red-500 border border-red-100 rounded-md text-xs font-bold whitespace-nowrap inline-block text-center w-20">
                                        Chưa có
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex justify-center space-x-3 items-center">
                                    <a asp-action="Details" asp-route-id="@item.MaKhachHang"
                                       class="text-blue-500 hover:text-blue-700 transition-colors" title="Chi tiết">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.MaKhachHang"
                                       class="text-yellow-500 hover:text-yellow-700 transition-colors" title="Sửa">
                                        <i class="fas fa-edit"></i>
                                    </a>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-12">
                <i class="fas fa-users text-gray-300 text-5xl mb-3"></i>
                <p class="text-gray-500 text-sm">Chưa có khách hàng nào</p>
                <a asp-action="Create" class="inline-block mt-3 text-blue-500 hover:underline font-semibold text-sm">Thêm khách hàng đầu tiên</a>
            </div>
        }
    </div>
</div>




