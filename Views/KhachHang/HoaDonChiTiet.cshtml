@model HeThongQuanLyPhongTro.Models.HoaDon

@{
    ViewData["Title"] = "Chi tiết hóa đơn";
    Layout = "_Layout";
    var hopDong = ViewBag.HopDong as HeThongQuanLyPhongTro.Models.HopDong;
    var phong = hopDong?.PhongNavigation;
    var soNguoi = ViewBag.SoNguoi ?? 1;
    var chiSoDienCu = ViewBag.ChiSoDienCu ?? 0;
    var chiSoDienMoi = ViewBag.ChiSoDienMoi ?? 0;
    var chiSoNuocCu = ViewBag.ChiSoNuocCu ?? 0;
    var chiSoNuocMoi = ViewBag.ChiSoNuocMoi ?? 0;
    var giaDien = ViewBag.GiaDien ?? 3500;
    var giaNuoc = ViewBag.GiaNuoc ?? 30000;
    var tienPhatSinh = ViewBag.TienPhatSinh ?? 0;
    var tongTien = ViewBag.TongTien ?? Model.TongTien ?? 0;

    var soDien = Math.Max(0, chiSoDienMoi - chiSoDienCu);
    var soNuoc = Math.Max(0, chiSoNuocMoi - chiSoNuocCu);
    var tienDien = soDien * giaDien;
    var tienNuoc = soNuoc * giaNuoc;
    var tienDichVu = soNguoi * 200000;
}

<div class="max-w-3xl mx-auto space-y-4">
    @if (Model.TrangThai == "Đã thanh toán")
    {
        <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-3 rounded">
            <i class="fas fa-check-circle mr-2"></i> ✅ Hóa đơn này đã được thanh toán.
        </div>
    }

    <!-- Hóa đơn -->
    <div class="bg-white rounded-xl shadow-md overflow-hidden">
        <div class="bg-gradient-to-r from-blue-600 to-indigo-700 px-6 py-3">
            <h2 class="text-xl font-bold text-white">🧾 HÓA ĐƠN TIỀN PHÒNG</h2>
            <p class="text-white text-sm">Mã: @Model.MaHoaDon.ToString("00000")</p>
        </div>
        <div class="p-5">
            <div class="grid grid-cols-2 gap-3 text-sm mb-4 pb-3 border-b">
                <div><span class="font-semibold">Phòng:</span> @phong?.TenPhong</div>
                <div><span class="font-semibold">Khách hàng:</span> @hopDong?.KhachHangNavigation?.HoTen</div>
                <div><span class="font-semibold">Tháng:</span> @Model.Thang/@Model.Nam</div>
                <div><span class="font-semibold">Hạn thanh toán:</span> <span class="text-red-600">@(Model.NgayTao?.AddDays(7).ToString("dd/MM/yyyy") ?? "N/A")</span></div>
            </div>

            <table class="w-full text-sm">
                <thead class="bg-gray-100">
                    <tr class="border-b">
                        <th class="p-2 text-left">Khoản mục</th>
                        <th class="p-2 text-left">Chi tiết</th>
                        <th class="p-2 text-right">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    <tr class="border-b"><td class="p-2">Tiền phòng</td><td class="p-2">@phong?.TenPhong</td><td class="p-2 text-right">@String.Format("{0:N0}", phong?.GiaPhong) đ</td></tr>
                    <tr class="border-b"><td class="p-2">Tiền điện</td><td class="p-2">@soDien kWh × @String.Format("{0:N0}", giaDien) đ</td><td class="p-2 text-right">@String.Format("{0:N0}", tienDien) đ</td></tr>
                    <tr class="border-b"><td class="p-2">Tiền nước</td><td class="p-2">@soNuoc m³ × @String.Format("{0:N0}", giaNuoc) đ</td><td class="p-2 text-right">@String.Format("{0:N0}", tienNuoc) đ</td></tr>
                    <tr class="border-b"><td class="p-2">Phí dịch vụ</td><td class="p-2">@soNguoi người × 200.000đ</td><td class="p-2 text-right">@String.Format("{0:N0}", tienDichVu) đ</td></tr>
                    @if (tienPhatSinh > 0)
                    {
                        <tr class="border-b"><td class="p-2">Phí phát sinh</td><td class="p-2">Sửa chữa/phát sinh</td><td class="p-2 text-right">@String.Format("{0:N0}", tienPhatSinh) đ</td></tr>
                    }
                </tbody>
                <tfoot class="bg-yellow-50">
                    <tr><td colspan="2" class="p-2 font-bold">Tổng cộng</td><td class="p-2 text-right font-bold text-red-600">@String.Format("{0:N0}", tongTien) đ</td></tr>
                </tfoot>
            </table>
        </div>
    </div>

    <!-- QR và nút xác nhận -->
    @if (Model.TrangThai == "Chưa thanh toán")
    {
        <div class="bg-white rounded-xl shadow-md p-5 text-center">
            <h3 class="font-bold text-lg mb-3">📱 Quét mã QR để thanh toán</h3>
            <img src="/images/qr_code.jpg" class="mx-auto w-36 h-36" />
            <div class="mt-3 text-left bg-gray-50 p-3 rounded-lg text-sm">
                <p><strong>Ngân hàng:</strong> Techcombank</p>
                <p><strong>Số tài khoản:</strong> 19072789933016</p>
                <p><strong>Chủ tài khoản:</strong> Vũ Thị Thanh Thúy</p>
                <p><strong>Nội dung:</strong> <span class="font-mono text-blue-600">TT_HD@Model.MaHoaDon_@Model.Thang@Model.Nam</span></p>
                <p><strong>Số tiền:</strong> <span class="font-bold text-red-600">@String.Format("{0:N0}", tongTien) đ</span></p>
            </div>

            @if (Model.KhachXacNhan != true)
            {
                <div class="bg-yellow-50 rounded-lg p-3 mt-4">
                    <p class="text-yellow-800 text-sm mb-2">Sau khi chuyển khoản thành công, bấm nút bên dưới để xác nhận!</p>
                    <form method="post" asp-action="KhachXacNhan" asp-controller="HoaDon" id="frmXacNhan">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.MaHoaDon" />
                        <button type="submit" class="bg-blue-500 text-white px-4 py-2 rounded-lg w-full hover:bg-blue-600">
                            <i class="fas fa-check-circle mr-2"></i> Tôi đã chuyển khoản
                        </button>
                    </form>
                </div>
            }
            else
            {
                <div class="bg-green-50 rounded-lg p-3 mt-4">
                    <p class="text-green-800">Đã gửi xác nhận! Chủ trọ sẽ kiểm tra và cập nhật.</p>
                </div>
            }
        </div>
    }

    <!-- Nút quay lại -->
    <div class="flex gap-3">
        <a asp-action="HoaDonCuaToi" class="bg-gray-500 text-white px-4 py-2 rounded-lg text-center hover:bg-gray-600">
            <i class="fas fa-arrow-left mr-2"></i> Quay lại
        </a>
        <a asp-action="XuatPdf" asp-controller="HoaDon" asp-route-id="@Model.MaHoaDon" target="_blank" class="bg-red-500 text-white px-4 py-2 rounded-lg text-center hover:bg-red-600">
            <i class="fas fa-file-pdf mr-2"></i> Xuất PDF
        </a>
    </div>
</div>