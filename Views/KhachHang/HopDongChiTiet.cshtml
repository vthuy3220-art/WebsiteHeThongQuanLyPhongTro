@model HeThongQuanLyPhongTro.Models.HopDong

@{
    ViewData["Title"] = "Chi tiết hợp đồng";
    var nguoiOList = ViewBag.NguoiOList as List<HeThongQuanLyPhongTro.Models.NguoiOHopDong>;
    var hoaDons = ViewBag.HoaDons as List<HeThongQuanLyPhongTro.Models.HoaDon>;
}

<div class="max-w-4xl mx-auto space-y-6">
    <!-- Thông tin hợp đồng -->
    <div class="bg-white rounded-xl shadow-md overflow-hidden">
        <div class="bg-gradient-to-r from-blue-600 to-indigo-700 px-6 py-4">
            <h2 class="text-xl font-bold text-white">📄 Chi tiết hợp đồng</h2>
        </div>
        <div class="p-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div><span class="font-semibold">Mã hợp đồng:</span> @Model.MaHopDong</div>
                <div><span class="font-semibold">Phòng:</span> @Model.PhongNavigation?.TenPhong</div>
                <div><span class="font-semibold">Ngày bắt đầu:</span> @(Model.NgayBatDau?.ToString("dd/MM/yyyy") ?? "N/A")</div>
                <div><span class="font-semibold">Ngày kết thúc:</span> @(Model.NgayKetThuc?.ToString("dd/MM/yyyy") ?? "N/A")</div>
                <div><span class="font-semibold">Tiền cọc:</span> @String.Format("{0:N0}", Model.TienCoc) đ</div>
                <div>
                    <span class="font-semibold">Trạng thái:</span>
                    @if (Model.TrangThai == "Hiệu lực")
                    {
                        <span class="px-2 py-1 bg-green-100 text-green-700 rounded-full text-xs">Hiệu lực</span>
                    }
                    else
                    {
                        <span class="px-2 py-1 bg-gray-100 text-gray-600 rounded-full text-xs">Đã kết thúc</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Danh sách người ở -->
    <div class="bg-white rounded-xl shadow-md overflow-hidden">
        <div class="bg-gray-50 px-6 py-3 border-b">
            <h3 class="font-semibold">👥 Danh sách người ở</h3>
        </div>
        <div class="p-4">
            @if (nguoiOList != null && nguoiOList.Any())
            {
                <table class="w-full">
                    <thead class="bg-gray-100">
                        <tr class="border-b">
                            <th class="p-2 text-left">STT</th>
                            <th class="p-2 text-left">Họ tên</th>
                            <th class="p-2 text-left">CCCD</th>
                            <th class="p-2 text-left">Số điện thoại</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in nguoiOList.Select((value, i) => new { i, value }))
                        {
                            <tr class="border-b">
                                <td class="p-2">@(item.i + 1)</td>
                                <td class="p-2">@item.value.HoTen</td>
                                <td class="p-2">@item.value.CCCD</td>
                                <td class="p-2">@item.value.SoDienThoai</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-gray-500 text-center">Không có người ở cùng</p>
            }
        </div>
    </div>

    <!-- Hóa đơn -->
    <div class="bg-white rounded-xl shadow-md overflow-hidden">
        <div class="bg-gray-50 px-6 py-3 border-b">
            <h3 class="font-semibold">🧾 Hóa đơn</h3>
        </div>
        <div class="p-4">
            @if (hoaDons != null && hoaDons.Any())
            {
                <table class="w-full">
                    <thead class="bg-gray-100">
                        <tr class="border-b">
                            <th class="p-2 text-left">Tháng/Năm</th>
                            <th class="p-2 text-right">Tổng tiền</th>
                            <th class="p-2 text-left">Trạng thái</th>
                            <th class="p-2 text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in hoaDons)
                        {
                            <tr class="border-b">
                                <td class="p-2">@item.Thang/@item.Nam</td>
                                <td class="p-2 text-right">@String.Format("{0:N0}", item.TongTien) đ</td>
                                <td class="p-2">
                                    @if (item.TrangThai == "Đã thanh toán")
                                    {
                                        <span class="px-2 py-1 bg-green-100 text-green-700 rounded-full text-xs">Đã thanh toán</span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-1 bg-red-100 text-red-700 rounded-full text-xs">Chưa thanh toán</span>
                                    }
                                </td>
                                <td class="p-2 text-center">
                                    <a asp-controller="KhachHang" asp-action="HoaDonChiTiet" asp-route-id="@item.MaHoaDon"
                                       class="text-blue-500 hover:underline">Chi tiết</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-gray-500 text-center">Chưa có hóa đơn nào</p>
            }
        </div>
    </div>

    <!-- Nút quay lại -->
    <div class="flex gap-3">
        <a asp-action="HopDongCuaToi" class="bg-gray-500 text-white px-4 py-2 rounded-lg text-center hover:bg-gray-600">
            <i class="fas fa-arrow-left mr-2"></i> Quay lại
        </a>
        <a asp-action="XuatPdf" asp-controller="HopDong" asp-route-id="@Model.MaHopDong" target="_blank"
           class="bg-red-500 text-white px-4 py-2 rounded-lg text-center hover:bg-red-600">
            <i class="fas fa-file-pdf mr-2"></i> Xuất PDF
        </a>
    </div>
</div>
