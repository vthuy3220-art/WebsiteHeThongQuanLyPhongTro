@model IEnumerable<HeThongQuanLyPhongTro.Models.ThanhToan>

@{
    ViewData["Title"] = "Lịch sử thanh toán";
    Layout = "_Layout";
}

<div class="bg-white rounded-xl shadow-md overflow-hidden">
    <div class="bg-gradient-to-r from-blue-600 to-indigo-700 px-6 py-4">
        <h2 class="text-xl font-bold text-white flex items-center gap-2">
            <i class="fas fa-history"></i> Lịch sử thanh toán
        </h2>
    </div>

    <div class="p-6">
        @if (Model != null && Model.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-4 py-3 text-left">Mã thanh toán</th>
                            <th class="px-4 py-3 text-left">Mã hóa đơn</th>
                            <th class="px-4 py-3 text-left">Ngày thanh toán</th>
                            <th class="px-4 py-3 text-right">Số tiền</th>
                            <th class="px-4 py-3 text-center">Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="border-b hover:bg-gray-50">
                                <td class="px-4 py-3">@item.MaThanhToan</td>
                                <td class="px-4 py-3">@item.MaHoaDon</td>
                                <td class="px-4 py-3">@(item.NgayThanhToan?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</td>
                                <td class="px-4 py-3 text-right text-green-600 font-semibold">@String.Format("{0:N0}", item.SoTien) VNĐ</td>
                                <td class="px-4 py-3 text-center">
                                    <span class="px-2 py-1 bg-green-100 text-green-700 rounded-full text-xs">@item.TrangThai</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-12">
                <i class="fas fa-credit-card text-gray-300 text-5xl mb-3"></i>
                <p class="text-gray-500">Chưa có lịch sử thanh toán nào</p>
            </div>
        }
    </div>
</div>