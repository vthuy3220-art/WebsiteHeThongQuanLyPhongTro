@model IEnumerable<HeThongQuanLyPhongTro.Models.HopDong>

@{
    ViewData["Title"] = "Hợp đồng của tôi";
    Layout = "_Layout";
}

<div class="bg-white rounded-xl shadow-md overflow-hidden">
    <div class="bg-gradient-to-r from-blue-600 to-indigo-700 px-6 py-4">
        <h2 class="text-xl font-bold text-white">📄 Danh sách hợp đồng của tôi</h2>
    </div>
    <div class="p-4">
        @if (Model != null && Model.Any())
        {
            <table class="w-full">
                <thead class="bg-gray-100">
                    <tr class="border-b">
                        <th class="p-2 text-left">Mã HĐ</th>
                        <th class="p-2 text-left">Phòng</th>
                        <th class="p-2 text-left">Ngày bắt đầu</th>
                        <th class="p-2 text-left">Ngày kết thúc</th>
                        <th class="p-2 text-left">Tiền cọc</th>
                        <th class="p-2 text-left">Trạng thái</th>
                        <th class="p-2 text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="border-b">
                            <td class="p-2">@item.MaHopDong</td>
                            <td class="p-2">@item.PhongNavigation?.TenPhong</td>
                            <td class="p-2">@item.NgayBatDau?.ToString("dd/MM/yyyy")</td>
                            <td class="p-2">@item.NgayKetThuc?.ToString("dd/MM/yyyy")</td>
                            <td class="p-2">@String.Format("{0:N0}", item.TienCoc) đ</td>
                            <td class="p-2">
                                @if (item.TrangThai == "Hiệu lực")
                                {
                                    <span class="px-2 py-1 bg-green-100 text-green-700 rounded-full text-xs">Hiệu lực</span>
                                }
                                else
                                {
                                    <span class="px-2 py-1 bg-gray-100 text-gray-600 rounded-full text-xs">Đã kết thúc</span>
                                }
                            </td>
                            <td class="p-2 text-center">
                                <a asp-action="HopDongChiTiet" asp-route-id="@item.MaHopDong" class="text-blue-500 hover:text-blue-700">
                                    <i class="fas fa-eye"></i> Xem
                                </a>
                                <!-- KHÔNG CÓ NÚT CHẤM DỨT HỢP ĐỒNG Ở ĐÂY -->
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-8">
                <i class="fas fa-file-contract text-gray-300 text-5xl mb-3"></i>
                <p class="text-gray-500">Bạn chưa có hợp đồng nào</p>
            </div>
        }
    </div>
</div>