@model IEnumerable<HeThongQuanLyPhongTro.Models.HopDong>

@{
    ViewData["Title"] = "Hợp đồng của tôi";
    Layout = "_Layout";
}

<div class="bg-white rounded-xl shadow-md overflow-hidden">
    <div class="bg-gradient-to-r from-blue-600 to-indigo-700 px-6 py-4">
        <h2 class="text-xl font-bold text-white flex items-center gap-2">
            <i class="fas fa-file-contract"></i> Danh sách hợp đồng
        </h2>
    </div>

    <div class="p-6">
        @if (Model != null && Model.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-4 py-3 text-left">Mã hợp đồng</th>
                            <th class="px-4 py-3 text-left">Mã phòng</th>
                            <th class="px-4 py-3 text-left">Ngày bắt đầu</th>
                            <th class="px-4 py-3 text-left">Ngày kết thúc</th>
                            <th class="px-4 py-3 text-left">Tiền cọc</th>
                            <th class="px-4 py-3 text-left">Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="border-b hover:bg-gray-50">
                                <td class="px-4 py-3">@item.MaHopDong</td>
                                <td class="px-4 py-3">@item.MaPhong</td>
                                <td class="px-4 py-3">@(item.NgayBatDau?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                                <td class="px-4 py-3">@(item.NgayKetThuc?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                                <td class="px-4 py-3">@String.Format("{0:N0}", item.TienCoc) VNĐ</td>
                                <td class="px-4 py-3">
                                    @if (item.TrangThai == "Hiệu lực")
                                    {
                                        <span class="px-2 py-1 bg-green-100 text-green-700 rounded-full text-xs">Hiệu lực</span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-1 bg-gray-100 text-gray-600 rounded-full text-xs">Hết hiệu lực</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-12">
                <i class="fas fa-file-contract text-gray-300 text-5xl mb-3"></i>
                <p class="text-gray-500">Bạn chưa có hợp đồng nào</p>
            </div>
        }
    </div>
</div>