@model HeThongQuanLyPhongTro.Models.KhachHang

@{
    ViewData["Title"] = "Xóa khách hàng";
}

<div class="max-w-3xl mx-auto mt-8 px-4">
    <div class="bg-white rounded-xl shadow-lg overflow-hidden border border-gray-100">

        <!-- Phần Header (Màu đỏ chuẩn) -->
        <div class="bg-red-600 px-8 py-5">
            <div class="flex justify-between items-center">
                <div>
                    <h1 class="text-2xl font-bold text-white mb-1">Xóa khách hàng</h1>
                    <p class="text-red-100 text-sm font-medium">Mã KH: @Model.MaKhachHang</p>
                </div>
                <a asp-action="QuanLy" class="text-white hover:text-red-200 flex items-center font-medium transition-colors">
                    <i class="fas fa-arrow-left mr-2"></i> Quay lại
                </a>
            </div>
        </div>

        <div class="p-8">
            <!-- Hộp thoại cảnh báo -->
            @if (ViewBag.HasContract == true)
            {
                <div class="bg-red-50 border-l-4 border-red-500 p-5 mb-8 flex items-start rounded-r-lg">
                    <i class="fas fa-exclamation-circle text-red-500 mt-0.5 mr-4 text-xl"></i>
                    <div>
                        <p class="text-red-800 font-bold text-lg mb-1">Không thể xóa khách hàng này!</p>
                        <p class="text-red-600">@ViewBag.Error</p>
                    </div>
                </div>
            }
            else
            {
                <div class="bg-yellow-50 border-l-4 border-yellow-400 p-5 mb-8 flex items-start rounded-r-lg">
                    <i class="fas fa-exclamation-triangle text-yellow-500 mt-0.5 mr-4 text-xl"></i>
                    <div>
                        <p class="text-yellow-700 font-bold text-lg mb-1">Bạn có chắc chắn muốn xóa khách hàng này?</p>
                        <p class="text-yellow-600 text-sm">Hành động này không thể khôi phục!</p>
                    </div>
                </div>
            }

            <!-- Hộp thông tin (Gộp thành một khối xám như yêu cầu) -->
            <div class="bg-gray-50 rounded-xl p-6 mb-8">
                <h3 class="text-lg font-bold text-gray-700 mb-5 border-b pb-3">Thông tin khách hàng</h3>

                <dl class="grid grid-cols-1 md:grid-cols-2 gap-y-6 gap-x-8">
                    <div>
                        <dt class="text-gray-500 text-sm font-medium mb-1">Họ tên</dt>
                        <dd class="text-gray-900 font-bold text-base">@Model.HoTen</dd>
                    </div>
                    <div>
                        <dt class="text-gray-500 text-sm font-medium mb-1">Số điện thoại</dt>
                        <dd class="text-gray-900 font-bold text-base">
                            @(string.IsNullOrEmpty(Model.SoDienThoai) ? "Chưa cập nhật" : Model.SoDienThoai)
                        </dd>
                    </div>
                    <div>
                        <dt class="text-gray-500 text-sm font-medium mb-1">CCCD</dt>
                        <dd class="text-gray-900 font-bold text-base">
                            @(string.IsNullOrEmpty(Model.CCCD) ? "Chưa cập nhật" : Model.CCCD)
                        </dd>
                    </div>
                    <div>
                        <dt class="text-gray-500 text-sm font-medium mb-1">Email</dt>
                        <dd class="text-gray-900 font-bold text-base">
                            @(string.IsNullOrEmpty(Model.Email) ? "Chưa cập nhật" : Model.Email)
                        </dd>
                    </div>
                    <div class="md:col-span-2">
                        <dt class="text-gray-500 text-sm font-medium mb-1">Địa chỉ</dt>
                        <dd class="text-gray-900 font-bold text-base">
                            @(string.IsNullOrEmpty(Model.DiaChi) ? "Chưa cập nhật" : Model.DiaChi)
                        </dd>
                    </div>
                </dl>
            </div>

            <!-- Nút Action -->
            <form asp-action="Delete" class="flex justify-end gap-3 pt-2">
                <input type="hidden" name="id" value="@Model.MaKhachHang" />
                <a asp-action="QuanLy" class="px-6 py-2.5 bg-white border border-gray-300 text-gray-700 font-medium rounded-lg hover:bg-gray-50 transition-colors focus:ring-2 focus:ring-gray-200">
                    Hủy
                </a>

                @if (ViewBag.HasContract != true)
                {
                    <button type="submit" class="px-6 py-2.5 bg-red-500 text-white font-medium rounded-lg hover:bg-red-600 transition-colors focus:ring-2 focus:ring-red-300 flex items-center shadow-sm">
                        <i class="fas fa-trash-alt mr-2"></i> Xóa
                    </button>
                }
            </form>
        </div>
    </div>
</div>