<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hệ thống quản lý phòng trọ</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        * {
            font-family: 'Inter', sans-serif;
        }

        .sidebar::-webkit-scrollbar {
            width: 5px;
        }

        .sidebar::-webkit-scrollbar-track {
            background: #2d3748;
        }

        .sidebar::-webkit-scrollbar-thumb {
            background: #4a5568;
            border-radius: 5px;
        }

        .transition-all {
            transition: all 0.3s ease;
        }

        #listThongBao::-webkit-scrollbar {
            width: 4px;
        }

        #listThongBao::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        #listThongBao::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
    </style>
</head>
<body class="bg-gray-100">

    @{
        var role = Context.Session.GetString("Role");
        var username = Context.Session.GetString("Username");
    }

    @if (role == "Admin")
    {
        <div class="flex h-screen">
            <div class="w-72 bg-gradient-to-b from-gray-900 to-gray-800 text-white flex flex-col shadow-2xl sidebar overflow-y-auto">
                <div class="p-6 border-b border-gray-700">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 bg-gradient-to-r from-blue-500 to-blue-600 rounded-xl flex items-center justify-center shadow-lg">
                            <i class="fas fa-building text-white text-xl"></i>
                        </div>
                        <div>
                            <h1 class="text-xl font-bold tracking-wide">Phòng Trọ Xinh</h1>
                            <p class="text-xs text-gray-400">Quản lý phòng trọ</p>
                        </div>
                    </div>
                </div>

                <div class="p-4 mx-3 mt-4 bg-gray-800 rounded-xl">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 bg-blue-500 rounded-full flex items-center justify-center">
                            <i class="fas fa-user text-white"></i>
                        </div>
                        <div class="flex-1">
                            <p class="font-semibold">@username</p>
                            <p class="text-xs text-gray-400">Quản trị viên</p>
                        </div>
                    </div>
                </div>

                <nav class="flex-1 px-3 py-6 space-y-1">
                    <p class="text-xs text-gray-500 uppercase tracking-wider px-3 pb-2">Trang chính</p>
                    <a asp-controller="Dashboard" asp-action="Index" class="flex items-center px-3 py-3 rounded-xl text-gray-300 hover:bg-gray-700 hover:text-white transition-all">
                        <i class="fas fa-chart-pie w-5 h-5 mr-3 text-gray-400"></i><span>Dashboard</span>
                    </a>

                    <p class="text-xs text-gray-500 uppercase tracking-wider px-3 pt-4 pb-2">Quản lý</p>
                    <a asp-controller="CoSo" asp-action="Index" class="flex items-center px-3 py-3 rounded-xl text-gray-300 hover:bg-gray-700 hover:text-white transition-all">
                        <i class="fas fa-building w-5 h-5 mr-3 text-gray-400"></i><span>Cơ sở</span>
                    </a>
                    <a asp-controller="Phong" asp-action="Index" class="flex items-center px-3 py-3 rounded-xl text-gray-300 hover:bg-gray-700 hover:text-white transition-all">
                        <i class="fas fa-door-open w-5 h-5 mr-3 text-gray-400"></i><span>Phòng trọ</span>
                    </a>
                    <a asp-controller="KhachHang" asp-action="Index" class="flex items-center px-3 py-3 rounded-xl text-gray-300 hover:bg-gray-700 hover:text-white transition-all">
                        <i class="fas fa-users w-5 h-5 mr-3 text-gray-400"></i><span>Khách hàng</span>
                    </a>
                    <a asp-controller="HopDong" asp-action="Index" class="flex items-center px-3 py-3 rounded-xl text-gray-300 hover:bg-gray-700 hover:text-white transition-all">
                        <i class="fas fa-file-contract w-5 h-5 mr-3 text-gray-400"></i><span>Hợp đồng</span>
                    </a>
                    <a asp-controller="NguoiOHopDongs" asp-action="Index" class="flex items-center px-3 py-3 rounded-xl text-gray-300 hover:bg-gray-700 hover:text-white transition-all">
                        <i class="fas fa-user-friends w-5 h-5 mr-3 text-gray-400"></i><span>Người ở</span>
                    </a>
                    <a asp-controller="CoSoVatChats" asp-action="Index" class="flex items-center px-3 py-3 rounded-xl text-gray-300 hover:bg-gray-700 hover:text-white transition-all">
                        <i class="fas fa-microchip w-5 h-5 mr-3 text-gray-400"></i><span>Cơ sở vật chất</span>
                    </a>
                    <a asp-controller="YeuCauSuaChua" asp-action="Index" class="flex items-center px-3 py-3 rounded-xl text-gray-300 hover:bg-gray-700 hover:text-white transition-all">
                        <i class="fas fa-tools w-5 h-5 mr-3 text-gray-400"></i><span>Yêu cầu sửa chữa</span>
                    </a>
                    <a asp-controller="TaiKhoans" asp-action="Index" class="flex items-center px-3 py-3 rounded-xl text-gray-300 hover:bg-gray-700 hover:text-white transition-all">
                        <i class="fas fa-user-cog w-5 h-5 mr-3 text-gray-400"></i><span>Tài khoản</span>
                    </a>

                    <p class="text-xs text-gray-500 uppercase tracking-wider px-3 pt-4 pb-2">Tài chính</p>
                    <a asp-controller="HoaDon" asp-action="Index" class="flex items-center px-3 py-3 rounded-xl text-gray-300 hover:bg-gray-700 hover:text-white transition-all">
                        <i class="fas fa-receipt w-5 h-5 mr-3 text-gray-400"></i><span>Hóa đơn</span>
                    </a>
                    <a asp-controller="ChiTietHoaDons" asp-action="Index" class="flex items-center px-3 py-3 rounded-xl text-gray-300 hover:bg-gray-700 hover:text-white transition-all">
                        <i class="fas fa-list-ul w-5 h-5 mr-3 text-gray-400"></i><span>Chi tiết hóa đơn</span>
                    </a>
                    <a asp-controller="ThanhToans" asp-action="Index" class="flex items-center px-3 py-3 rounded-xl text-gray-300 hover:bg-gray-700 hover:text-white transition-all">
                        <i class="fas fa-money-bill-wave w-5 h-5 mr-3 text-gray-400"></i><span>Thanh toán</span>
                    </a>
                    <a asp-controller="ThongKe" asp-action="Index" class="flex items-center px-4 py-3 text-gray-300 hover:bg-gray-800 hover:text-white rounded-lg transition-colors mt-1">
                        <i class="fas fa-chart-pie w-5 h-5 mr-3 text-center"></i><span>Thống kê</span>
                    </a>

                    <p class="text-xs text-gray-500 uppercase tracking-wider px-3 pt-4 pb-2">Truyền thông</p>
                    <a asp-controller="BaiDang" asp-action="Index" class="flex items-center px-3 py-3 rounded-xl text-gray-300 hover:bg-gray-700 hover:text-white transition-all">
                        <i class="fas fa-newspaper w-5 h-5 mr-3 text-gray-400"></i><span>Bài đăng</span>
                    </a>
                </nav>

                <div class="p-4 border-t border-gray-700">
                    <a asp-controller="Login" asp-action="Logout" class="flex items-center px-3 py-3 rounded-xl text-gray-400 hover:bg-red-500/20 hover:text-red-400 transition-all">
                        <i class="fas fa-sign-out-alt w-5 h-5 mr-3"></i><span>Đăng xuất</span>
                    </a>
                </div>
            </div>

            <div class="flex-1 overflow-y-auto relative">
                <header class="bg-white shadow-sm sticky top-0 z-40">
                    <div class="flex justify-between items-center px-8 py-4">
                        <div>
                            <h1 class="text-2xl font-bold text-gray-800">@ViewData["Title"]</h1>
                            <p class="text-sm text-gray-500 mt-1">Chào mừng bạn trở lại, @username</p>
                        </div>
                        <div class="flex items-center space-x-4">
                            <div class="relative mr-3" id="notificationWrapper">
                                <button id="bellButton" class="p-2 text-gray-500 hover:text-gray-800 hover:bg-gray-100 rounded-full transition-colors focus:outline-none relative">
                                    <i class="fas fa-bell text-xl"></i>
                                    <span id="badgeCount" class="absolute top-0 right-0 transform translate-x-1/4 -translate-y-1/4 bg-red-500 text-white text-[10px] font-bold rounded-full min-w-[20px] h-[20px] flex items-center justify-center hidden px-1 border-2 border-white shadow-sm">0</span>
                                </button>

                                <div id="bellDropdown" class="absolute right-0 mt-2 w-80 md:w-96 bg-white rounded-xl shadow-2xl hidden z-50 border border-gray-100 overflow-hidden transition-all origin-top-right">
                                    <div class="p-4 bg-gray-50 border-b flex justify-between items-center">
                                        <h3 class="font-bold text-gray-700">Thông báo <span id="header-unread-count" class="text-blue-500 font-semibold">(0)</span></h3>
                                        <button id="markAllRead" class="text-xs font-medium text-blue-500 hover:text-blue-700 hover:underline">Đánh dấu tất cả đã đọc</button>
                                    </div>

                                    <div id="listThongBao" class="max-h-[60vh] overflow-y-auto bg-white">
                                        <div class="p-8 text-center text-gray-400">
                                            <i class="fas fa-circle-notch fa-spin text-2xl mb-2"></i>
                                            <p class="text-sm">Đang tải...</p>
                                        </div>
                                    </div>

                                    <div class="p-3 text-center border-t bg-gray-50 hover:bg-gray-100 transition-colors">
                                        <a href="@Url.Action("Index", "ThongBao")" class="text-sm font-medium text-gray-600 hover:text-blue-600">Xem tất cả thông báo</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </header>

                <main class="p-6">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else if (role == "Khach")
    {
        <div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100">
            <nav class="bg-white shadow-lg sticky top-0 z-50">
                <div class="container mx-auto px-4 py-3">
                    <div class="flex justify-between items-center flex-wrap gap-3">
                        <div class="flex items-center space-x-3">
                            <div class="w-10 h-10 bg-gradient-to-r from-blue-500 to-indigo-600 rounded-lg flex items-center justify-center">
                                <i class="fas fa-home text-white text-xl"></i>
                            </div>
                            <div>
                                <h1 class="text-xl font-bold text-gray-800">Phòng Trọ Xinh</h1>
                                <p class="text-xs text-gray-500">Xin chào, @username</p>
                            </div>
                        </div>
                        <div class="flex flex-wrap items-center gap-4">
                            <a asp-controller="KhachHang" asp-action="Dashboard" class="text-sm font-medium text-gray-600 hover:text-blue-600 transition-colors">Dashboard</a>
                            <a asp-controller="KhachHang" asp-action="HopDongCuaToi" class="text-sm font-medium text-gray-600 hover:text-blue-600 transition-colors">Hợp đồng</a>
                            <a asp-controller="KhachHang" asp-action="HoaDonCuaToi" class="text-sm font-medium text-gray-600 hover:text-blue-600 transition-colors">Hóa đơn</a>
                            <a asp-controller="YeuCauSuaChua" asp-action="TaoYeuCau" class="text-sm font-medium text-orange-600 hover:text-orange-700 transition-colors">Yêu cầu sửa chữa</a>
                            <a asp-controller="YeuCauSuaChua" asp-action="YeuCauCuaToi" class="text-sm font-medium text-gray-600 hover:text-blue-600 transition-colors">Yêu cầu của tôi</a>
                            <a asp-controller="KhachHang" asp-action="DoiMatKhau" class="text-sm font-medium text-gray-600 hover:text-blue-600 transition-colors">Đổi mật khẩu</a>

                            <div class="w-px h-5 bg-gray-300 hidden md:block"></div>

                            <div class="relative" id="notificationWrapper">
                                <button id="bellButton" class="p-2 text-gray-500 hover:text-blue-600 hover:bg-blue-50 rounded-full transition-colors focus:outline-none relative">
                                    <i class="fas fa-bell text-lg"></i>
                                    <span id="badgeCount" class="absolute top-0 right-0 transform translate-x-1/4 -translate-y-1/4 bg-red-500 text-white text-[10px] font-bold rounded-full min-w-[18px] h-[18px] flex items-center justify-center hidden px-1 shadow-sm">0</span>
                                </button>

                                <div id="bellDropdown" class="absolute right-0 mt-2 w-80 bg-white rounded-xl shadow-2xl hidden z-50 border border-gray-100 overflow-hidden transition-all origin-top-right">
                                    <div class="p-4 bg-gray-50 border-b flex justify-between items-center">
                                        <h3 class="font-bold text-gray-700 text-sm">Thông báo <span id="header-unread-count" class="text-blue-500 font-semibold">(0)</span></h3>
                                        <button id="markAllRead" class="text-xs font-medium text-blue-500 hover:text-blue-700 hover:underline">Đánh dấu tất cả đã đọc</button>
                                    </div>

                                    <div id="listThongBao" class="max-h-[60vh] overflow-y-auto bg-white">
                                        <div class="p-8 text-center text-gray-400">
                                            <i class="fas fa-circle-notch fa-spin text-2xl mb-2"></i>
                                            <p class="text-sm">Đang tải...</p>
                                        </div>
                                    </div>

                                    <div class="p-3 text-center border-t bg-gray-50 hover:bg-gray-100 transition-colors">
                                        <a href="@Url.Action("Index", "ThongBao")" class="text-sm font-medium text-gray-600 hover:text-blue-600">Xem tất cả thông báo</a>
                                    </div>
                                </div>
                            </div>

                            <a asp-controller="Login" asp-action="Logout" class="text-sm font-medium text-red-500 hover:text-red-700 ml-2"><i class="fas fa-sign-out-alt"></i></a>
                        </div>
                    </div>
                </div>
            </nav>
            <div class="container mx-auto px-4 py-6">
                @RenderBody()
            </div>
        </div>
    }
    else
    {
        <div class="container mx-auto px-4 py-8">
            @RenderBody()
        </div>
    }

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @Html.AntiForgeryToken()

    <script>
        // Hàm load dữ liệu danh sách thông báo
        function loadThongBao() {
        fetch('/ThongBao/GetList')
        .then(res => res.json())
        .then(data => {
        const badge = document.getElementById('badgeCount');
        const headerCount = document.getElementById('header-unread-count');
        const list = document.getElementById('listThongBao');

        if (data && data.length > 0) {
        const unreadCount = data.filter(x => !x.daXem).length;

        // Cập nhật số đếm
        if (unreadCount > 0) {
        badge.classList.remove('hidden');
        badge.innerText = unreadCount > 99 ? '99+' : unreadCount;
        headerCount.innerText = `(${unreadCount} mới)`;
        } else {
        badge.classList.add('hidden');
        headerCount.innerText = `(0 mới)`;
        }

        // Render danh sách
        list.innerHTML = data.map(tb => {
        let iconClass = 'fa-bell text-blue-500';
        if(tb.loai === 'success') iconClass = 'fa-check-circle text-green-500';

        const tbId = tb.id || tb.maThongBao || '';
        const bgClass = tb.daXem ? 'bg-white' : 'bg-blue-50/20';
        const titleStyle = tb.daXem ? 'font-medium text-gray-700' : 'font-bold text-black';
        const contentStyle = tb.daXem ? 'text-gray-500' : 'font-semibold text-gray-800';
        const timeStyle = tb.daXem ? 'text-gray-400' : 'text-blue-500 font-medium';
        const blueDot = !tb.daXem ? `<div class="w-3 h-3 bg-blue-600 rounded-full shrink-0 shadow-sm mt-2"></div>` : '';

        return `
        <div class="p-4 border-b border-gray-100 hover:bg-gray-50 cursor-pointer transition-colors ${bgClass}"
        onclick="viewNotification('${tbId}', '${tb.duongDan}')">
        <div class="flex items-start justify-between gap-3">
        <div class="flex items-start flex-1">
        <div class="mt-1 w-8 h-8 rounded-full flex items-center justify-center shrink-0">
        <i class="fas ${iconClass} text-lg"></i>
        </div>
        <div class="flex-1 ml-3">
        <div class="text-sm line-clamp-1 ${titleStyle}">${tb.tieuDe}</div>
        <div class="text-xs mt-1 line-clamp-2 leading-relaxed ${contentStyle}">${tb.noiDung}</div>
        <div class="text-[11px] mt-2 flex items-center ${timeStyle}">
        <i class="far fa-clock mr-1"></i> ${tb.ngayTao}
        </div>
        </div>
        </div>
        ${blueDot}
        </div>
        </div>
        `;
        }).join('');
        } else {
        badge.classList.add('hidden');
        headerCount.innerText = `(0 mới)`;
        list.innerHTML = `
        <div class="p-8 flex flex-col items-center justify-center text-gray-400">
        <i class="fas fa-inbox text-4xl mb-3 text-gray-300"></i>
        <p class="text-sm">Chưa có thông báo nào</p>
        </div>`;
        }
        })
        .catch(err => {
        console.error("Lỗi khi tải thông báo:", err);
        const listObj = document.getElementById('listThongBao');
        if(listObj) listObj.innerHTML = '<div class="p-4 text-center text-red-400 text-sm">Lỗi tải dữ liệu</div>';
        });
        }

        // Hàm xem chi tiết
        window.viewNotification = function(id, link) {
        if(id) {
        fetch(`/ThongBao/MarkAsRead?id=${id}`, { method: 'POST' })
        .then(() => {
        if (link && link !== 'null' && link !== '') {
        window.location.href = link;
        } else {
        loadThongBao();
        }
        });
        } else {
        if (link && link !== 'null' && link !== '') {
        window.location.href = link;
        }
        }
        };

        // Kích hoạt khi trang đã tải xong
        document.addEventListener('DOMContentLoaded', function() {
        const bellBtn = document.getElementById('bellButton');
        const dropdown = document.getElementById('bellDropdown');
        const wrapper = document.getElementById('notificationWrapper');
        const markAllBtn = document.getElementById('markAllRead');

        // Chỉ gắn sự kiện nếu tìm thấy cái chuông (tránh lỗi màn hình Login)
        if (bellBtn && wrapper && dropdown) {
        bellBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        dropdown.classList.toggle('hidden');
        if (!dropdown.classList.contains('hidden')) {
        loadThongBao();
        }
        });

        document.addEventListener('click', function(event) {
        if (!wrapper.contains(event.target)) {
        dropdown.classList.add('hidden');
        }
        });

        if(markAllBtn) {
        markAllBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        fetch('/ThongBao/MarkAllAsRead', { method: 'POST' })
        .then(() => loadThongBao());
        });
        }

        // Load dữ liệu lần đầu và tạo luồng cập nhật tự động
        loadThongBao();
        setInterval(loadThongBao, 30000);
        }
        });
    </script>
</body>
</html>