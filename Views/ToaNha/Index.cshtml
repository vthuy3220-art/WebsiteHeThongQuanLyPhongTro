@model IEnumerable<HeThongQuanLyPhongTro.Models.ToaNha>

@{
    ViewData["Title"] = "Quản lý tòa nhà";
    Layout = "_Layout";
}

<div class="space-y-6">
    <div class="flex justify-between items-center">
        <a asp-action="Create" class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg transition-all">
            <i class="fas fa-plus mr-2"></i> Thêm tòa nhà
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 rounded">
            <i class="fas fa-check-circle mr-2"></i> @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 rounded">
            <i class="fas fa-exclamation-circle mr-2"></i> @TempData["Error"]
        </div>
    }

    <!-- Search -->
    <div class="bg-white rounded-xl shadow-md p-4">
        <form method="get" class="flex gap-4">
            <div class="flex-1">
                <div class="relative">
                    <i class="fas fa-search absolute left-3 top-3 text-gray-400"></i>
                    <input type="text" name="searchString" value="@ViewBag.SearchString"
                           placeholder="Tìm theo tên tòa nhà..."
                           class="w-full pl-10 pr-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
            </div>
            <button type="submit" class="bg-blue-500 text-white px-6 py-2 rounded-lg hover:bg-blue-600 transition-all">
                <i class="fas fa-search mr-2"></i> Tìm kiếm
            </button>
            @if (!string.IsNullOrEmpty(ViewBag.SearchString))
            {
                <a asp-action="Index" class="bg-gray-300 hover:bg-gray-400 text-gray-700 px-6 py-2 rounded-lg transition-all">
                    <i class="fas fa-times mr-2"></i> Xóa
                </a>
            }
        </form>
    </div>

    <!-- Table -->
    <div class="bg-white rounded-xl shadow-md overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-gray-50">
                    <tr class="border-b">
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Mã</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Tên tòa nhà</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Địa chỉ</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Khu vực</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Chủ trọ</th>
                        <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-gray-50 transition-all">
                            <td class="px-6 py-4 text-sm">@item.MaToaNha</td>
                            <td class="px-6 py-4 font-medium text-gray-800">@item.TenToaNha</td>
                            <td class="px-6 py-4 text-sm text-gray-600">@item.DiaChi</td>
                            <td class="px-6 py-4 text-sm">
                                <span class="px-2 py-1 bg-blue-100 text-blue-700 rounded-full text-xs">
                                    @item.CoSo?.TenCoSo
                                </span>
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-600">@item.ChuTro?.TenDangNhap</td>
                            <td class="px-6 py-4 text-center">
                                <div class="flex justify-center space-x-3">
                                    <a asp-action="Details" asp-route-id="@item.MaToaNha"
                                       class="text-blue-500 hover:text-blue-700 transition" title="Chi tiết">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.MaToaNha"
                                       class="text-yellow-500 hover:text-yellow-700 transition" title="Sửa">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.MaToaNha"
                                       class="text-red-500 hover:text-red-700 transition" title="Xóa"
                                       onclick="return confirm('Bạn có chắc muốn xóa tòa nhà @item.TenToaNha?')">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-12">
                <i class="fas fa-building text-gray-300 text-5xl mb-3"></i>
                <p class="text-gray-500">Chưa có tòa nhà nào</p>
                <a asp-action="Create" class="inline-block mt-3 text-blue-500 hover:underline">Thêm tòa nhà đầu tiên</a>
            </div>
        }
    </div>
</div>