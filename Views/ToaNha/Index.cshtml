@model IEnumerable<HeThongQuanLyPhongTro.Models.ToaNha>

@{
    ViewData["Title"] = "Quản lý tòa nhà";
    Layout = "_Layout";
}

<div class="space-y-6">
    <div class="flex justify-between items-center">
        <a asp-action="Create" class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg transition-all shadow-sm">
            <i class="fas fa-plus mr-2"></i> Thêm tòa nhà
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 border-l-4 border-green-500 text-green-700 p-4 rounded-xl shadow-sm text-sm font-medium">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="bg-red-50 border-l-4 border-red-500 text-red-700 p-4 rounded-xl shadow-sm text-sm font-medium">
            @TempData["Error"]
        </div>
    }

    <!-- Search -->
    <div class="bg-white rounded-xl shadow-md p-4 border border-slate-100">
        <form method="get" class="flex gap-4">
            <div class="flex-1">
                <div class="relative">
                    <i class="fas fa-search absolute left-3 top-3 text-gray-400"></i>
                    <input type="text" name="searchString" value="@ViewBag.SearchString"
                           placeholder="Tìm theo tên tòa nhà..."
                           class="w-full pl-10 pr-4 py-2 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500">
                </div>
            </div>
            <button type="submit" class="bg-blue-500 text-white px-6 py-2 rounded-lg hover:bg-blue-600 transition-all font-semibold shadow-sm">
                Tìm kiếm
            </button>
            @if (!string.IsNullOrEmpty(ViewBag.SearchString))
            {
                <a asp-action="Index" class="bg-gray-300 hover:bg-gray-400 text-gray-700 px-6 py-2 rounded-lg transition-all font-medium">
                    Xóa
                </a>
            }
        </form>
    </div>

    <!-- Table -->
    <div class="bg-white rounded-xl shadow-md overflow-hidden border border-slate-100">
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-gray-50 border-b border-gray-100">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Mã</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Tên tòa nhà</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Địa chỉ</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Khu vực</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Chủ trọ</th>
                        <th class="px-6 py-3 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-gray-50/80 transition-colors font-medium text-slate-700">
                            <td class="px-6 py-4 font-mono text-slate-400 text-sm">@item.MaToaNha</td>
                            <td class="px-6 py-4 font-bold text-slate-900">@item.TenToaNha</td>
                            <td class="px-6 py-4 text-sm text-gray-600">@item.DiaChi</td>
                            <td class="px-6 py-4 text-sm">
                                <span class="px-2.5 py-0.5 bg-blue-50 text-blue-700 border border-blue-200 rounded-full text-xs font-bold">
                                    @item.CoSo?.TenCoSo
                                </span>
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-600">@item.ChuTro?.TenDangNhap</td>
                            <td class="px-6 py-4">
                                <div class="flex justify-center space-x-3 items-center">
                                    <a asp-action="Details" asp-route-id="@item.MaToaNha"
                                       class="text-blue-500 hover:text-blue-700 transition-colors" title="Chi tiết">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.MaToaNha"
                                       class="text-yellow-500 hover:text-yellow-700 transition-colors" title="Sửa">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <button type="button"
                                            onclick="moPopupXoaToaNha('/ToaNha/Delete/@item.MaToaNha', '@item.TenToaNha', '@item.DiaChi')"
                                            class="text-red-500 hover:text-red-700 transition-colors focus:outline-none" title="Xóa">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-12">
                <i class="fas fa-building text-gray-300 text-5xl mb-3"></i>
                <p class="text-gray-500 text-sm">Chưa có tòa nhà nào</p>
                <a asp-action="Create" class="inline-block mt-3 text-blue-500 hover:underline font-semibold text-sm">Thêm tòa nhà đầu tiên</a>
            </div>
        }
    </div>
</div>

<!-- ==================== KHỐI POPUP MODAL TAILWIND CỠ LỚN (MAX-W-LG) SẠCH BÁCH ICON ==================== -->
<div id="deleteToaNhaModal" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 flex items-center justify-center hidden opacity-0 transition-opacity duration-300">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg mx-4 overflow-hidden transform scale-95 transition-transform duration-300 border border-gray-100">
        <!-- Header -->
        <div class="p-5 bg-slate-50 border-b border-slate-100 flex justify-between items-center">
            <h3 class="font-bold text-slate-800 text-sm md:text-base">
                Xác nhận gỡ bỏ tòa nhà khỏi hệ thống
            </h3>
            <button onclick="dongPopupXoaToaNha()" class="p-1.5 text-slate-400 hover:text-slate-600 hover:bg-slate-200/50 rounded-lg transition-colors focus:outline-none">
                <i class="fas fa-times text-base"></i>
            </button>
        </div>
        <!-- Body -->
        <div class="p-6 space-y-4 text-sm text-slate-600 leading-relaxed">
            <p>Bạn có chắc chắn muốn xóa vĩnh viễn tòa nhà này không?</p>

            <div class="bg-red-50/40 border border-red-100 rounded-xl p-4 space-y-2 text-slate-700 font-medium">
                <div class="flex items-center gap-1.5">
                    <span class="text-gray-400 font-normal w-24 inline-block">Tên tòa nhà:</span>
                    <span class="text-slate-900 font-bold text-base" id="popupToaNhaName">N/A</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="text-gray-400 font-normal w-24 inline-block">Địa chỉ:</span>
                    <span class="text-slate-600" id="popupToaNhaAddress">N/A</span>
                </div>
            </div>

            <p class="text-xs text-slate-400 font-normal">Chú ý: Khi xóa tòa nhà, toàn bộ dữ liệu phòng trọ, danh sách thiết bị cơ sở vật chất và lịch sử thu chi thuộc tòa nhà này cũng sẽ bị xóa hoàn toàn khỏi cơ sở dữ liệu.</p>
        </div>
        <!-- Footer -->
        <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex justify-end gap-2.5">
            <button onclick="dongPopupXoaToaNha()" type="button" class="px-4 py-2 bg-gray-200 text-gray-700 font-bold text-xs rounded-xl hover:bg-gray-300 transition-colors focus:outline-none">
                Hủy
            </button>
            <a id="btnConfirmDeleteToaNha" href="#" class="px-4 py-2 bg-red-500 hover:bg-red-600 text-white font-bold text-xs rounded-xl shadow-md shadow-red-500/10 transition-colors flex items-center justify-center">
                Xác nhận xóa
            </a>
        </div>
    </div>
</div>

<script>
    function moPopupXoaToaNha(deleteUrl, toaNhaName, diaChi) {
        //  ĐỀN BÙ ÔNG ANH: Sửa chuẩn biến chữ thường 'toaNhaName' ở đây để hết lỗi đơ nút!
        document.getElementById('popupToaNhaName').innerText = toaNhaName;
        document.getElementById('popupToaNhaAddress').innerText = diaChi ? diaChi : 'Chưa cập nhật địa chỉ';

        const confirmBtn = document.getElementById('btnConfirmDeleteToaNha');
        confirmBtn.setAttribute('href', deleteUrl);

        const modal = document.getElementById('deleteToaNhaModal');
        modal.classList.remove('hidden');
        setTimeout(() => {
            modal.classList.remove('opacity-0');
            modal.querySelector('.transform').classList.remove('scale-95');
        }, 10);

        confirmBtn.onclick = function() {
            this.style.pointerEvents = 'none';
            this.innerText = 'Đang xóa...';
        };
    }

    function dongPopupXoaToaNha() {
        const modal = document.getElementById('deleteToaNhaModal');
        modal.classList.add('opacity-0');
        modal.querySelector('.transform').classList.add('scale-95');
        setTimeout(() => modal.classList.add('hidden'), 300);
    }

    window.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            dongPopupXoaToaNha();
        }
    });
</script>