@{
    ViewData["Title"] = "Tạo hợp đồng mới";
    Layout = "_Layout";
    var phongList = ViewBag.PhongList as List<HeThongQuanLyPhongTro.Models.Phong>;
    var khachHangList = ViewBag.KhachHangList as List<HeThongQuanLyPhongTro.Models.KhachHang>;
}

<div class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto bg-white rounded-xl shadow-md overflow-hidden">
        <div class="bg-gradient-to-r from-green-600 to-teal-700 px-6 py-4">
            <h2 class="text-xl font-bold text-white flex items-center gap-2">
                <i class="fas fa-file-signature"></i> Tạo hợp đồng thuê trọ
            </h2>
        </div>

        <div class="p-6">
            <form method="post" id="hopDongForm">
                <!-- ========== CHỌN PHÒNG ========== -->
                <div class="mb-6">
                    <label class="block text-gray-700 font-bold mb-2">🏠 Chọn phòng</label>
                    <select name="maPhong" id="maPhong" class="w-full px-4 py-2 border rounded-lg" required>
                        <option value="">-- Chọn phòng trống --</option>
                        @if (phongList != null)
                        {
                            foreach (var phong in phongList)
                            {
                                <option value="@phong.MaPhong" data-gia="@phong.GiaPhong">
                                    @phong.TenPhong - @String.Format("{0:N0}", phong.GiaPhong) đ/tháng
                                </option>
                            }
                        }
                    </select>
                </div>

                <!-- ========== THÔNG TIN KHÁCH HÀNG ========== -->
                <div class="bg-blue-50 p-4 rounded-lg mb-6">
                    <h3 class="font-bold text-blue-800 mb-3">👤 Thông tin khách hàng (Người đại diện)</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-gray-700 text-sm mb-1">Họ tên *</label>
                            <input type="text" name="HoTen" id="HoTen" class="w-full px-3 py-2 border rounded-lg" required />
                        </div>
                        <div>
                            <label class="block text-gray-700 text-sm mb-1">Số điện thoại *</label>
                            <input type="text" name="SoDienThoai" id="SoDienThoai" class="w-full px-3 py-2 border rounded-lg" required />
                        </div>
                        <div>
                            <label class="block text-gray-700 text-sm mb-1">CCCD/CMND</label>
                            <input type="text" name="CCCD" id="CCCD" class="w-full px-3 py-2 border rounded-lg" />
                        </div>
                        <div>
                            <label class="block text-gray-700 text-sm mb-1">Email</label>
                            <input type="email" name="Email" id="Email" class="w-full px-3 py-2 border rounded-lg" />
                        </div>
                        <div>
                            <label class="block text-gray-700 text-sm mb-1">Địa chỉ</label>
                            <input type="text" name="DiaChi" id="DiaChi" class="w-full px-3 py-2 border rounded-lg" />
                        </div>
                        <div>
                            <label class="block text-gray-700 text-sm mb-1">Ngày sinh</label>
                            <input type="date" name="NgaySinh" id="NgaySinh" class="w-full px-3 py-2 border rounded-lg" />
                        </div>
                    </div>
                </div>

                <!-- ========== TẠO TÀI KHOẢN ========== -->
                <div class="bg-yellow-50 p-4 rounded-lg mb-6">
                    <div class="flex items-center mb-3">
                        <input type="checkbox" id="taoTaiKhoan" name="taoTaiKhoan" value="true" class="w-4 h-4 mr-2" />
                        <label for="taoTaiKhoan" class="font-bold text-yellow-800">🔐 Tạo tài khoản đăng nhập cho khách hàng</label>
                    </div>
                    <div id="thongTinTaiKhoan" style="display: none;" class="grid grid-cols-1 md:grid-cols-2 gap-4 ml-6">
                        <div>
                            <label class="block text-gray-700 text-sm mb-1">Tên đăng nhập</label>
                            <input type="text" name="tenDangNhap" id="tenDangNhap" class="w-full px-3 py-2 border rounded-lg" />
                        </div>
                        <div>
                            <label class="block text-gray-700 text-sm mb-1">Mật khẩu</label>
                            <input type="password" name="matKhau" id="matKhau" class="w-full px-3 py-2 border rounded-lg" />
                        </div>
                    </div>
                    <p class="text-xs text-yellow-600 mt-2 ml-6">Khách hàng sẽ dùng tài khoản này để đăng nhập xem phòng, hợp đồng, hóa đơn</p>
                </div>

                <!-- ========== DANH SÁCH NGƯỜI Ở ========== -->
                <div class="bg-gray-50 p-4 rounded-lg mb-6">
                    <h3 class="font-bold text-gray-700 mb-3">👥 Danh sách người ở cùng</h3>
                    <div id="nguoiOList">
                        <div class="nguoiOItem grid grid-cols-1 md:grid-cols-3 gap-3 mb-2">
                            <input type="text" name="NguoiOHoTen" placeholder="Họ tên" class="px-3 py-2 border rounded-lg" />
                            <input type="text" name="NguoiOCCCD" placeholder="CCCD" class="px-3 py-2 border rounded-lg" />
                            <input type="text" name="NguoiOSDT" placeholder="Số điện thoại" class="px-3 py-2 border rounded-lg" />
                        </div>
                    </div>
                    <button type="button" onclick="themNguoiO()" class="text-blue-500 text-sm mt-2">
                        <i class="fas fa-plus"></i> Thêm người ở
                    </button>
                </div>

                <!-- ========== THÔNG TIN HỢP ĐỒNG ========== -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                    <div>
                        <label class="block text-gray-700 font-bold mb-2">📅 Ngày bắt đầu</label>
                        <input type="date" name="ngayBatDau" id="ngayBatDau" class="w-full px-4 py-2 border rounded-lg" required />
                    </div>
                    <div>
                        <label class="block text-gray-700 font-bold mb-2">📅 Ngày kết thúc</label>
                        <input type="date" name="ngayKetThuc" id="ngayKetThuc" class="w-full px-4 py-2 border rounded-lg" required />
                    </div>
                    <div>
                        <label class="block text-gray-700 font-bold mb-2">💰 Tiền cọc</label>
                        <input type="number" name="tienCoc" id="tienCoc" class="w-full px-4 py-2 border rounded-lg" required />
                    </div>
                    <div>
                        <label class="block text-gray-700 font-bold mb-2">💵 Giá phòng</label>
                        <input type="text" id="giaPhongHienThi" class="w-full px-4 py-2 border rounded-lg bg-gray-100" readonly />
                    </div>
                </div>

                <div class="flex gap-3">
                    <button type="submit" class="flex-1 bg-green-500 hover:bg-green-600 text-white py-2 rounded-lg transition-all">
                        <i class="fas fa-save mr-2"></i> Tạo hợp đồng
                    </button>
                    <a asp-action="Index" class="flex-1 bg-gray-300 hover:bg-gray-400 text-gray-700 text-center py-2 rounded-lg transition-all">
                        <i class="fas fa-arrow-left mr-2"></i> Hủy
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // Hiển thị form tạo tài khoản khi tích chọn
    document.getElementById('taoTaiKhoan').addEventListener('change', function() {
        document.getElementById('thongTinTaiKhoan').style.display = this.checked ? 'grid' : 'none';
    });

    // Lấy giá phòng khi chọn phòng
    document.getElementById('maPhong').addEventListener('change', function() {
        var selected = this.options[this.selectedIndex];
        var gia = selected.getAttribute('data-gia');
        if (gia) {
            document.getElementById('giaPhongHienThi').value = parseInt(gia).toLocaleString() + ' đ/tháng';
            document.getElementById('tienCoc').value = parseInt(gia);
        }
    });

    // Thêm người ở
    function themNguoiO() {
        var container = document.getElementById('nguoiOList');
        var newItem = document.createElement('div');
        newItem.className = 'nguoiOItem grid grid-cols-1 md:grid-cols-3 gap-3 mb-2';
        newItem.innerHTML = `
            <input type="text" name="NguoiOHoTen" placeholder="Họ tên" class="px-3 py-2 border rounded-lg" />
            <input type="text" name="NguoiOCCCD" placeholder="CCCD" class="px-3 py-2 border rounded-lg" />
            <input type="text" name="NguoiOSDT" placeholder="Số điện thoại" class="px-3 py-2 border rounded-lg" />
            <button type="button" onclick="this.parentElement.remove()" class="text-red-500 text-sm">Xóa</button>
        `;
        container.appendChild(newItem);
    }

    // Set ngày mặc định
    var today = new Date().toISOString().split('T')[0];
    document.getElementById('ngayBatDau').value = today;
    var oneYearLater = new Date();
    oneYearLater.setFullYear(oneYearLater.getFullYear() + 1);
    document.getElementById('ngayKetThuc').value = oneYearLater.toISOString().split('T')[0];
</script>