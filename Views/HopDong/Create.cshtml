@{
    ViewData["Title"] = "Tạo hợp đồng mới";
    var phongList = ViewBag.PhongList as List<HeThongQuanLyPhongTro.Models.Phong>;
    var khachHangList = ViewBag.KhachHangList as List<HeThongQuanLyPhongTro.Models.KhachHang>;
}

<div class="max-w-4xl mx-auto">
    <div class="bg-white rounded-xl shadow-md overflow-hidden">
        <div class="bg-gradient-to-r from-blue-500 to-blue-600 px-6 py-4">
            <h1 class="text-xl font-bold text-white">Tạo hợp đồng thuê phòng</h1>
            <p class="text-blue-100 text-sm">Nhập thông tin hợp đồng mới</p>
        </div>

        <form method="post" class="p-6 space-y-4">
            @Html.AntiForgeryToken()

            <!-- Thông tin phòng -->
            <div class="border rounded-lg p-4">
                <h3 class="font-bold text-gray-700 mb-3">🏠 Thông tin phòng</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Chọn phòng trống</label>
                        <select name="maPhong" id="maPhong" class="w-full px-3 py-2 border rounded-lg" required>
                            <option value="">-- Chọn phòng --</option>
                            @foreach (var phong in phongList ?? new List<HeThongQuanLyPhongTro.Models.Phong>())
                            {
                                <option value="@phong.MaPhong" data-gia="@phong.GiaPhong" data-dientich="@phong.DienTich" data-coso="@phong.CoSo?.TenCoSo">
                                    @phong.TenPhong - @phong.CoSo?.TenCoSo - @phong.GiaPhong.ToString("N0") đ/tháng
                                </option>
                            }
                        </select>
                    </div>
                    <div id="phongInfo" class="bg-blue-50 p-3 rounded-lg hidden">
                        <p class="text-sm"><strong>Giá phòng:</strong> <span id="giaPhong"></span></p>
                        <p class="text-sm"><strong>Diện tích:</strong> <span id="dienTich"></span></p>
                        <p class="text-sm"><strong>Cơ sở:</strong> <span id="tenCoSo"></span></p>
                    </div>
                </div>
            </div>

            <!-- Thông tin người đại diện -->
            <div class="border rounded-lg p-4">
                <h3 class="font-bold text-gray-700 mb-3">👤 Thông tin người đại diện</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Họ tên <span class="text-red-500">*</span></label>
                        <input type="text" name="HoTen" class="w-full px-3 py-2 border rounded-lg" required />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Số điện thoại <span class="text-red-500">*</span></label>
                        <input type="text" name="SoDienThoai" class="w-full px-3 py-2 border rounded-lg" required />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Email</label>
                        <input type="email" name="Email" class="w-full px-3 py-2 border rounded-lg" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">CCCD/CMND</label>
                        <input type="text" name="CCCD" class="w-full px-3 py-2 border rounded-lg" />
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-sm font-medium text-gray-700 mb-2">Địa chỉ</label>
                        <input type="text" name="DiaChi" class="w-full px-3 py-2 border rounded-lg" />
                    </div>
                </div>
            </div>

            <!-- Danh sách người ở chung -->
            <div class="border rounded-lg p-4">
                <h3 class="font-bold text-gray-700 mb-3">👥 Danh sách người ở chung</h3>
                <div id="danhSachNguoiO">
                    <div class="nguoiO-item grid grid-cols-1 md:grid-cols-3 gap-3 mb-2">
                        <input type="text" name="DanhSachNguoiO[0].HoTen" placeholder="Họ tên" class="border p-2 rounded" />
                        <input type="text" name="DanhSachNguoiO[0].CCCD" placeholder="CCCD" class="border p-2 rounded" />
                        <input type="text" name="DanhSachNguoiO[0].SoDienThoai" placeholder="Số điện thoại" class="border p-2 rounded" />
                    </div>
                </div>
                <button type="button" onclick="themNguoiO()" class="text-blue-500 text-sm mt-2 hover:underline">
                    + Thêm người ở
                </button>
            </div>

            <!-- Thông tin hợp đồng -->
            <div class="border rounded-lg p-4">
                <h3 class="font-bold text-gray-700 mb-3">📄 Thông tin hợp đồng</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Ngày bắt đầu <span class="text-red-500">*</span></label>
                        <input type="date" name="ngayBatDau" class="w-full px-3 py-2 border rounded-lg" required />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Ngày kết thúc <span class="text-red-500">*</span></label>
                        <input type="date" name="ngayKetThuc" class="w-full px-3 py-2 border rounded-lg" required />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Tiền cọc (VNĐ)</label>
                        <input type="number" name="tienCoc" class="w-full px-3 py-2 border rounded-lg" placeholder="Nhập số tiền cọc" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Ngày ký hợp đồng</label>
                        <input type="text" name="ngayKy" class="w-full px-3 py-2 border rounded-lg" placeholder="VD: 10/05/2024" />
                    </div>
                </div>
            </div>

            <!-- Nút submit -->
            <div class="flex justify-end space-x-3 pt-4 border-t">
                <a asp-action="Index" class="px-4 py-2 border rounded-lg hover:bg-gray-50">Hủy</a>
                <button type="submit" class="px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600">
                    <i class="fas fa-save mr-2"></i> Tạo hợp đồng
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    // Hiển thị thông tin phòng khi chọn
    document.getElementById('maPhong').addEventListener('change', function() {
        var selected = this.options[this.selectedIndex];
        var gia = selected.getAttribute('data-gia');
        var dientich = selected.getAttribute('data-dientich');
        var coso = selected.getAttribute('data-coso');

        if (gia) {
            document.getElementById('phongInfo').classList.remove('hidden');
            document.getElementById('giaPhong').innerText = new Intl.NumberFormat('vi-VN').format(gia) + ' đ/tháng';
            document.getElementById('dienTich').innerText = dientich + ' m²';
            document.getElementById('tenCoSo').innerText = coso;
        } else {
            document.getElementById('phongInfo').classList.add('hidden');
        }
    });

    // Thêm người ở
    let nguoiOIndex = 1;
    function themNguoiO() {
        const html = `
            <div class="nguoiO-item grid grid-cols-1 md:grid-cols-3 gap-3 mb-2">
                <input type="text" name="DanhSachNguoiO[${nguoiOIndex}].HoTen" placeholder="Họ tên" class="border p-2 rounded" />
                <input type="text" name="DanhSachNguoiO[${nguoiOIndex}].CCCD" placeholder="CCCD" class="border p-2 rounded" />
                <input type="text" name="DanhSachNguoiO[${nguoiOIndex}].SoDienThoai" placeholder="Số điện thoại" class="border p-2 rounded" />
            </div>
        `;
        document.getElementById('danhSachNguoiO').insertAdjacentHTML('beforeend', html);
        nguoiOIndex++;
    }
</script>