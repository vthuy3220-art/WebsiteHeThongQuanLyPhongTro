@{
}
@model HeThongQuanLyPhongTro.Models.CoSo
@{
    ViewData["Title"] = "Xác nhận xóa cơ sở";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen">
    <div class="w-full max-w-md mx-4">
        <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-200">
            <div class="bg-gradient-to-r from-red-600 to-red-700 p-6 text-white text-center">
                <div class="w-16 h-16 bg-white/20 rounded-full flex items-center justify-center mx-auto mb-3">
                    <i class="fas fa-map-marked-alt text-3xl"></i>
                </div>
                <h2 class="text-xl font-bold tracking-wide">Xác Nhận Xóa Cơ Sở</h2>
                <p class="text-xs text-red-100 mt-1">Hành động này không thể hoàn tác</p>
            </div>

            <form asp-controller="Admin" asp-action="XacNhanXoaCoSo" method="post" class="p-6 space-y-4">
                <input type="hidden" name="id" value="@Model.MaCoSo" />

                <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded text-xs text-red-800 leading-relaxed">
                    <i class="fas fa-exclamation-triangle mr-1 text-red-600"></i>
                    <strong>Cảnh báo cực kỳ quan trọng:</strong> Khi xóa cơ sở này, toàn bộ dữ liệu Tòa nhà và Phòng trọ đang liên kết trực thuộc khu vực này có thể bị ảnh hưởng nghiêm trọng hoặc lỗi logic.
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Mã khu vực</label>
                    <div class="bg-gray-50 px-3 py-2 rounded-lg border text-sm font-mono text-gray-700">#@Model.MaCoSo</div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Tên cơ sở / Khu vực</label>
                    <input type="text" disabled value="@Model.TenCoSo" class="w-full px-3 py-2 bg-gray-50 border rounded-lg text-sm font-bold text-gray-800" />
                </div>

                <div class="flex items-center space-x-3 pt-2">
                    <a href="@Url.Action("Index", "Admin", new { tab = "CoSo" })" class="w-1/2 text-center bg-gray-100 text-gray-700 py-2.5 rounded-xl text-sm font-bold border hover:bg-gray-200 transition shadow-sm">
                        Hủy quay lại
                    </a>
                    <button type="submit" class="w-1/2 bg-red-600 hover:bg-red-700 text-white py-2.5 rounded-xl text-sm font-bold transition shadow-md">
                        Vẫn quyết định xóa
                    </button>
                </div>
            </form>
        </div>
    </div>
</body>
</html>