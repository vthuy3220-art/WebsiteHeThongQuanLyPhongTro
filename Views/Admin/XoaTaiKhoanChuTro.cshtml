@model HeThongQuanLyPhongTro.Models.TaiKhoan

@{
    ViewData["Title"] = "Xóa tài khoản chủ trọ";
    Layout = "_Layout";
}

<div class="max-w-2xl mx-auto">
    <div class="bg-white rounded-xl shadow-md overflow-hidden">
        <div class="bg-gradient-to-r from-red-500 to-red-600 px-6 py-4">
            <h1 class="text-xl font-bold text-white">Xóa tài khoản chủ trọ</h1>
            <p class="text-red-100 text-sm">Bạn có chắc chắn muốn xóa?</p>
        </div>

        <div class="p-6">
            <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 mb-6">
                <div class="flex">
                    <i class="fas fa-exclamation-triangle text-yellow-400 text-xl mr-3"></i>
                    <div>
                        <p class="text-yellow-700 font-semibold">Cảnh báo!</p>
                        <p class="text-yellow-600 text-sm">Hành động này không thể khôi phục. Tài khoản sẽ bị xóa vĩnh viễn.</p>
                    </div>
                </div>
            </div>

            <div class="space-y-3">
                <div class="flex py-2 border-b">
                    <dt class="w-32 font-medium text-gray-600">Mã:</dt>
                    <dd class="flex-1">@Model.MaTaiKhoan</dd>
                </div>
                <div class="flex py-2 border-b">
                    <dt class="w-32 font-medium text-gray-600">Tên đăng nhập:</dt>
                    <dd class="flex-1 font-semibold">@Model.TenDangNhap</dd>
                </div>
                <div class="flex py-2 border-b">
                    <dt class="w-32 font-medium text-gray-600">Email:</dt>
                    <dd class="flex-1">@(string.IsNullOrEmpty(Model.Email) ? "Chưa cập nhật" : Model.Email)</dd>
                </div>
                <div class="flex py-2 border-b">
                    <dt class="w-32 font-medium text-gray-600">Trạng thái:</dt>
                    <dd class="flex-1">
                        @if (Model.TrangThai == "Hoạt động")
                        {
                            <span class="text-green-600">Hoạt động</span>
                        }
                        else
                        {
                            <span class="text-red-600">Khóa</span>
                        }
                    </dd>
                </div>
            </div>

            <form asp-action="XoaTaiKhoanChuTro" method="post" class="mt-6 flex justify-end space-x-3">
                <input type="hidden" asp-for="MaTaiKhoan" />
                <a asp-action="DanhSachChuTro" class="px-4 py-2 border rounded-lg hover:bg-gray-50 transition-all">Hủy</a>
                <button type="submit" class="px-4 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600 transition-all">
                    <i class="fas fa-trash mr-2"></i> Xóa
                </button>
            </form>
        </div>
    </div>
</div>