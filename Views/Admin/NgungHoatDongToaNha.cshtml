@model HeThongQuanLyPhongTro.Models.ToaNha
@{
    ViewData["Title"] = "Xác nhận ngừng hoạt động tòa nhà";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen">

    <div class="w-full max-w-md mx-4">
        <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-200">
            <div class="bg-gradient-to-r from-orange-500 to-red-600 p-6 text-white text-center">
                <div class="w-16 h-16 bg-white/20 rounded-full flex items-center justify-center mx-auto mb-3">
                    <i class="fas fa-building text-3xl"></i>
                </div>
                <h2 class="text-xl font-bold tracking-wide">Dừng Hoạt Động Tòa Nhà</h2>
                <p class="text-xs text-orange-100 mt-1">Xác nhận trạng thái vận hành của hệ thống</p>
            </div>

            <form asp-controller="Admin" asp-action="XacNhanDuyetToaNha" method="post" class="p-6 space-y-4">
                <input type="hidden" name="id" value="@Model.MaToaNha" />
                <input type="hidden" name="trangThai" value="Từ chối" />

                <div class="bg-orange-50 border-l-4 border-orange-500 p-4 rounded text-xs text-orange-800 leading-relaxed">
                    <i class="fas fa-exclamation-triangle mr-1 text-orange-600"></i>
                    <strong>Lưu ý:</strong> Hành động này sẽ chuyển trạng thái tòa nhà thành <strong>Từ chối (Ngừng hoạt động)</strong>. Toàn bộ thông tin phòng thuộc tòa nhà này sẽ tạm ẩn trên sàn.
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Mã tòa nhà</label>
                    <div class="bg-gray-50 px-3 py-2 rounded-lg border text-sm font-mono text-gray-700">#@Model.MaToaNha</div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Tên tòa nhà</label>
                    <input type="text" disabled value="@Model.TenToaNha" class="w-full px-3 py-2 bg-gray-50 border rounded-lg text-sm font-bold text-gray-800" />
                </div>

                <div class="flex items-center space-x-3 pt-2">
                    <a href="@Url.Action("Index", "Admin", new { tab = "ToaNha" })" class="w-1/2 text-center bg-gray-100 text-gray-700 py-2.5 rounded-xl text-sm font-bold border hover:bg-gray-200 transition shadow-sm">
                        Hủy quay lại
                    </a>
                    <button type="submit" class="w-1/2 bg-red-500 hover:bg-red-600 text-white py-2.5 rounded-xl text-sm font-bold transition shadow-md">
                        Xác nhận dừng
                    </button>
                </div>
            </form>
        </div>
    </div>

</body>
</html>