@model HeThongQuanLyPhongTro.Models.TaiKhoan
@{
    ViewData["Title"] = "Chỉnh sửa thông tin chủ trọ";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen">
    <div class="w-full max-w-md mx-4">
        <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-200">
            <div class="bg-gradient-to-r from-blue-500 to-indigo-600 p-6 text-white text-center">
                <div class="w-16 h-16 bg-white/20 rounded-full flex items-center justify-center mx-auto mb-3">
                    <i class="fas fa-user-edit text-3xl"></i>
                </div>
                <h2 class="text-xl font-bold">Chỉnh Sửa Chủ Trọ</h2>
            </div>

            <form asp-controller="Admin" asp-action="SuaChuTro" method="post" class="p-6 space-y-4">
                <input type="hidden" name="maTaiKhoan" value="@Model.MaTaiKhoan" />

                <div>
                    <label class="block text-xs font-semibold text-gray-500 uppercase mb-1">Tên đăng nhập (Không thể sửa)</label>
                    <input type="text" disabled value="@Model.TenDangNhap" class="w-full px-3 py-2 bg-gray-100 border rounded-lg text-sm font-bold text-gray-500" />
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Địa chỉ Email</label>
                    <input type="email" name="email" value="@Model.Email" class="w-full px-3 py-2 border rounded-lg text-sm focus:outline-blue-500" required />
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Trạng thái tài khoản</label>
                    <select name="trangThai" class="w-full px-3 py-2 border rounded-lg text-sm focus:outline-blue-500">
                        <option value="Hoạt động" selected="@(Model.TrangThai == "Hoạt động")">Hoạt động</option>
                        <option value="Khóa" selected="@(Model.TrangThai == "Khóa")">Khóa</option>
                    </select>
                </div>

                <div class="flex items-center space-x-3 pt-2">
                    <a href="@Url.Action("Index", "Admin", new { tab = "NguoiDung" })" class="w-1/2 text-center bg-gray-100 text-gray-700 py-2.5 rounded-xl text-sm font-bold border">Hủy bỏ</a>
                    <button type="submit" class="w-1/2 bg-blue-600 hover:bg-blue-700 text-white py-2.5 rounded-xl text-sm font-bold shadow-md">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</body>
</html>