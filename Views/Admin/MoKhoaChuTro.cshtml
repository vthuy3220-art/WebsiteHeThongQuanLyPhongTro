@model HeThongQuanLyPhongTro.Models.TaiKhoan
@{
    ViewData["Title"] = "Xác nhận mở khóa tài khoản";
}

<div class="flex justify-center mt-10 mb-10 px-4">
    <div class="bg-white rounded-2xl shadow-lg w-full max-w-2xl overflow-hidden border border-gray-100">

        <div class="bg-gradient-to-r from-emerald-500 to-green-500 p-8 text-center text-white">
            <div class="w-16 h-16 bg-white/20 rounded-full flex items-center justify-center mx-auto mb-4 backdrop-blur-sm">
                <i class="fas fa-unlock text-3xl text-white"></i>
            </div>
            <h2 class="text-2xl font-bold mb-2">Xác Nhận Mở Khóa Tài Khoản</h2>
            <p class="text-green-50 text-sm font-medium">Hành động này sẽ khôi phục quyền truy cập của thành viên</p>
        </div>

        <div class="p-8">
            <form asp-controller="Admin" asp-action="XacNhanMoKhoaTaiKhoan" method="post" class="space-y-6">
                <input type="hidden" name="id" value="@Model.MaTaiKhoan" />

                <div>
                    <label class="block text-sm font-bold text-gray-500 uppercase tracking-wider mb-2">Mã Tài Khoản</label>
                    <input type="text" value="#@Model.MaTaiKhoan" readonly class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-gray-700 text-base font-medium focus:outline-none">
                </div>

                <div>
                    <label class="block text-sm font-bold text-gray-500 uppercase tracking-wider mb-2">Tên Đăng Nhập Chủ Trọ</label>
                    <input type="text" value="@Model.TenDangNhap" readonly class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-gray-700 text-base font-medium focus:outline-none">
                </div>

                <div>
                    <label class="block text-sm font-bold text-gray-500 uppercase tracking-wider mb-2">Địa Chỉ Email</label>
                    <input type="text" value="@(string.IsNullOrEmpty(Model.Email) ? "Chưa cập nhật" : Model.Email)" readonly class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-gray-700 text-base font-medium focus:outline-none">
                </div>

                <div class="bg-green-50 border border-green-100 rounded-xl p-4 flex gap-3 mt-6">
                    <i class="fas fa-info-circle text-green-500 mt-1 text-lg"></i>
                    <p class="text-sm text-green-800 font-medium leading-relaxed">
                        <span class="font-bold text-green-600">Lưu ý:</span> Sau khi mở khóa, tài khoản này sẽ được tiếp tục đăng nhập để quản lý tòa nhà, phòng trọ hay hóa đơn bình thường.
                    </p>
                </div>

                <div class="flex gap-4 pt-4">
                    <a href="@Url.Action("Index", "Admin", new { tab = "NguoiDung" })" class="flex-1 text-center px-4 py-3.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-xl text-base font-bold transition-colors">
                        Hủy bỏ
                    </a>
                    <button type="submit" class="flex-1 px-4 py-3.5 bg-green-500 hover:bg-green-600 text-white rounded-xl text-base font-bold shadow-sm transition-all flex items-center justify-center gap-2">
                        <i class="fas fa-unlock"></i> Xác nhận mở khóa
                    </button>
                </div>
            </form>
        </div>

    </div>
</div>