@model HeThongQuanLyPhongTro.Models.TaiKhoan

@{
    ViewData["Title"] = "Tạo tài khoản chủ trọ";
    Layout = "_Layout";
}

<div class="max-w-2xl mx-auto">
    <div class="bg-white rounded-xl shadow-md overflow-hidden">
        <div class="bg-gradient-to-r from-blue-500 to-blue-600 px-6 py-4">
            <h1 class="text-xl font-bold text-white">Tạo tài khoản chủ trọ</h1>
            <p class="text-blue-100 text-sm">Cấp tài khoản cho chủ trọ mới</p>
        </div>

        <form asp-action="TaoTaiKhoanChuTro" method="post" class="p-6 space-y-4">
            @Html.AntiForgeryToken()

            @if (TempData["Success"] != null)
            {
                <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-3 rounded">
                    <i class="fas fa-check-circle mr-2"></i> @TempData["Success"]
                </div>
            }

            <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm"></div>

            <div>
                <label asp-for="TenDangNhap" class="block text-sm font-medium text-gray-700 mb-2">Tên đăng nhập <span class="text-red-500">*</span></label>
                <input asp-for="TenDangNhap" class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="VD: chutro_nguyenvanA" required />
                <span asp-validation-for="TenDangNhap" class="text-red-500 text-sm"></span>
            </div>

            <div>
                <label asp-for="MatKhau" class="block text-sm font-medium text-gray-700 mb-2">Mật khẩu <span class="text-red-500">*</span></label>
                <input asp-for="MatKhau" type="text" class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" value="123456" required />
                <span asp-validation-for="MatKhau" class="text-red-500 text-sm"></span>
                <p class="text-xs text-gray-400 mt-1">Mặc định: 123456, chủ trọ có thể đổi sau khi đăng nhập</p>
            </div>

            <div>
                <label asp-for="Email" class="block text-sm font-medium text-gray-700 mb-2">Email</label>
                <input asp-for="Email" type="email" class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="chutro@example.com" />
                <span asp-validation-for="Email" class="text-red-500 text-sm"></span>
            </div>

            <div class="bg-yellow-50 p-4 rounded-lg">
                <div class="flex items-start">
                    <i class="fas fa-info-circle text-yellow-500 mt-1 mr-3"></i>
                    <div class="text-sm text-yellow-700">
                        <p class="font-semibold">Lưu ý:</p>
                        <ul class="list-disc list-inside mt-1">
                            <li>Sau khi tạo tài khoản, chủ trọ sẽ đăng nhập và quản lý tòa nhà/phòng của mình</li>
                            <li>Chủ trọ có thể cập nhật thông tin ngân hàng để nhận thanh toán</li>
                            <li>Admin có thể khóa/mở khóa tài khoản chủ trọ bất kỳ lúc nào</li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="flex justify-end space-x-3 pt-4 border-t">
                <a asp-action="DanhSachChuTro" class="px-4 py-2 border rounded-lg hover:bg-gray-50 transition-all">Quay lại</a>
                <button type="submit" class="px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition-all">
                    <i class="fas fa-save mr-2"></i> Tạo tài khoản
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}