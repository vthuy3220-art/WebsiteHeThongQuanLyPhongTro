@model HeThongQuanLyPhongTro.Models.TaiKhoan
@{
    ViewData["Title"] = "Xác nhận khóa tài khoản";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen font-sans">

    <div class="w-full max-w-md mx-4">
        <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-200">
            <div class="bg-gradient-to-r from-red-500 to-orange-500 p-6 text-white text-center">
                <div class="w-16 h-16 bg-white/20 rounded-full flex items-center justify-center mx-auto mb-3 shadow-inner">
                    <i class="fas fa-user-lock text-3xl"></i>
                </div>
                <h2 class="text-xl font-bold tracking-wide">Xác Nhận Khóa Tài Khoản</h2>
                <p class="text-xs text-red-100 mt-1">Hành động này sẽ tạm dừng quyền truy cập của thành viên</p>
            </div>

            <form asp-controller="Admin" asp-action="KhoaTaiKhoan" method="post" class="p-6 space-y-4">
                <input type="hidden" name="id" value="@Model.MaTaiKhoan" />

                <div>
                    <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Mã tài khoản</label>
                    <div class="bg-gray-50 px-3 py-2 rounded-lg border border-gray-200 text-sm font-mono text-gray-700">#@Model.MaTaiKhoan</div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Tên đăng nhập chủ trọ</label>
                    <input type="text" disabled value="@Model.TenDangNhap" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg text-sm font-bold text-gray-800" />
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Địa chỉ Email</label>
                    <input type="text" disabled value="@(Model.Email ?? "Chưa cập nhật")" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg text-sm text-gray-600" />
                </div>

                <div class="bg-red-50 border border-red-100 rounded-xl p-4 text-xs text-red-800 flex items-start space-x-2">
                    <i class="fas fa-exclamation-triangle text-sm mt-0.5 shrink-0 text-red-500"></i>
                    <p class="leading-relaxed"><strong>Lưu ý:</strong> Sau khi khóa, tài khoản này sẽ không thể đăng nhập vào hệ thống để quản lý tòa nhà, phòng trọ hay hóa đơn cho đến khi được Admin mở khóa trở lại.</p>
                </div>

                <div class="flex items-center space-x-3 pt-2">
                    <a href="@Url.Action("Index", "Admin", new { tab = "NguoiDung" })" class="w-1/2 text-center bg-gray-100 hover:bg-gray-200 text-gray-700 py-2.5 rounded-xl text-sm font-bold transition shadow-sm border border-gray-200">
                        Hủy bỏ
                    </a>
                    <button type="submit" class="w-1/2 bg-red-500 hover:bg-red-600 text-white py-2.5 rounded-xl text-sm font-bold transition shadow-md flex items-center justify-center space-x-2">
                        <i class="fas fa-lock text-xs"></i>
                        <span>Xác nhận khóa</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

</body>
</html>