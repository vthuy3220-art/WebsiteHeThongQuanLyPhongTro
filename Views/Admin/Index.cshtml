                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-xl shadow-sm border border-gray-200 mb-6">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse min-w-[800px]" id="toaNhaTable">
                            <thead class="bg-gray-50 border-b border-gray-200">
                                <tr>
                                    <th class="p-4 font-semibold text-sm text-gray-600 w-16">Mã</th>
                                    <th class="p-4 font-semibold text-sm text-gray-600">Tên tòa nhà</th>
                                    <th class="p-4 font-semibold text-sm text-gray-600">Khu vực</th>
                                    <th class="p-4 font-semibold text-sm text-gray-600">Địa chỉ</th>
                                    <th class="p-4 font-semibold text-sm text-gray-600">Trạng thái</th>
                                    <th class="p-4 font-semibold text-sm text-gray-600 text-center w-64">Hành động</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100 text-sm">
                                @if (danhSachToaNhaHienThi != null && danhSachToaNhaHienThi.Any())
                                {
                                    foreach (var tn in danhSachToaNhaHienThi)
                                    {
                                        string statusGrp = "Ngừng hoạt động";
                                        if (tn.TrangThai == "Hoạt động" || tn.TrangThai == "Approved" || string.IsNullOrEmpty(tn.TrangThai))
                                        {
                                            statusGrp = "Đang hoạt động";
                                        }

                                        <tr class="hover:bg-gray-50 transition toa-nha-row" data-status="@statusGrp">
                                            <td class="p-4 text-gray-500 font-mono tn-id">#@tn.MaToaNha</td>
                                            <td class="p-4 text-gray-800 font-semibold break-words tn-name">@tn.TenToaNha</td>
                                            <td class="p-4 text-gray-600 break-words tn-area"><i class="fas fa-map-marker-alt text-red-400 mr-1"></i> @tn.CoSo?.TenCoSo</td>
                                            <td class="p-4 text-gray-600 break-words tn-address">@tn.DiaChi</td>
                                            <td class="p-4 tn-status-badge">
                                                @if (statusGrp == "Đang hoạt động")
