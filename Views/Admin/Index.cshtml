                <div id="modalThemToaNha" class="fixed inset-0 bg-gray-900 bg-opacity-50 hidden justify-center items-center z-50 p-4">
                    <div class="bg-white rounded-xl shadow-xl w-full max-w-md p-6 relative">
                        <div class="bg-gradient-to-r from-blue-600 to-indigo-600 p-4 -mx-6 -mt-6 mb-4 text-white font-bold text-lg rounded-t-xl">
                            Thêm tòa nhà cho thuê mới
                        </div>
                        <form asp-controller="Admin" asp-action="ThemToaNha" method="post" class="space-y-4">
                            <div>
                                <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Tên Tòa Nhà</label>
                                <input type="text" name="tenToaNha" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm" placeholder="Ví dụ: Tòa nhà Thanh Xuân A">
