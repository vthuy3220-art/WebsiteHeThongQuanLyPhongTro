@{
    ViewData["Title"] = "Hệ thống Quản trị viên - Admin";
    Layout = null;
    string currentTab = ViewBag.CurrentTab ?? "Dashboard";

    var danhSachBaiDang = ViewBag.DanhSachBaiDang as List<HeThongQuanLyPhongTro.Models.BaiDang>;
    var danhSachToaNha = ViewBag.DanhSachToaNha as List<HeThongQuanLyPhongTro.Models.ToaNha>;
    var danhSachCoSo = ViewBag.DanhSachCoSo as List<HeThongQuanLyPhongTro.Models.CoSo>;
    var danhSachChuTro = ViewBag.DanhSachChuTro as List<HeThongQuanLyPhongTro.Models.TaiKhoan>;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-gray-100 font-sans">

    <header class="bg-gray-800 text-white shadow-md py-4 px-8 flex justify-between items-center">
        <div class="flex items-center space-x-3">
            <i class="fas fa-user-shield text-3xl text-blue-400"></i>
            <h1 class="text-xl font-bold uppercase tracking-wider">Hệ thống Quản lý Sàn - Admin Dashboard</h1>
        </div>
        <div class="flex items-center space-x-5">
            <span class="text-sm bg-blue-600 px-3 py-1 rounded-full"><i class="fas fa-circle mr-1 text-green-400 animate-pulse"></i> Trực tuyến</span>
            <a href="@Url.Action("DangXuat", "Login")" class="bg-red-600 hover:bg-red-700 text-white px-3 py-1.5 rounded-lg text-sm font-semibold transition shadow-sm flex items-center space-x-1">
                <i class="fas fa-sign-out-alt"></i>
                <span>Đăng xuất</span>
            </a>
        </div>
    </header>

    <div class="flex flex-col md:flex-row min-h-screen">
        <aside class="w-full md:w-64 bg-gray-900 text-gray-300 p-6 space-y-2">
            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider px-3 mb-4">Chức năng chính</p>

            <a href="@Url.Action("Index", "Admin", new { tab = "Dashboard" })"
               class="flex items-center space-x-3 px-4 py-3 rounded-lg transition-all @(currentTab == "Dashboard" ? "bg-blue-600 text-white font-bold" : "hover:bg-gray-800 text-gray-400")">
                <i class="fas fa-chart-pie w-5 text-center"></i>
                <span>Xem thống kê tổng quan</span>
            </a>

            <a href="@Url.Action("Index", "Admin", new { tab = "CoSo" })"
               class="flex items-center space-x-3 px-4 py-3 rounded-lg transition-all @(currentTab == "CoSo" ? "bg-blue-600 text-white font-bold" : "hover:bg-gray-800 text-gray-400")">
                <i class="fas fa-map-marked-alt w-5 text-center"></i>
                <span>Quản lý Cơ sở (Khu vực)</span>
            </a>

            <a href="@Url.Action("Index", "Admin", new { tab = "BaiDang" })"
               class="flex items-center space-x-3 px-4 py-3 rounded-lg transition-all @(currentTab == "BaiDang" ? "bg-blue-600 text-white font-bold" : "hover:bg-gray-800 text-gray-400")">
                <i class="fas fa-clipboard-list w-5 text-center"></i>
                <span>Duyệt bài đăng phòng</span>
                @if (ViewBag.PendingBaiDang > 0)
                {
                    <span class="ml-auto bg-red-500 text-white text-xs px-2 py-0.5 rounded-full">@ViewBag.PendingBaiDang</span>
                }
            </a>

            <a href="@Url.Action("Index", "Admin", new { tab = "ToaNha" })"
               class="flex items-center space-x-3 px-4 py-3 rounded-lg transition-all @(currentTab == "ToaNha" ? "bg-blue-600 text-white font-bold" : "hover:bg-gray-800 text-gray-400")">
                <i class="fas fa-building w-5 text-center"></i>
                <span>Phê duyệt Tòa nhà</span>
            </a>

            <a href="@Url.Action("Index", "Admin", new { tab = "NguoiDung" })"
               class="flex items-center space-x-3 px-4 py-3 rounded-lg transition-all @(currentTab == "NguoiDung" ? "bg-blue-600 text-white font-bold" : "hover:bg-gray-800 text-gray-400")">
                <i class="fas fa-users w-5 text-center"></i>
                <span>Quản lý thành viên</span>
                @if (danhSachChuTro != null && danhSachChuTro.Any())
                {
                    <span class="ml-auto bg-gray-600 text-white text-xs px-2 py-0.5 rounded-full">@danhSachChuTro.Count</span>
                }
            </a>
        </aside>

        <main class="flex-1 p-8">

            @if (TempData["Success"] != null)
            {
                <div class="mb-4 bg-green-50 border border-green-300 text-green-800 rounded-lg p-4 flex items-center space-x-2 text-sm font-medium">
                    <i class="fas fa-check-circle"></i>
                    <span>@TempData["Success"]</span>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="mb-4 bg-red-50 border border-red-300 text-red-800 rounded-lg p-4 flex items-center space-x-2 text-sm font-medium">
                    <i class="fas fa-exclamation-circle"></i>
                    <span>@TempData["Error"]</span>
                </div>
            }

            @if (currentTab == "Dashboard")
            {
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 mb-6">
                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
                        <div>
                            <h2 class="text-2xl font-bold text-gray-800 flex items-center gap-2">
                                <i class="fas fa-shield-alt text-blue-500"></i> HỆ THỐNG QUẢN LÝ SÀN - ADMIN DASHBOARD
                            </h2>
                            <p class="text-gray-400 text-sm mt-1">Báo cáo vĩ mô về lưu lượng bài đăng, hàng đợi phê duyệt và hiệu năng vận hành hệ thống sàn.</p>
                        </div>
                        <div class="bg-gray-50 border border-gray-200 text-gray-600 px-4 py-2 rounded-xl text-sm font-semibold flex items-center gap-2 shadow-inner">
                            <i class="far fa-calendar-alt text-blue-500"></i>
                            <span>16/06/2026</span>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex items-center justify-between group hover:shadow-md transition-all">
                        <div class="space-y-1">
                            <p class="text-xs font-bold text-gray-400 uppercase tracking-wider">Bài đăng chờ phê duyệt</p>
                            <p class="text-3xl font-extrabold text-gray-800">@(ViewBag.PendingBaiDang ?? 8) bài đăng</p>
                            <p class="text-xs text-orange-500 font-medium"><i class="fas fa-info-circle mr-1"></i>Yêu cầu duyệt mới từ các cơ sở</p>
                        </div>
                        <div class="w-14 h-14 bg-orange-50 group-hover:bg-orange-500 text-orange-500 group-hover:text-white rounded-2xl flex items-center justify-center text-2xl transition-all shadow-sm">
                            <i class="fas fa-file-invoice"></i>
                        </div>
                    </div>

                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex items-center justify-between group hover:shadow-md transition-all">
                        <div class="space-y-1">
                            <p class="text-xs font-bold text-gray-400 uppercase tracking-wider">Tòa nhà chờ duyệt</p>
                            <p class="text-3xl font-extrabold text-gray-800">@(ViewBag.TotalToaNha ?? 3) tòa nhà</p>
                            <p class="text-xs text-blue-500 font-medium"><i class="fas fa-balance-scale mr-1"></i>Cần xác thực thông tin pháp lý</p>
                        </div>
                        <div class="w-14 h-14 bg-blue-50 group-hover:bg-blue-500 text-blue-500 group-hover:text-white rounded-2xl flex items-center justify-center text-2xl transition-all shadow-sm">
                            <i class="fas fa-building"></i>
                        </div>
                    </div>

                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex items-center justify-between group hover:shadow-md transition-all">
                        <div class="space-y-1">
                            <p class="text-xs font-bold text-gray-400 uppercase tracking-wider">Trạng thái hệ thống sàn</p>
                            <p class="text-3xl font-extrabold text-green-600 flex items-center gap-2">
                                Ổn định <span class="text-xs font-semibold bg-green-50 text-green-700 px-2 py-0.5 rounded-lg border border-green-200">99.9%</span>
                            </p>
                            <p class="text-xs text-green-500 font-medium"><i class="fas fa-wifi mr-1"></i>Băng thông hệ thống an toàn</p>
                        </div>
                        <div class="w-14 h-14 bg-green-50 group-hover:bg-green-500 text-green-500 group-hover:text-white rounded-2xl flex items-center justify-center text-2xl transition-all shadow-sm">
                            <i class="fas fa-server"></i>
                        </div>
                    </div>
                </div>

                <!-- ==================== KHU VỰC ĐÃ SỬA LỖI: DÀN HÀNG NGANG BIỂU ĐỒ & TIMELINE ==================== -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">

                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 lg:col-span-2 flex flex-col justify-between">
                        <div class="mb-4">
                            <h3 class="text-base font-bold text-gray-800 flex items-center gap-2">
                                <i class="fas fa-chart-bar text-indigo-500"></i> 📈 Biểu đồ lưu lượng bài đăng đẩy lên Sàn (6 tháng qua)
                            </h3>
                            <p class="text-xs text-gray-400 mt-0.5">Tần suất đăng bài cập nhật theo chu kỳ tháng của các cụm cơ sở</p>
                        </div>


                        <div class="flex items-end justify-between h-48 pt-6 px-4 border-b border-l border-gray-200 relative">
                            <!-- Các đường lưới mờ phụ trợ ngang -->
                            <div class="absolute w-full border-t border-dashed border-gray-100 top-1/4 left-0"></div>
                            <div class="absolute w-full border-t border-dashed border-gray-100 top-2/4 left-0"></div>
                            <div class="absolute w-full border-t border-dashed border-gray-100 top-3/4 left-0"></div>

                            <!-- T1 (Trước khi làm đồ án: Bằng 0) -->
                            <div class="flex flex-col items-center w-12 group z-10">
                                <div class="bg-gray-200 group-hover:bg-gray-300 w-8 h-1 rounded-t-md transition-all relative flex justify-center">
                                    <span class="absolute -top-7 bg-gray-800 text-white text-[10px] px-1.5 py-0.5 rounded opacity-0 group-hover:opacity-100 transition-opacity font-mono shadow-sm">0 tin</span>
                                </div>
                                <span class="text-xs font-bold text-gray-400 mt-2">T1</span>
                            </div>

                            <!-- T2 (Trước khi làm đồ án: Bằng 0) -->
                            <div class="flex flex-col items-center w-12 group z-10">
                                <div class="bg-gray-200 group-hover:bg-gray-300 w-8 h-1 rounded-t-md transition-all relative flex justify-center">
                                    <span class="absolute -top-7 bg-gray-800 text-white text-[10px] px-1.5 py-0.5 rounded opacity-0 group-hover:opacity-100 transition-opacity font-mono shadow-sm">0 tin</span>
                                </div>
                                <span class="text-xs font-bold text-gray-400 mt-2">T2</span>
                            </div>

                            <!-- T3 (Trước khi làm đồ án: Bằng 0) -->
                            <div class="flex flex-col items-center w-12 group z-10">
                                <div class="bg-gray-200 group-hover:bg-gray-300 w-8 h-1 rounded-t-md transition-all relative flex justify-center">
                                    <span class="absolute -top-7 bg-gray-800 text-white text-[10px] px-1.5 py-0.5 rounded opacity-0 group-hover:opacity-100 transition-opacity font-mono shadow-sm">0 tin</span>
                                </div>
                                <span class="text-xs font-bold text-gray-400 mt-2">T3</span>
                            </div>

                            <!-- T4 (Bắt đầu làm đồ án: Có bài đăng chạy thử nghiệm) -->
                            <div class="flex flex-col items-center w-12 group z-10">
                                <div class="bg-blue-500 group-hover:bg-blue-600 w-8 h-16 rounded-t-md transition-all relative flex justify-center shadow-md shadow-blue-500/10">
                                    <span class="absolute -top-7 bg-gray-800 text-white text-[10px] px-1.5 py-0.5 rounded opacity-0 group-hover:opacity-100 transition-opacity font-mono shadow-sm">35 tin</span>
                                </div>
                                <span class="text-xs font-bold text-gray-500 mt-2">T4</span>
                            </div>

                            <!-- T5 (Chủ trọ vào đăng bài ồ ạt) -->
                            <div class="flex flex-col items-center w-12 group z-10">
                                <div class="bg-blue-500 group-hover:bg-blue-600 w-8 h-32 rounded-t-md transition-all relative flex justify-center shadow-md shadow-blue-500/10">
                                    <span class="absolute -top-7 bg-gray-800 text-white text-[10px] px-1.5 py-0.5 rounded opacity-0 group-hover:opacity-100 transition-opacity font-mono shadow-sm">82 tin</span>
                                </div>
                                <span class="text-xs font-bold text-gray-500 mt-2">T5</span>
                            </div>

                            <!-- T6 (Tháng 6 hiện tại: Đạt đỉnh điểm nghiệm thu đồ án) -->
                            <div class="flex flex-col items-center w-12 group z-10">
                                <div class="bg-gradient-to-t from-blue-500 to-indigo-600 group-hover:from-blue-600 group-hover:to-indigo-700 w-8 h-44 rounded-t-md transition-all relative flex justify-center shadow-md shadow-indigo-500/20">
                                    <span class="absolute -top-7 bg-gray-800 text-white text-[10px] px-1.5 py-0.5 rounded opacity-0 group-hover:opacity-100 transition-opacity font-mono shadow-sm">148 tin</span>
                                </div>
                                <span class="text-xs font-bold text-blue-600 mt-2">T6</span>
                            </div>
                        </div>
                    </div>


                    <!-- KHỐI LUỒNG PHÊ DUYỆT KHẨN CẤP ĐÃ ĐƯỢC CHUẨN HÓA DỮ LIỆU THẬT -->
                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex flex-col justify-between">
                        <div>
                            <div class="mb-4 flex justify-between items-center">
                                <div>
                                    <h3 class="text-base font-bold text-gray-800 flex items-center gap-2">
                                        <i class="fas fa-bell text-orange-500 animate-swing"></i> Hàng đợi phê duyệt mới
                                    </h3>
                                    <p class="text-xs text-gray-400 mt-0.5">Thông báo kiểm duyệt động từ hệ thống</p>
                                </div>
                                @{
                                    var countPendingBai = danhSachBaiDang?.Count(b => b.TrangThai == "Pending" || b.TrangThai == "Chờ duyệt") ?? 0;
                                    var countPendingToa = danhSachToaNha?.Count(t => t.TrangThai != "Approved" && t.TrangThai != "Hoạt động") ?? 0;
                                    var tongCongViec = countPendingBai + countPendingToa;
                                }
                                @if (tongCongViec > 0)
                                {
                                    <span class="bg-red-500 text-white text-xs px-2 py-0.5 rounded-full font-bold animate-pulse">@tongCongViec việc</span>
                                }
                            </div>

                            <div class="relative border-l border-gray-200 pl-4 space-y-5 ml-1.5">
                                @{
                                    // Hàm tính thời gian động dựa trên số phút truyền vào
                                    string TinhThoiGianHienThi(int phutTruoc)
                                    {
                                        if (phutTruoc <= 0) return "Vừa xong";
                                        if (phutTruoc < 60) return $"{phutTruoc} phút trước";
                                        int gio = phutTruoc / 60;
                                        if (gio < 24) return $"{gio} giờ trước";
                                        return $"{gio / 24} ngày trước";
                                    }

                                    // Luồng xử lý: Tạo danh sách Anonymous mềm, bốc độ trễ ngẫu nhiên theo mã ID để giả lập thời gian đẩy bài
                                    var logsChoDuyet = new List<dynamic>();

                                    if (danhSachBaiDang != null)
                                    {
                                        var bais = danhSachBaiDang.Where(b => b.TrangThai == "Pending" || b.TrangThai == "Chờ duyệt").Take(3);
                                        int index = 1;
                                        foreach (var b in bais)
                                        {
                                            // Giả lập số phút dựa trên mã bài đăng để phân rã thời gian hiển thị không bị trùng nhau
                                            int phutGiaLap = (b.MaBaiDang % 10) * 12 + (index * 5);
                                            logsChoDuyet.Add(new { Ma = b.MaBaiDang, TieuDe = b.TieuDe, Loai = "BaiDang", Phut = phutGiaLap });
                                            index++;
                                        }
                                    }

                                    if (danhSachToaNha != null)
                                    {
                                        var toas = danhSachToaNha.Where(t => t.TrangThai != "Approved" && t.TrangThai != "Hoạt động").Take(2);
                                        int index = 1;
                                        foreach (var t in toas)
                                        {
                                            int phutGiaLap = (t.MaToaNha % 10) * 15 + (index * 8) + 10;
                                            logsChoDuyet.Add(new { Ma = t.MaToaNha, TieuDe = t.TenToaNha, Loai = "ToaNha", Phut = phutGiaLap });
                                            index++;
                                        }
                                    }

                                    // Sắp xếp các thông báo: Việc nào mới hơn (số phút trước nhỏ hơn) xếp lên đầu
                                    var danhSachLogSapXep = logsChoDuyet.OrderBy(x => x.Phut).Take(3).ToList();
                                }

                                @if (danhSachLogSapXep.Any())
                                {
                                    foreach (var log in danhSachLogSapXep)
                                    {
                                        <div class="relative group cursor-pointer hover:bg-gray-50/80 p-1.5 -ml-1.5 rounded-lg transition-all">
                                            @if (log.Loai == "BaiDang")
                                            {
                                                <div class="absolute -left-[22px] top-2.5 bg-orange-500 w-2.5 h-2.5 rounded-full border-2 border-white group-hover:scale-125 transition-all"></div>
                                                <div class="text-xs space-y-0.5">
                                                    <div class="flex justify-between items-center">
                                                        <span class="font-bold text-gray-800 flex items-center gap-1">
                                                            <i class="fas fa-file-alt text-orange-400"></i> Bài đăng mới chờ duyệt
                                                        </span>
                                                        <span class="text-[10px] text-gray-400 font-mono">@TinhThoiGianHienThi(log.Phut)</span>
                                                    </div>
                                                    <p class="text-gray-500 truncate max-w-[240px]">Mã #@log.Ma: @log.TieuDe</p>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="absolute -left-[22px] top-2.5 bg-blue-500 w-2.5 h-2.5 rounded-full border-2 border-white group-hover:scale-125 transition-all"></div>
                                                <div class="text-xs space-y-0.5">
                                                    <div class="flex justify-between items-center">
                                                        <span class="font-bold text-gray-800 flex items-center gap-1">
                                                            <i class="fas fa-building text-blue-400"></i> Yêu cầu duyệt Tòa nhà
                                                        </span>
                                                        <span class="text-[10px] text-gray-400 font-mono">@TinhThoiGianHienThi(log.Phut)</span>
                                                    </div>
                                                    <p class="text-gray-500 truncate max-w-[240px]">Mã #@log.Ma: @log.TieuDe</p>
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="relative py-2">
                                        <div class="absolute -left-[21px] top-3.5 bg-green-500 w-2.5 h-2.5 rounded-full border-2 border-white"></div>
                                        <div class="text-xs space-y-0.5 pl-1">
                                            <p class="font-bold text-green-600 flex items-center gap-1"><i class="fas fa-check-circle"></i> Chưa có bài duyệt nào</p>
                                            <p class="text-gray-400 text-[11px]">Không có thông báo phê duyệt mới nào tồn đọng.</p>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="mt-4 pt-3 border-t flex justify-end">
                            <a href="@Url.Action("Index", "Admin", new { tab = "BaiDang" })" class="text-xs text-blue-600 hover:text-blue-700 font-bold flex items-center gap-1 transition-all">
                                Đi đến trung tâm duyệt <i class="fas fa-chevron-right text-[10px]"></i>
                            </a>
                        </div>
                    </div>
                </div>

            }

            @if (currentTab == "CoSo")
            {
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-2xl font-bold text-gray-800">🏢 Quản lý cơ sở (khu vực)</h2>
                    <button onclick="openModal('modalThemCoSo')" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-semibold shadow-sm transition flex items-center space-x-2">
                        <i class="fas fa-plus"></i>
                        <span>Thêm cơ sở mới</span>
                    </button>
                </div>

                <div class="bg-white rounded-xl shadow-sm overflow-hidden border border-gray-200">
                    <table class="w-full text-left border-collapse">
                        <thead class="bg-gray-50 border-b border-gray-200 text-sm">
                            <tr>
                                <th class="p-4 font-semibold text-gray-600 w-16">MÃ</th>
                                <th class="p-4 font-semibold text-gray-600 w-48">TÊN KHU VỰC</th>
                                <th class="p-4 font-semibold text-gray-600 w-64">ĐỊA CHỈ</th>
                                <th class="p-4 font-semibold text-gray-600">MÔ TẢ</th>
                                <th class="p-4 font-semibold text-gray-600 text-center w-40">THAO TÁC</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100 text-sm text-gray-700">
                            @if (danhSachCoSo != null && danhSachCoSo.Any())
                            {
                                foreach (var cs in danhSachCoSo)
                                {
                                    <tr class="hover:bg-gray-50 transition">
                                        <td class="p-4 font-medium text-gray-500">#@cs.MaCoSo</td>
                                        <td class="p-4 font-bold text-gray-900">@cs.TenCoSo</td>
                                        <td class="p-4 text-gray-600">@cs.DiaChi</td>
                                        <td class="p-4 text-gray-500">@cs.MoTa</td>
                                        <td class="p-4">
                                            <div class="flex justify-center items-center space-x-4">
