                            </div>

                            <div>
                                <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Địa chỉ chi tiết</label>
                                <input type="text" name="diaChi" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm" placeholder="Ví dụ: Số 78 Bùi Xương Trạch">
                            </div>

                            <div class="flex justify-end space-x-3 pt-2 border-t">
                                <button type="button" onclick="closeModal('modalThemToaNha')" class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 text-sm font-medium hover:bg-gray-50 transition">Hủy bỏ</button>
                                <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium shadow-sm transition">Lưu tòa nhà</button>
                            </div>
                        </form>
                    </div>
                </div>
            }

            @if (currentTab == "NguoiDung")
            {
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
                    <h2 class="text-xl sm:text-2xl font-bold text-gray-800">Quản lý tài khoản chủ trọ</h2>
                    <button onclick="openModal('modalThemChuTro')" class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-xl font-semibold text-xs sm:text-sm transition shadow-md flex items-center space-x-2 self-stretch sm:self-auto justify-center">
                        <span>Thêm tài khoản mới</span>
                    </button>
                </div>

                <div class="bg-white rounded-xl shadow-sm border border-gray-200">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse min-w-[650px]">
                            <thead class="bg-gray-50 border-b border-gray-200 text-sm">
                                <tr>
                                    <th class="p-4 font-semibold text-gray-600 w-16">MÃ</th>
                                    <th class="p-4 font-semibold text-gray-600">TÊN ĐĂNG NHẬP</th>
                                    <th class="p-4 font-semibold text-gray-600">EMAIL</th>
                                    <th class="p-4 font-semibold text-gray-600 text-center">TRẠNG THÁI</th>
                                    <th class="p-4 font-semibold text-gray-600 text-center w-64">THAO TÁC</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100 text-sm text-gray-700">
                                @if (danhSachChuTro != null && danhSachChuTro.Any())
                                {
                                    foreach (var tk in danhSachChuTro)
                                    {
                                        <tr class="hover:bg-gray-50 transition">
                                            <td class="p-4 font-medium text-gray-500">#@tk.MaTaiKhoan</td>
                                            <td class="p-4 font-bold text-gray-900 break-words">@tk.TenDangNhap</td>
                                            <td class="p-4 text-gray-600 break-words">@(tk.Email ?? "Chưa cập nhật")</td>
                                            <td class="p-4 text-center">
                                                @if (tk.TrangThai == "Khóa")
                                                {
                                                    <span class="bg-red-100 text-red-700 px-2.5 py-1 rounded-full text-xs font-bold whitespace-nowrap">Đã khóa</span>
                                                }
                                                else
                                                {
                                                    <span class="bg-green-100 text-green-700 px-2.5 py-1 rounded-full text-xs font-bold whitespace-nowrap">Hoạt động</span>
                                                }
                                            </td>
                                            <td class="p-4 text-center">
                                                <div class="flex justify-center items-center space-x-2 whitespace-nowrap">
                                                    <a href="@Url.Action("SuaChuTro", "Admin", new { id = tk.MaTaiKhoan })" class="bg-blue-500 hover:bg-blue-600 text-white px-3 py-1.5 rounded-lg text-xs font-semibold transition flex items-center" title="Sửa thông tin">
                                                        Sửa
                                                    </a>

                                                    @if (tk.TrangThai == "Khóa")
                                                    {
                                                        <form asp-controller="Admin" asp-action="MoKhoaTaiKhoan" method="post" class="inline" onsubmit="return confirm('Bạn muốn mở khóa tài khoản này?')">
                                                            <input type="hidden" name="id" value="@tk.MaTaiKhoan" />
                                                            <button type="submit" class="bg-green-500 hover:bg-green-600 text-white px-3 py-1.5 rounded-lg text-xs font-semibold transition flex items-center">
                                                                Mở khóa
                                                            </button>
                                                        </form>
                                                    }
                                                    else
                                                    {
                                                        <a href="@Url.Action("KhoaChuTro", "Admin", new { id = tk.MaTaiKhoan })" class="bg-orange-500 hover:bg-orange-600 text-white px-3 py-1.5 rounded-lg text-xs font-semibold transition flex items-center">
                                                            Khóa
                                                        </a>
                                                    }

                                                    <a href="@Url.Action("XoaChuTro", "Admin", new { id = tk.MaTaiKhoan })" class="bg-gray-500 hover:bg-red-600 text-white px-3 py-1.5 rounded-lg text-xs font-semibold transition flex items-center" title="Xóa tài khoản">
