                    <button onclick="openModal('modalThemChuTro')" class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-xl font-semibold text-xs sm:text-sm transition shadow-md flex items-center space-x-2 self-stretch sm:self-auto justify-center">
                        <span>Thêm tài khoản mới</span>
                    </button>
                </div>

                <!-- BỘ LỌC TÌM KIẾM JAVASCRIPT KHÔNG TẢI LẠI TRANG -->
                <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-sm mb-6 space-y-3">
                    <div class="flex flex-col sm:flex-row gap-3 justify-end items-center">
