                                                            <input type="hidden" name="id" value="@tn.MaToaNha" />
                                                            <input type="hidden" name="trangThai" value="Ngừng hoạt động" />
                                                            <button type="submit" class="bg-red-500 hover:bg-red-600 text-white px-3 py-1.5 rounded-lg text-xs font-semibold transition shadow-sm flex items-center">
