                    </div>

                    <div class="flex flex-wrap justify-end items-center gap-2 sm:gap-3 p-4 border-t border-slate-100 bg-slate-50/50 flex-shrink-0">
                        <form asp-action="DuyetBaiDang" method="post" class="inline">
