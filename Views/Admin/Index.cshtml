@{
    ViewData["Title"] = "Hệ thống Quản trị viên - Admin";
    Layout = null;
    string currentTab = ViewBag.CurrentTab ?? "Dashboard";

    // Ép kiểu dữ liệu từ ViewBag nhận từ Controller sang danh sách để xử lý vòng lặp loop
    var danhSachBaiDang = ViewBag.DanhSachBaiDang as List<HeThongQuanLyPhongTro.Models.BaiDang>;
    var danhSachToaNha = ViewBag.DanhSachToaNha as List<HeThongQuanLyPhongTro.Models.ToaNha>;
    var danhSachCoSo = ViewBag.DanhSachCoSo as List<HeThongQuanLyPhongTro.Models.CoSo>;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-gray-100 font-sans">

    <header class="bg-gray-800 text-white shadow-md py-4 px-8 flex justify-between items-center">
        <div class="flex items-center space-x-3">
            <i class="fas fa-user-shield text-3xl text-blue-400"></i>
            <h1 class="text-xl font-bold uppercase tracking-wider">Hệ thống Quản lý Sàn - Admin Dashboard</h1>
        </div>
        <div class="flex items-center space-x-4">
            <span class="text-sm bg-blue-600 px-3 py-1 rounded-full"><i class="fas fa-circle mr-1 text-green-400 animate-pulse"></i> Trực tuyến</span>
            <a href="@Url.Action("Index", "Home")" class="text-gray-300 hover:text-white transition text-sm"><i class="fas fa-sign-out-alt mr-1"></i>Về Trang Chủ</a>
        </div>
    </header>

    <div class="flex flex-col md:flex-row min-h-screen">
        <aside class="w-full md:w-64 bg-gray-900 text-gray-300 p-6 space-y-2">
            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider px-3 mb-4">Chức năng chính</p>

            <a href="@Url.Action("Index", "Admin", new { tab = "Dashboard" })"
               class="flex items-center space-x-3 px-4 py-3 rounded-lg transition-all @(currentTab == "Dashboard" ? "bg-blue-600 text-white font-bold" : "hover:bg-gray-800 text-gray-400")">
                <i class="fas fa-chart-pie w-5 text-center"></i>
                <span>Xem thống kê tổng quan</span>
            </a>

            <a href="@Url.Action("Index", "Admin", new { tab = "CoSo" })"
               class="flex items-center space-x-3 px-4 py-3 rounded-lg transition-all @(currentTab == "CoSo" ? "bg-blue-600 text-white font-bold" : "hover:bg-gray-800 text-gray-400")">
                <i class="fas fa-map-marked-alt w-5 text-center"></i>
                <span>Quản lý Cơ sở (Khu vực)</span>
            </a>

            <a href="@Url.Action("Index", "Admin", new { tab = "BaiDang" })"
               class="flex items-center space-x-3 px-4 py-3 rounded-lg transition-all @(currentTab == "BaiDang" ? "bg-blue-600 text-white font-bold" : "hover:bg-gray-800 text-gray-400")">
                <i class="fas fa-clipboard-list w-5 text-center"></i>
                <span>Duyệt bài đăng phòng</span>
                @if (ViewBag.PendingBaiDang > 0)
                {
                    <span class="ml-auto bg-red-500 text-white text-xs px-2 py-0.5 rounded-full">@ViewBag.PendingBaiDang</span>
                }
            </a>

            <a href="@Url.Action("Index", "Admin", new { tab = "ToaNha" })"
               class="flex items-center space-x-3 px-4 py-3 rounded-lg transition-all @(currentTab == "ToaNha" ? "bg-blue-600 text-white font-bold" : "hover:bg-gray-800 text-gray-400")">
                <i class="fas fa-building w-5 text-center"></i>
                <span>Phê duyệt Tòa nhà</span>
            </a>

            <a href="@Url.Action("Index", "Admin", new { tab = "NguoiDung" })"
               class="flex items-center space-x-3 px-4 py-3 rounded-lg transition-all @(currentTab == "NguoiDung" ? "bg-blue-600 text-white font-bold" : "hover:bg-gray-800 text-gray-400")">
                <i class="fas fa-users w-5 text-center"></i>
                <span>Quản lý thành viên</span>
            </a>
        </aside>

        <main class="flex-1 p-8">

            @if (currentTab == "Dashboard")
            {
                <h2 class="text-2xl font-bold text-gray-800 mb-6">📊 Thống kê số liệu toàn hệ thống</h2>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                    <div class="bg-white p-6 rounded-xl shadow-sm border-l-4 border-blue-500 flex items-center justify-between">
                        <div>
                            <p class="text-sm font-medium text-gray-500 uppercase">Tổng số Tòa nhà</p>
                            <p class="text-3xl font-bold text-gray-800 mt-1">@ViewBag.TotalToaNha</p>
                        </div>
                        <i class="fas fa-building text-4xl text-blue-100"></i>
                    </div>

                    <div class="bg-white p-6 rounded-xl shadow-sm border-l-4 border-green-500 flex items-center justify-between">
                        <div>
                            <p class="text-sm font-medium text-gray-500 uppercase">Tổng số Phòng trống</p>
                            <p class="text-3xl font-bold text-gray-800 mt-1">@ViewBag.TotalPhong</p>
                        </div>
                        <i class="fas fa-door-open text-4xl text-green-100"></i>
                    </div>

                    <div class="bg-white p-6 rounded-xl shadow-sm border-l-4 border-red-500 flex items-center justify-between">
                        <div>
                            <p class="text-sm font-medium text-gray-500 uppercase">Bài đăng chờ phê duyệt</p>
                            <p class="text-3xl font-bold text-gray-800 mt-1">@ViewBag.PendingBaiDang</p>
                        </div>
                        <i class="fas fa-clock text-4xl text-red-100"></i>
                    </div>
                </div>

                <div class="bg-blue-50 border border-blue-200 text-blue-800 rounded-xl p-5 flex items-start space-x-3">
                    <i class="fas fa-info-circle text-xl mt-0.5"></i>
                    <div>
                        <h4 class="font-bold mb-1">Hướng dẫn quản trị nhóm</h4>
                        <p class="text-sm opacity-90">Toàn bộ logic quản trị phân quyền Admin nằm riêng trong Controller này. Bạn có thể thoải mái thêm các bảng quản lý dịch vụ, hợp đồng ở đây mà không lo ghi đè làm mất mã nguồn phần Đăng bài, Sửa bài của Chủ trọ do bạn của bạn thiết kế.</p>
                    </div>
                </div>
            }

            else if (currentTab == "CoSo")
            {
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-2xl font-bold text-gray-800">🏢 Quản lý cơ sở (khu vực)</h2>
                    <button onclick="openModal('modalThemCoSo')" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-semibold shadow-sm transition flex items-center space-x-2">
                        <i class="fas fa-plus"></i>
                        <span>Thêm cơ sở mới</span>
                    </button>
                </div>
                <!-- Hiển thị thông báo lỗi hoặc thành công -->
                @if (TempData["Error"] != null)
                {
                    <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 rounded-lg mb-4 shadow-sm" role="alert">
                        <div class="flex items-center">
                            <i class="fas fa-exclamation-circle text-red-500 text-xl mr-3"></i>
                            <span class="font-medium">@TempData["Error"]</span>
                        </div>
                    </div>
                }

                @if (TempData["Success"] != null)
                {
                    <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 rounded-lg mb-4 shadow-sm" role="alert">
                        <div class="flex items-center">
                            <i class="fas fa-check-circle text-green-500 text-xl mr-3"></i>
                            <span class="font-medium">@TempData["Success"]</span>
                        </div>
                    </div>
                }
                <div class="bg-white rounded-xl shadow-sm overflow-hidden border border-gray-200">
                    <table class="w-full text-left border-collapse">
                        <thead class="bg-gray-50 border-b border-gray-200 text-sm">
                            <tr>
                                <th class="p-4 font-semibold text-gray-600 w-16">MÃ</th>
                                <th class="p-4 font-semibold text-gray-600 w-48">TÊN KHU VỰC</th>
                                <th class="p-4 font-semibold text-gray-600 w-64">ĐỊA CHỈ</th>
                                <th class="p-4 font-semibold text-gray-600">MÔ TẢ</th>
                                <th class="p-4 font-semibold text-gray-600 text-center w-40">THAO TÁC</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100 text-sm text-gray-700">
                            @if (danhSachCoSo != null && danhSachCoSo.Any())
                            {
                                foreach (var cs in danhSachCoSo)
                                {
                                    <tr class="hover:bg-gray-50 transition">
                                        <td class="p-4 font-medium text-gray-500">#@cs.MaCoSo</td>
                                        <td class="p-4 font-bold text-gray-900">@cs.TenCoSo</td>
                                        <td class="p-4 text-gray-600">@cs.DiaChi</td>
                                        <td class="p-4 text-gray-500">@cs.MoTa</td>
                                        <td class="p-4">
                                            <div class="flex justify-center items-center space-x-4">
                                                <button onclick="openEditCoSoModal('@cs.MaCoSo', '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(cs.TenCoSo ?? ""))', '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(cs.DiaChi ?? ""))', '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(cs.MoTa ?? ""))')"
                                                        class="text-blue-600 hover:text-blue-900 transition" title="Sửa cơ sở">
                                                    <i class="fas fa-edit text-base"></i>
                                                </button>

                                                <form asp-action="XoaCoSo" method="post" class="inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa cơ sở này?');">
                                                    <input type="hidden" name="id" value="@cs.MaCoSo" />
                                                    <button type="submit" class="text-red-600 hover:text-red-900 transition" title="Xóa cơ sở">
                                                        <i class="fas fa-trash text-base"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="p-8 text-center text-gray-400">Không có dữ liệu cơ sở nào trong hệ thống.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div id="modalThemCoSo" class="fixed inset-0 bg-gray-900 bg-opacity-50 hidden justify-center items-center z-50">
                    <div class="bg-white rounded-xl shadow-xl w-full max-w-lg p-6 relative mx-4">
                        <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center"><i class="fas fa-plus-circle text-blue-500 mr-2"></i> Thêm cơ sở khu vực mới</h3>
                        <form asp-action="ThemCoSo" method="post" class="space-y-4">
                            <div>
                                <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Tên khu vực / Cơ sở</label>
                                <input type="text" name="tenCoSo" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm" placeholder="Ví dụ: Cầu Giấy">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Địa chỉ cụ thể</label>
                                <input type="text" name="diaChi" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm" placeholder="Ví dụ: 219 Nguyễn Ngọc Vũ">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Mô tả chi tiết</label>
                                <textarea name="moTa" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm" placeholder="Nhập mô tả chi tiết vị trí cơ sở..."></textarea>
                            </div>
                            <div class="flex justify-end space-x-3 pt-2">
                                <button type="button" onclick="closeModal('modalThemCoSo')" class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 text-sm font-medium hover:bg-gray-50 transition">Hủy bỏ</button>
                                <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium shadow-sm transition">Lưu lại</button>
                            </div>
                        </form>
                    </div>
                </div>

                <div id="modalSuaCoSo" class="fixed inset-0 bg-gray-900 bg-opacity-50 hidden justify-center items-center z-50">
                    <div class="bg-white rounded-xl shadow-xl w-full max-w-lg p-6 relative mx-4">
                        <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center"><i class="fas fa-edit text-yellow-500 mr-2"></i> Chỉnh sửa thông tin cơ sở</h3>
                        <form asp-action="SuaCoSo" method="post" class="space-y-4">
                            <input type="hidden" id="edit_maCoSo" name="maCoSo" />
                            <div>
                                <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Tên khu vực / Cơ sở</label>
                                <input type="text" id="edit_tenCoSo" name="tenCoSo" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Địa chỉ cụ thể</label>
                                <input type="text" id="edit_diaChi" name="diaChi" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Mô tả chi tiết</label>
                                <textarea id="edit_moTa" name="moTa" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"></textarea>
                            </div>
                            <div class="flex justify-end space-x-3 pt-2">
                                <button type="button" onclick="closeModal('modalSuaCoSo')" class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 text-sm font-medium hover:bg-gray-50 transition">Hủy</button>
                                <button type="submit" class="px-4 py-2 bg-yellow-600 hover:bg-yellow-700 text-white rounded-lg text-sm font-medium shadow-sm transition">Cập nhật</button>
                            </div>
                        </form>
                    </div>
                </div>
            }

            else if (currentTab == "BaiDang")
            {
                <h2 class="text-2xl font-bold text-gray-800 mb-6">📝 Danh sách bài đăng phòng trọ trên hệ thống</h2>
                <div class="bg-white rounded-xl shadow-sm overflow-hidden border border-gray-200">
                    <table class="w-full text-left border-collapse">
                        <thead class="bg-gray-50 border-b border-gray-200">
                            <tr>
                                <th class="p-4 font-semibold text-sm text-gray-600">Mã</th>
                                <th class="p-4 font-semibold text-sm text-gray-600">Tiêu đề bài đăng</th>
                                <th class="p-4 font-semibold text-sm text-gray-600">Giá thuê</th>
                                <th class="p-4 font-semibold text-sm text-gray-600">Trạng thái</th>
                                <th class="p-4 font-semibold text-sm text-gray-600 text-center">Hành động kiểm duyệt</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100 text-sm">
                            @if (danhSachBaiDang != null && danhSachBaiDang.Any())
                            {
                                foreach (var bai in danhSachBaiDang)
                                {
                                    <tr class="hover:bg-gray-50 transition">
                                        <td class="p-4 font-medium text-gray-700">@bai.MaBaiDang</td>
                                        <td class="p-4 text-gray-800 font-semibold">@bai.TieuDe</td>
                                        <td class="p-4 text-red-600 font-bold">@bai.PhongNavigation?.GiaPhong.ToString("N0") đ</td>
                                        <td class="p-4">
                                            @if (bai.TrangThai == "Approved" || bai.TrangThai == "Hiển thị")
                                            {
                                                <span class="bg-green-100 text-green-700 px-2.5 py-1 rounded-full text-xs font-bold"><i class="fas fa-check-circle mr-1"></i>Đã duyệt</span>
                                            }
                                            else if (bai.TrangThai == "Pending" || bai.TrangThai == "Chờ duyệt")
                                            {
                                                <span class="bg-yellow-100 text-yellow-700 px-2.5 py-1 rounded-full text-xs font-bold animate-pulse"><i class="fas fa-spinner mr-1"></i>Chờ duyệt</span>
                                            }
                                            else
                                            {
                                                <span class="bg-red-100 text-red-700 px-2.5 py-1 rounded-full text-xs font-bold"><i class="fas fa-times-circle mr-1"></i>Từ chối</span>
                                            }
                                        </td>
                                        <td class="p-4 flex justify-center space-x-2">
                                            <form asp-action="DuyetBaiDang" method="post" class="inline">
                                                <input type="hidden" name="id" value="@bai.MaBaiDang" />
                                                <input type="hidden" name="trangThai" value="Approved" />
                                                <button type="submit" class="bg-green-500 hover:bg-green-600 text-white px-3 py-1.5 rounded-lg text-xs font-semibold transition shadow-sm">
                                                    <i class="fas fa-check mr-1"></i> Duyệt bài
                                                </button>
                                            </form>
                                            <form asp-action="DuyetBaiDang" method="post" class="inline">
                                                <input type="hidden" name="id" value="@bai.MaBaiDang" />
                                                <input type="hidden" name="trangThai" value="Rejected" />
                                                <button type="submit" class="bg-red-500 hover:bg-red-600 text-white px-3 py-1.5 rounded-lg text-xs font-semibold transition shadow-sm">
                                                    <i class="fas fa-ban mr-1"></i> Chặn tin
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="p-8 text-center text-gray-400"><i class="fas fa-folder-open mr-2 text-xl"></i>Hiện tại không có bài đăng nào cần duyệt.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            else if (currentTab == "ToaNha")
            {
                <h2 class="text-2xl font-bold text-gray-800 mb-6">🏢 Danh sách hệ thống tòa nhà cho thuê</h2>
                <div class="bg-white rounded-xl shadow-sm overflow-hidden border border-gray-200">
                    <table class="w-full text-left border-collapse">
                        <thead class="bg-gray-50 border-b border-gray-200">
                            <tr>
                                <th class="p-4 font-semibold text-sm text-gray-600">Mã</th>
                                <th class="p-4 font-semibold text-sm text-gray-600">Tên tòa nhà</th>
                                <th class="p-4 font-semibold text-sm text-gray-600">Địa điểm / Khu vực</th>
                                <th class="p-4 font-semibold text-sm text-gray-600">Phê duyệt</th>
                                <th class="p-4 font-semibold text-sm text-gray-600 text-center">Hành động</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100 text-sm">
                            @if (danhSachToaNha != null && danhSachToaNha.Any())
                            {
                                foreach (var tn in danhSachToaNha)
                                {
                                    <tr class="hover:bg-gray-50 transition">
                                        <td class="p-4 text-gray-500">#@tn.MaToaNha</td>
                                        <td class="p-4 text-gray-800 font-semibold">@tn.TenToaNha</td>
                                        <td class="p-4 text-gray-600"><i class="fas fa-map-marker-alt text-red-400 mr-1"></i> @tn.CoSo?.TenCoSo</td>
                                        <td class="p-4">
                                            @if (tn.TrangThai == "Approved")
                                            {
                                                <span class="text-xs bg-green-100 text-green-700 px-2 py-0.5 rounded font-bold">Hợp lệ</span>
                                            }
                                            else
                                            {
                                                <span class="text-xs bg-yellow-100 text-yellow-700 px-2 py-0.5 rounded font-bold">Chờ kiểm tra</span>
                                            }
                                        </td>
                                        <td class="p-4 flex justify-center space-x-2">
                                            <form asp-action="DuyetToaNha" method="post" class="inline">
                                                <input type="hidden" name="id" value="@tn.MaToaNha" />
                                                <input type="hidden" name="trangThai" value="Approved" />
                                                <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white px-2.5 py-1 rounded text-xs transition">Kích hoạt</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="p-8 text-center text-gray-400">Không tìm thấy tòa nhà nào trong hệ thống.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            else if (currentTab == "NguoiDung")
            {
                <h2 class="text-2xl font-bold text-gray-800 mb-4">👥 Quản lý thành viên tài khoản</h2>
                <p class="text-gray-500 text-sm mb-6">Bạn có thể kết nối thêm DbSet bảng người dùng để kích hoạt tính năng khóa/mở khóa tài khoản chủ trọ spam ở tab này.</p>
                <div class="bg-white p-8 rounded-xl border border-dashed border-gray-300 text-center text-gray-400">
                    <i class="fas fa-users-cog text-4xl mb-2 text-gray-300"></i>
                    <p>Tab tính năng đang sẵn sàng cấu hình thêm.</p>
                </div>
            }

        </main>
    </div>

    <script>
        function openModal(id) {
        const modal = document.getElementById(id);
        if (modal) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        }
        }

        document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape') {
        closeModal('modalThemCoSo');
        closeModal('modalSuaCoSo');
        }
        });

        function closeModal(id) {
        const modal = document.getElementById(id);
        if (modal) {
        modal.classList.remove('flex');
        modal.classList.add('hidden');
        }
        }

        function openEditCoSoModal(ma, ten, diachi, mota) {
        document.getElementById('edit_maCoSo').value = ma;
        document.getElementById('edit_tenCoSo').value = ten;
        document.getElementById('edit_diaChi').value = diachi;
        document.getElementById('edit_moTa').value = mota;
        openModal('modalSuaCoSo');
        }
    </script>

