                            <thead class="bg-gray-50 border-b border-gray-200">
                                <tr>
                                    <th class="p-4 font-semibold text-sm text-gray-600 w-16">Mã</th>
                                    <th class="p-4 font-semibold text-sm text-gray-600">Tên tòa nhà</th>
                                    <th class="p-4 font-semibold text-sm text-gray-600">Địa điểm / Khu vực</th>
                                    <th class="p-4 font-semibold text-sm text-gray-600">Phê duyệt</th>
                                    <th class="p-4 font-semibold text-sm text-gray-600 text-center w-64">Hành động</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100 text-sm">
                                @if (danhSachToaNha != null && danhSachToaNha.Any())
