                                <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Địa chỉ Email</label>
                                <input type="email" name="email" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm" placeholder="thanhthuy@gmail.com">
                            </div>
                            <div class="flex justify-end space-x-3 pt-2 border-t">
                                <button type="button" onclick="closeModal('modalThemChuTro')" class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 text-sm font-medium hover:bg-gray-50 transition">Hủy bỏ</button>
                                <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium shadow-sm transition">Lưu tài khoản</button>
                            </div>
                        </form>
                    </div>
                </div>
            }
        </main>
    </div>

    <!-- SCRIPTS -->
    <script>
        function openModal(id) {
        const modal = document.getElementById(id);
        if (modal) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        }
        }

        document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
        closeModal('modalThemCoSo');
        closeModal('modalSuaCoSo');
        closeModal('modalThemToaNha');
        closeModal('modalThemChuTro');
        closeModal('modalXoaCoSo');
        closePreviewModal();
        }
        });

        function closeModal(id) {
        const modal = document.getElementById(id);
        if (modal) {
        modal.classList.remove('flex');
        modal.classList.add('hidden');
        }
        }

        function openEditCoSoModal(ma, ten, diachi, mota) {
        document.getElementById('edit_maCoSo').value = ma;
        document.getElementById('edit_tenCoSo').value = ten;
        document.getElementById('edit_diaChi').value = diachi;
        document.getElementById('edit_moTa').value = mota;
        openModal('modalSuaCoSo');
        }

        function openDeleteCoSoModal(ma, ten) {
        document.getElementById('delete_maCoSo').value = ma;
        document.getElementById('delete_maCoSo_text').innerText = "#" + ma;
        document.getElementById('delete_tenCoSo').value = ten;
        openModal('modalXoaCoSo');
        }

        function openPreviewModal(event, data) {
        document.getElementById('modalMaBai').innerText = data.id;
        document.getElementById('modalTieuDe').innerText = data.tieuDe;
        document.getElementById('modalGia').innerText = data.gia;
        document.getElementById('modalDienTich').innerText = data.dienTich;
        document.getElementById('modalNguoiDang').innerText = data.nguoiDang;
        document.getElementById('modalDiaChi').innerText = data.diaChi;
        document.getElementById('modalMoTa').innerText = data.moTa;

        // Cập nhật đường dẫn ảnh động cho thẻ img
        const imgElement = document.getElementById('modalAnhChinh');
        imgElement.src = data.hinhAnh ? data.hinhAnh : '/images/default-room.jpg';

        //document.getElementById('modalPostIdDuyet').value = data.id;
        //document.getElementById('modalPostIdChan').value = data.id;

        const modal = document.getElementById('previewModal');
        const container = document.getElementById('modalContainer');

        modal.classList.remove('hidden', 'invisible', 'opacity-0');
        modal.classList.add('opacity-100');
        container.classList.remove('scale-95');
        container.classList.add('scale-100');
        }

        function closePreviewModal() {
        const modal = document.getElementById('previewModal');
        const container = document.getElementById('modalContainer');

        modal.classList.remove('opacity-100');
        modal.classList.add('opacity-0', 'invisible');
        container.classList.remove('scale-100');
        container.classList.add('scale-95');

        setTimeout(() => {
        modal.classList.add('hidden');
        }, 300);
        }

        window.onclick = function(event) {
        const modal = document.getElementById('previewModal');
        if (event.target == modal) {
        closePreviewModal();
        }
        }

        let currentStatusFilter = 'ALL';

        function filterByStatus(status) {
        currentStatusFilter = status;
        const buttons = document.querySelectorAll('#statusFilterGroup button');
        buttons.forEach(btn => {
        btn.classList.remove('bg-white', 'text-slate-800', 'shadow-sm');
        btn.classList.add('text-slate-500', 'hover:text-slate-800');
        });

        const activeBtnMap = {
        'ALL': 'btnFilterAll',
        'PENDING': 'btnFilterPending',
        'APPROVED': 'btnFilterApproved',
        'REJECTED': 'btnFilterRejected'
        };
        const targetBtn = document.getElementById(activeBtnMap[status]);
        if(targetBtn) {
        targetBtn.classList.remove('text-slate-500', 'hover:text-slate-800');
        targetBtn.classList.add('bg-white', 'text-slate-800', 'shadow-sm');
        }
        applyCombinedFilter();
        }

        function searchPosts() {
        applyCombinedFilter();
        }

        function applyCombinedFilter() {
        const searchKey = document.getElementById('postSearchInput').value.toLowerCase().trim();
        const rows = document.querySelectorAll('.bai-dang-row');
        let visibleCount = 0;

        rows.forEach(row => {
        const rowStatus = row.getAttribute('data-status');
        const title = row.querySelector('.row-title').innerText.toLowerCase();
        const id = row.querySelector('.row-id').innerText.toLowerCase();

        const matchStatus = (currentStatusFilter === 'ALL' || rowStatus === currentStatusFilter);
        const matchSearch = (title.includes(searchKey) || id.includes(searchKey));

        if (matchStatus && matchSearch) {
        row.classList.remove('hidden');
        visibleCount++;
        } else {
        row.classList.add('hidden');
        }
        });

        const emptyRow = document.getElementById('emptyFilterRow');
        if (emptyRow) {
        if (visibleCount === 0 && rows.length > 0) {
        emptyRow.classList.remove('hidden');
        } else {
        emptyRow.classList.add('hidden');
        }
        }
        }



        let currentToaNhaStatus = 'Tất cả';

        function filterToaNhaByStatus(status, btn) {
        currentToaNhaStatus = status;

        // Đổi class kích hoạt nút bấm giống hệt logic tab Bài đăng
        const buttons = btn.parentNode.getElementsByTagName('button');
        for (let b of buttons) {
        b.className = "flex-1 sm:flex-none px-3 sm:px-4 py-1.5 rounded-lg text-xs font-bold transition-all text-slate-500 hover:text-slate-800";
        }

        if (status === 'Tất cả') btn.className = "flex-1 sm:flex-none px-3 sm:px-4 py-1.5 rounded-lg text-xs font-bold transition-all bg-white text-slate-800 shadow-sm";
        else if (status === 'Đang hoạt động') btn.className = "flex-1 sm:flex-none px-3 sm:px-4 py-1.5 rounded-lg text-xs font-bold transition-all bg-white text-emerald-600 shadow-sm";
        else if (status === 'Ngừng hoạt động') btn.className = "flex-1 sm:flex-none px-3 sm:px-4 py-1.5 rounded-lg text-xs font-bold transition-all bg-white text-rose-500 shadow-sm";

        applyToaNhaFilters();
        }

        function searchToaNhas() {
        applyToaNhaFilters();
        }

        function applyToaNhaFilters() {
        const keyword = document.getElementById('toaNhaSearchInput').value.toLowerCase().trim();
        const rows = document.querySelectorAll('.toa-nha-row');
        let totalVisible = 0;

        rows.forEach(row => {
        const status = row.getAttribute('data-status');

        // Lấy văn bản thô để đối chiếu tìm kiếm (gồm Mã, Tên tòa nhà, Cơ sở, Địa chỉ)
        const idText = row.querySelector('.tn-id').textContent.toLowerCase().replace('#', '');
        const nameText = row.querySelector('.tn-name').textContent.toLowerCase();
        const areaText = row.querySelector('.tn-area').textContent.toLowerCase();
        const addressText = row.querySelector('.tn-address').textContent.toLowerCase();

        const matchesStatus = (currentToaNhaStatus === 'Tất cả') || (status === currentToaNhaStatus);
        const matchesKeyword = keyword === '' ||
        idText.includes(keyword) ||
        nameText.includes(keyword) ||
        areaText.includes(keyword) ||
        addressText.includes(keyword);

        if (matchesStatus && matchesKeyword) {
        row.classList.remove('hidden');
        totalVisible++;
        } else {
        row.classList.add('hidden');
        }
        });

        // Xử lý dòng thông báo rỗng
        const emptyRow = document.getElementById('toaNhaEmptyFilterRow');
        if (emptyRow) {
        if (totalVisible === 0) emptyRow.classList.remove('hidden');
        else emptyRow.classList.add('hidden');
        }
        }

        function searchChuTro() {
        const keyword = document.getElementById('chuTroSearchInput').value.toLowerCase().trim();
        const rows = document.querySelectorAll('.chu-tro-row');
        let totalVisible = 0;

        rows.forEach(row => {
        // Lấy nội dung thô từ các cột Mã, Tên đăng nhập và Email
        const idText = row.querySelector('.ct-id').textContent.toLowerCase().replace('#', '');
        const nameText = row.querySelector('.ct-name').textContent.toLowerCase();
        const emailText = row.querySelector('.ct-email').textContent.toLowerCase();

        // Nếu khớp từ khóa thì hiện, không thì ẩn
        if (keyword === '' || idText.includes(keyword) || nameText.includes(keyword) || emailText.includes(keyword)) {
        row.classList.remove('hidden');
        totalVisible++;
        } else {
        row.classList.add('hidden');
        }
        });

        // Xử lý dòng thông báo rỗng
        const emptyRow = document.getElementById('chuTroEmptyFilterRow');
        if (emptyRow) {
        if (totalVisible === 0) emptyRow.classList.remove('hidden');
        else emptyRow.classList.add('hidden');
        }
        }

        // ==========================================
        // CẬP NHẬT ĐỒNG HỒ THỜI GIAN THỰC
        // ==========================================
        setInterval(function() {
        const clockElement = document.getElementById('realtimeClock');
        if (clockElement) {
        const now = new Date();

        // Format Ngày/Tháng/Năm
        const day = String(now.getDate()).padStart(2, '0');
        const month = String(now.getMonth() + 1).padStart(2, '0');
        const year = now.getFullYear();

        // Format Giờ:Phút:Giây
        const hours = String(now.getHours()).padStart(2, '0');
        const minutes = String(now.getMinutes()).padStart(2, '0');
        const seconds = String(now.getSeconds()).padStart(2, '0');

        // Ghi đè vào giao diện
        clockElement.innerText = `${day}/${month}/${year} ${hours}:${minutes}:${seconds}`;
        }
        }, 1000); // 1000ms = 1 giây chạy một lần
    </script>
</body>
</html>