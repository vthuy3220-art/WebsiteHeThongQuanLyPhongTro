                                    foreach (var tn in danhSachToaNha)
                                    {
                                        <tr class="hover:bg-gray-50 transition">
                                            <td class="p-4 text-gray-500 font-mono">#@tn.MaToaNha</td>
                                            <td class="p-4 text-gray-800 font-semibold break-words">@tn.TenToaNha</td>
