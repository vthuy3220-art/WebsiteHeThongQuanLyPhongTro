                                                    <form asp-controller="Admin" asp-action="XacNhanDuyetToaNha" method="post" class="inline">
                                                        <input type="hidden" name="id" value="@tn.MaToaNha" />
                                                        <input type="hidden" name="trangThai" value="Hoạt động" />
                                                        <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white px-3 py-1.5 rounded-lg text-xs font-semibold transition shadow-sm">
                                                            Kích hoạt
                                                        </button>
                                                    </form>

                                                    <a href="@Url.Action("NgungHoatDongToaNha", "Admin", new { id = tn.MaToaNha })" class="bg-red-500 hover:bg-red-600 text-white px-3 py-1.5 rounded-lg text-xs font-semibold transition shadow-sm flex items-center">
