                    <h2 class="text-xl sm:text-2xl font-bold text-gray-800">Danh sách hệ thống tòa nhà cho thuê</h2>
                </div>

                <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-sm mb-6 space-y-3">
                    <div class="flex flex-col sm:flex-row gap-3 justify-between items-center">

                        <div class="flex flex-wrap bg-slate-100 p-1 rounded-xl w-full sm:w-auto" id="toaNhaStatusGroup">
                            <button type="button" onclick="filterToaNhaByStatus('Tất cả', this)" class="flex-1 sm:flex-none px-3 sm:px-4 py-1.5 rounded-lg text-xs font-bold transition-all bg-white text-slate-800 shadow-sm">
                                Tất cả
                            </button>
                            <button type="button" onclick="filterToaNhaByStatus('Đang hoạt động', this)" class="flex-1 sm:flex-none px-3 sm:px-4 py-1.5 rounded-lg text-xs font-bold transition-all text-slate-500 hover:text-slate-800">
                                Đang hoạt động
                            </button>
                            <button type="button" onclick="filterToaNhaByStatus('Ngừng hoạt động', this)" class="flex-1 sm:flex-none px-3 sm:px-4 py-1.5 rounded-lg text-xs font-bold transition-all text-slate-500 hover:text-slate-800">
