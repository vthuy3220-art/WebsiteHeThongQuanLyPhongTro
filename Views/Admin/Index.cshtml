            @if (currentTab == "BaiDang")
            {
                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-6">
                    <div>
                        <h2 class="text-xl sm:text-2xl font-bold text-slate-800 tracking-wide">
                            Quản lý bài đăng phòng trọ trên hệ thống
                        </h2>
                        <p class="text-xs text-slate-400 mt-1">Quản lý, tìm kiếm và phê duyệt các bài đăng phòng trọ từ chủ sở hữu.</p>
                    </div>

                    <div class="flex flex-wrap gap-2 text-xs font-bold font-mono">
                        <span class="px-3 py-1.5 bg-amber-50 text-orange-600 border border-amber-200 rounded-xl whitespace-nowrap">
                            Chờ duyệt: @(danhSachBaiDang?.Count(b => b.TrangThai == "Pending" || b.TrangThai == "Chờ duyệt") ?? 0)
                        </span>
                        <span class="px-3 py-1.5 bg-emerald-50 text-emerald-600 border border-emerald-200 rounded-xl whitespace-nowrap">
                            Đã duyệt: @(danhSachBaiDang?.Count(b => b.TrangThai == "Approved" || b.TrangThai == "Hiển thị" || b.TrangThai == "Hoạt động") ?? 0)
                        </span>
                        <span class="px-3 py-1.5 bg-red-50 text-red-600 border border-red-200 rounded-xl whitespace-nowrap">
                            Từ chối: @(danhSachBaiDang?.Count(b => b.TrangThai == "Rejected" || b.TrangThai == "Từ chối") ?? 0)
                        </span>
                    </div>
                </div>

                <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-sm mb-6 space-y-3">
                    <div class="flex flex-col sm:flex-row gap-3 justify-between items-center">
                        <div class="flex flex-wrap bg-slate-100 p-1 rounded-xl w-full sm:w-auto" id="statusFilterGroup">
                            <button onclick="filterByStatus('ALL')" class="flex-1 sm:flex-none px-3 sm:px-4 py-1.5 rounded-lg text-xs font-bold bg-white text-slate-800 shadow-sm transition-all" id="btnFilterAll">
                                Tất cả
                            </button>
                            <button onclick="filterByStatus('PENDING')" class="flex-1 sm:flex-none px-3 sm:px-4 py-1.5 rounded-lg text-xs font-bold text-slate-500 hover:text-slate-800 transition-all" id="btnFilterPending">
                                Chờ duyệt
                            </button>
                            <button onclick="filterByStatus('APPROVED')" class="flex-1 sm:flex-none px-3 sm:px-4 py-1.5 rounded-lg text-xs font-bold text-slate-500 hover:text-slate-800 transition-all" id="btnFilterApproved">
                                Đã duyệt
                            </button>
                            <button onclick="filterByStatus('REJECTED')" class="flex-1 sm:flex-none px-3 sm:px-4 py-1.5 rounded-lg text-xs font-bold text-slate-500 hover:text-slate-800 transition-all" id="btnFilterRejected">
                                Từ chối
                            </button>
                        </div>

                        <div class="relative w-full sm:w-72">
                            <input type="text" id="postSearchInput" onkeyup="searchPosts()" placeholder="Tìm theo tiêu đề hoặc mã..."
                                   class="w-full pl-4 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium focus:outline-none focus:border-slate-400 focus:bg-white transition-all text-slate-700 placeholder-slate-400" />
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-2xl shadow-sm overflow-hidden border border-slate-100">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse min-w-[800px]" id="baiDangTable">
                            <thead class="bg-slate-50/70 border-b border-slate-100">
                                <tr>
                                    <th class="p-4 font-semibold text-xs text-slate-500 uppercase tracking-wider w-16">Mã</th>
                                    <th class="p-4 font-semibold text-xs text-slate-500 uppercase tracking-wider">Tiêu đề bài đăng</th>
                                    <th class="p-4 font-semibold text-xs text-slate-500 uppercase tracking-wider w-32">Giá thuê</th>
                                    <th class="p-4 font-semibold text-xs text-slate-500 uppercase tracking-wider text-center w-36">Trạng thái</th>
                                    <th class="p-4 font-semibold text-xs text-slate-500 uppercase tracking-wider text-center w-56">Hành động kiểm duyệt</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 text-xs sm:text-sm text-slate-700 font-medium">
                                @if (danhSachBaiDang != null && danhSachBaiDang.Any())
                                {
                                    foreach (var bai in danhSachBaiDang)
                                    {
                                        string statusGroup = "REJECTED";
                                        if (bai.TrangThai == "Approved" || bai.TrangThai == "Hiển thị" || bai.TrangThai == "Hoạt động") statusGroup = "APPROVED";
                                        else if (bai.TrangThai == "Pending" || bai.TrangThai == "Chờ duyệt") statusGroup = "PENDING";

                                        <tr class="hover:bg-slate-50/80 transition-colors cursor-pointer bai-dang-row"
                                            data-status="@statusGroup"
                                            onclick="if(event.target.closest('button') || event.target.closest('form') || event.target.closest('input')) return; openPreviewModal(event, {
                                                            id: '@bai.MaBaiDang',
                                                            tieuDe: '@Html.Raw(JavaScriptEncoder.Default.Encode(bai.TieuDe ?? ""))',
                                                            gia: '@bai.PhongNavigation?.GiaPhong.ToString("N0") đ',
                                                            moTa: '@Html.Raw(JavaScriptEncoder.Default.Encode(bai.MoTa ?? "Không có mô tả"))',
                                                            diaChi: '@Html.Raw(JavaScriptEncoder.Default.Encode(bai.PhongNavigation?.ToaNha?.DiaChi ?? "Chưa cập nhật"))',
                                                            dienTich: '@(bai.PhongNavigation?.DienTich?.ToString() ?? "0") m²',

                                                            // 1. SỬA TẠI ĐÂY: Thay vì hiện số ID (3), lấy Tên đăng nhập hoặc tên hiển thị của chủ trọ
                                                            nguoiDang: '@Html.Raw(JavaScriptEncoder.Default.Encode(bai.PhongNavigation?.ChuTro?.TenDangNhap ?? "Chưa rõ"))',

                                                            // 2. SỬA TẠI ĐÂY: Lấy trực tiếp trường HinhAnh của bài đăng, nếu trống mới dùng ảnh mặc định
                                                            hinhAnh: '@(string.IsNullOrEmpty(bai.HinhAnh) ? "/images/default-room.jpg" : bai.HinhAnh)'
                                                            })">

                                            <td class="p-4 font-mono text-slate-400 row-id">@bai.MaBaiDang</td>
                                            <td class="p-4 text-slate-900 font-bold text-xs sm:text-sm md:text-base leading-snug max-w-xs sm:max-w-md break-words row-title">
                                                @bai.TieuDe
                                            </td>
                                            <td class="p-4 text-rose-600 font-bold font-mono whitespace-nowrap">
                                                @bai.PhongNavigation?.GiaPhong.ToString("N0") đ
                                            </td>

                                            <td class="p-4 text-center whitespace-nowrap">
                                                @if (statusGroup == "APPROVED")
                                                {
                                                    <span class="inline-block px-2.5 py-1 bg-emerald-50 text-emerald-600 border border-emerald-200 rounded-md text-[11px] font-bold">Chấp nhận</span>
                                                }
                                                else if (statusGroup == "PENDING")
                                                {
                                                    <span class="inline-block px-2.5 py-1 bg-amber-50 text-orange-600 border border-amber-200 rounded-md text-[11px] font-bold animate-pulse">Đang chờ</span>
                                                }
                                                else
                                                {
                                                    <span class="inline-block px-2.5 py-1 bg-rose-50 text-rose-600 border border-rose-200 rounded-md text-[11px] font-bold">Từ chối</span>
                                                }
                                            </td>

                                            <td class="p-4">
                                                <div class="flex justify-center items-center gap-2.5 whitespace-nowrap">
                                                    @if (statusGroup == "PENDING")
                                                    {
                                                        <form asp-action="DuyetBaiDang" method="post" class="inline">
                                                            <input type="hidden" name="id" value="@bai.MaBaiDang" />
                                                            <input type="hidden" name="trangThai" value="Hiển thị" />
                                                            <button type="submit" class="bg-emerald-500 hover:bg-emerald-600 text-white px-3 py-1.5 rounded-xl text-[11px] sm:text-xs font-bold transition-colors shadow-sm focus:outline-none">
                                                                Duyệt bài
                                                            </button>
                                                        </form>

                                                        <form asp-action="DuyetBaiDang" method="post" class="inline">
                                                            <input type="hidden" name="id" value="@bai.MaBaiDang" />
                                                            <input type="hidden" name="trangThai" value="Từ chối" />
                                                            <button type="submit" class="bg-rose-500 hover:bg-rose-600 text-white px-3 py-1.5 rounded-xl text-[11px] sm:text-xs font-bold transition-colors shadow-sm focus:outline-none">
                                                                Từ chối
                                                            </button>
                                                        </form>
                                                    }
                                                    else if (statusGroup == "APPROVED")
                                                    {
                                                        <form asp-action="DuyetBaiDang" method="post" class="inline">
                                                            <input type="hidden" name="id" value="@bai.MaBaiDang" />
                                                            <input type="hidden" name="trangThai" value="Từ chối" />
                                                            <button type="submit" class="bg-rose-500 hover:bg-rose-600 text-white px-3 py-1.5 rounded-xl text-[11px] sm:text-xs font-bold transition-colors shadow-sm focus:outline-none">
                                                                Từ chối
                                                            </button>
                                                        </form>
                                                    }
                                                    else
                                                    {
                                                        <form asp-action="DuyetBaiDang" method="post" class="inline">
                                                            <input type="hidden" name="id" value="@bai.MaBaiDang" />
                                                            <input type="hidden" name="trangThai" value="Hiển thị" />
                                                            <button type="submit" class="bg-emerald-500 hover:bg-emerald-600 text-white px-3 py-1.5 rounded-xl text-[11px] sm:text-xs font-bold transition-colors shadow-sm focus:outline-none">
                                                                Duyệt bài
                                                            </button>
                                                        </form>

                                                        <form asp-action="DuyetBaiDang" method="post" class="inline">
                                                            <input type="hidden" name="id" value="@bai.MaBaiDang" />
                                                            <input type="hidden" name="trangThai" value="Từ chối" />
                                                            <button type="submit" class="bg-rose-500 hover:bg-rose-600 text-white px-3 py-1.5 rounded-xl text-[11px] sm:text-xs font-bold transition-colors shadow-sm focus:outline-none">
                                                                Từ chối
                                                            </button>
                                                        </form>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr id="noDataRow">
                                        <td colspan="5" class="p-10 text-center text-slate-400 italic font-normal">
                                            Hiện tại không có bài đăng phòng trọ nào.
                                        </td>
                                    </tr>
                                }
                                <tr id="emptyFilterRow" class="hidden">
                                    <td colspan="5" class="p-10 text-center text-slate-400 italic font-normal">
                                        Không tìm thấy bài đăng nào phù hợp với bộ lọc.
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            <!-- PREVIEW MODAL CHỈNH SỬA: RỘNG HƠN VÀ THÊM KHU VỰC HÌNH ẢNH CO GIÃN -->
