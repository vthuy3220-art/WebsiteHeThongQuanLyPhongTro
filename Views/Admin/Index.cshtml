                                                            <input type="hidden" name="trangThai" value="Hoạt động" />
                                                            <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white px-3 py-1.5 rounded-lg text-xs font-semibold transition shadow-sm">
                                                                Kích hoạt lại
                                                            </button>
                                                        </form>
                                                    }
                                                    else
