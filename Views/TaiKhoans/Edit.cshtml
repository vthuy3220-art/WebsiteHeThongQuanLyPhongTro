@model HeThongQuanLyPhongTro.Models.TaiKhoan

@{
    ViewData["Title"] = "Chỉnh sửa tài khoản";
    Layout = "_Layout";
}

<div class="container mx-auto px-4 py-8">
    <div class="max-w-md mx-auto bg-white rounded-xl shadow-md overflow-hidden">
        <div class="bg-gradient-to-r from-yellow-500 to-orange-600 px-6 py-4">
            <h2 class="text-xl font-bold text-white flex items-center gap-2">
                <i class="fas fa-edit"></i> Chỉnh sửa tài khoản
            </h2>
        </div>

        <div class="p-6">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="MaTaiKhoan" />

                <div class="mb-4">
                    <label asp-for="TenDangNhap" class="block text-gray-700 font-medium mb-2">Tên đăng nhập</label>
                    <input asp-for="TenDangNhap" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                    <span asp-validation-for="TenDangNhap" class="text-red-500 text-sm"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="MatKhau" class="block text-gray-700 font-medium mb-2">Mật khẩu</label>
                    <input asp-for="MatKhau" type="password" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                    <span asp-validation-for="MatKhau" class="text-red-500 text-sm"></span>
                    <p class="text-xs text-gray-500 mt-1">Để trống nếu không muốn đổi mật khẩu</p>
                </div>

                <div class="mb-4">
                    <label asp-for="VaiTro" class="block text-gray-700 font-medium mb-2">Vai trò</label>
                    <select asp-for="VaiTro" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="Admin">Admin</option>
                        <option value="Khach">Khách hàng</option>
                    </select>
                    <span asp-validation-for="VaiTro" class="text-red-500 text-sm"></span>
                </div>

                <div class="mb-6">
                    <label asp-for="TrangThai" class="block text-gray-700 font-medium mb-2">Trạng thái</label>
                    <select asp-for="TrangThai" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="Hoạt động">Hoạt động</option>
                        <option value="Khóa">Khóa</option>
                    </select>
                    <span asp-validation-for="TrangThai" class="text-red-500 text-sm"></span>
                </div>

                <div class="flex gap-3">
                    <button type="submit" class="flex-1 bg-blue-500 hover:bg-blue-600 text-white py-2 rounded-lg transition-all">
                        <i class="fas fa-save mr-2"></i> Lưu
                    </button>
                    <a asp-action="Index" class="flex-1 bg-gray-300 hover:bg-gray-400 text-gray-700 text-center py-2 rounded-lg transition-all">
                        <i class="fas fa-arrow-left mr-2"></i> Hủy
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}