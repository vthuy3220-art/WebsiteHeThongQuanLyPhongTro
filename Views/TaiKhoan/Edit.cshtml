@model HeThongQuanLyPhongTro.Models.TaiKhoan

@{
    ViewData["Title"] = "Sửa tài khoản khách hàng";
    Layout = "_Layout";
}

<div class="max-w-2xl mx-auto">
    <div class="bg-white rounded-xl shadow-md overflow-hidden">
        <div class="bg-gradient-to-r from-yellow-500 to-yellow-600 px-6 py-4">
            <h1 class="text-xl font-bold text-white">Sửa tài khoản khách hàng</h1>
            <p class="text-yellow-100 text-sm">Cập nhật thông tin tài khoản</p>
        </div>

        <form asp-action="Edit" method="post" class="p-6 space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="MaTaiKhoan" />
            <input type="hidden" asp-for="VaiTro" />

            @if (TempData["Success"] != null)
            {
                <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-3 rounded">
                    <i class="fas fa-check-circle mr-2"></i> @TempData["Success"]
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-3 rounded">
                    <i class="fas fa-exclamation-circle mr-2"></i> @TempData["Error"]
                </div>
            }

            <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm"></div>

            <div>
                <label asp-for="TenDangNhap" class="block text-sm font-medium text-gray-700 mb-2">Tên đăng nhập <span class="text-red-500">*</span></label>
                <input asp-for="TenDangNhap" class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-yellow-500" required />
                <span asp-validation-for="TenDangNhap" class="text-red-500 text-sm"></span>
            </div>

            <div>
                <label asp-for="MatKhau" class="block text-sm font-medium text-gray-700 mb-2">Mật khẩu</label>
                <input asp-for="MatKhau" type="password" class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-yellow-500" />
                <span asp-validation-for="MatKhau" class="text-red-500 text-sm"></span>
                <p class="text-xs text-gray-400 mt-1">Để trống nếu không muốn thay đổi mật khẩu</p>
            </div>

            <div>
                <label asp-for="Email" class="block text-sm font-medium text-gray-700 mb-2">Email</label>
                <input asp-for="Email" type="email" class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-yellow-500" />
                <span asp-validation-for="Email" class="text-red-500 text-sm"></span>
            </div>

            <div>
                <label asp-for="TrangThai" class="block text-sm font-medium text-gray-700 mb-2">Trạng thái</label>
                <select asp-for="TrangThai" class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-yellow-500">
                    <option value="Hoạt động">Hoạt động</option>
                    <option value="Khóa">Khóa</option>
                </select>
                <span asp-validation-for="TrangThai" class="text-red-500 text-sm"></span>
            </div>

            <div class="flex justify-end space-x-3 pt-4 border-t">
                <a asp-action="DanhSachKhachHang" class="px-4 py-2 border rounded-lg hover:bg-gray-50 transition-all">Hủy</a>
                <button type="submit" class="px-4 py-2 bg-yellow-500 text-white rounded-lg hover:bg-yellow-600 transition-all">
                    <i class="fas fa-save mr-2"></i> Cập nhật
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}