@model HeThongQuanLyPhongTro.Models.TaiKhoan

@{
    ViewData["Title"] = "Cài đặt thông tin ngân hàng";
    Layout = "_Layout";
}

<div class="container mx-auto px-4 py-8">
    <div class="max-w-2xl mx-auto bg-white rounded-xl shadow-md overflow-hidden">
        <div class="bg-gradient-to-r from-blue-600 to-indigo-700 px-6 py-4">
            <h2 class="text-xl font-bold text-white flex items-center gap-2">
                <i class="fas fa-university"></i> Cài đặt thông tin ngân hàng
            </h2>
            <p class="text-blue-100 text-sm mt-1">Thông tin này sẽ hiển thị trên mã QR thanh toán hóa đơn</p>
        </div>

        <div class="p-6">
            @if (TempData["Success"] != null)
            {
                <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-3 mb-4 rounded">
                    <i class="fas fa-check-circle mr-2"></i> @TempData["Success"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-3 mb-4 rounded">
                    <i class="fas fa-exclamation-circle mr-2"></i> @TempData["Error"]
                </div>
            }

            <form method="post">
                <div class="mb-4">
                    <label class="block text-gray-700 font-medium mb-2">Tên ngân hàng</label>
                    <input asp-for="TenNganHang" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                           placeholder="VD: Techcombank, Vietcombank, BIDV..." />
                    <span asp-validation-for="TenNganHang" class="text-red-500 text-sm"></span>
                </div>

                <div class="mb-4">
                    <label class="block text-gray-700 font-medium mb-2">Số tài khoản</label>
                    <input asp-for="SoTaiKhoan" class="w-full px-4 py-2 border rounded-lg"
                           placeholder="Nhập số tài khoản ngân hàng" />
                    <span asp-validation-for="SoTaiKhoan" class="text-red-500 text-sm"></span>
                </div>

                <div class="mb-4">
                    <label class="block text-gray-700 font-medium mb-2">Chủ tài khoản</label>
                    <input asp-for="ChuTaiKhoan" class="w-full px-4 py-2 border rounded-lg"
                           placeholder="Tên chủ tài khoản" />
                    <span asp-validation-for="ChuTaiKhoan" class="text-red-500 text-sm"></span>
                </div>

                <div class="bg-yellow-50 p-4 rounded-lg mb-4">
                    <div class="flex items-start gap-3">
                        <i class="fas fa-info-circle text-yellow-600 mt-0.5"></i>
                        <div class="text-sm text-yellow-800">
                            <p class="font-semibold mb-1">Lưu ý:</p>
                            <ul class="list-disc list-inside space-y-1">
                                <li>Thông tin này sẽ được sử dụng để tạo mã QR thanh toán</li>
                                <li>Khách hàng sẽ chuyển khoản vào đúng số tài khoản này</li>
                                <li>Vui lòng nhập chính xác để tránh sai sót</li>
                            </ul>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.SoTaiKhoan))
                {
                    <div class="bg-gray-50 p-4 rounded-lg mb-4 text-center">
                        <p class="text-sm text-gray-600 mb-2">Mã QR thanh toán mẫu:</p>
                        @{
                            var qrContent = $"Bank:{Model.TenNganHang ?? "Techcombank"}|Account:{Model.SoTaiKhoan}|Amount:0|Content:TT_HDXXXXX";
                            var qrUrl = $"https://api.qrserver.com/v1/create-qr-code/?size=120x120&data={Uri.EscapeDataString(qrContent)}";
                        }
                        <img src="@qrUrl" class="mx-auto w-24 h-24" />
                        <p class="text-xs text-gray-400 mt-2">* Số tiền và mã hóa đơn sẽ tự động cập nhật</p>
                    </div>
                }

                <div class="flex gap-3">
                    <button type="submit" class="flex-1 bg-green-500 hover:bg-green-600 text-white py-2 rounded-lg transition-all">
                        <i class="fas fa-save mr-2"></i> Lưu thông tin
                    </button>
                    <a asp-action="Index" asp-controller="Dashboard" class="flex-1 bg-gray-300 hover:bg-gray-400 text-gray-700 text-center py-2 rounded-lg transition-all">
                        <i class="fas fa-arrow-left mr-2"></i> Quay lại
                    </a>
                </div>
            </form>s
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}