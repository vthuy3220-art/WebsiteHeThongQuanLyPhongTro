@{
    ViewData["Title"] = "Đổi mật khẩu";
    Layout = "_Layout";
}

<div class="max-w-md mx-auto">
    <div class="bg-white rounded-2xl shadow-xl overflow-hidden">
        <div class="bg-gradient-to-r from-yellow-500 to-orange-600 px-8 py-6">
            <div class="flex items-center space-x-4">
                <div class="w-16 h-16 bg-white/20 rounded-2xl flex items-center justify-center">
                    <i class="fas fa-key text-4xl text-white"></i>
                </div>
                <div>
                    <h2 class="text-2xl font-bold text-white">Đổi mật khẩu</h2>
                    <p class="text-yellow-100 text-sm">Bảo mật tài khoản của bạn</p>
                </div>
            </div>
        </div>

        <div class="p-8">
            @if (TempData["Error"] != null)
            {
                <div class="mb-6 bg-red-50 border-l-4 border-red-500 text-red-700 p-4 rounded-lg">
                    @TempData["Error"]
                </div>
            }

            <form method="post">
                <div class="space-y-5">
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Mật khẩu hiện tại</label>
                        <input type="password" name="matKhauCu" required
                               class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-yellow-500" />
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Mật khẩu mới</label>
                        <input type="password" name="matKhauMoi" id="matKhauMoi" required
                               class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-yellow-500" />
                        <p class="text-xs text-gray-400 mt-1">Mật khẩu nên có ít nhất 6 ký tự</p>
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Xác nhận mật khẩu mới</label>
                        <input type="password" name="xacNhanMatKhau" id="xacNhanMatKhau" required
                               class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-yellow-500" />
                        <span id="passMatchError" class="text-red-500 text-sm hidden">Mật khẩu xác nhận không khớp</span>
                    </div>
                </div>

                <div class="mt-8 flex gap-3">
                    <button type="submit" id="submitBtn" class="flex-1 bg-yellow-500 hover:bg-yellow-600 text-white py-3 rounded-xl font-semibold">
                        Đổi mật khẩu
                    </button>
                    <a asp-action="Index1" class="flex-1 bg-gray-200 hover:bg-gray-300 text-gray-700 text-center py-3 rounded-xl font-semibold">
                        Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    const matKhauMoi = document.getElementById('matKhauMoi');
    const xacNhan = document.getElementById('xacNhanMatKhau');
    const errorSpan = document.getElementById('passMatchError');
    const submitBtn = document.getElementById('submitBtn');

    function validatePassword() {
        if (matKhauMoi.value !== xacNhan.value) {
            errorSpan.classList.remove('hidden');
            submitBtn.disabled = true;
            submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
        } else {
            errorSpan.classList.add('hidden');
            submitBtn.disabled = false;
            submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
        }
    }

    matKhauMoi.addEventListener('input', validatePassword);
    xacNhan.addEventListener('input', validatePassword);
</script>