@model HeThongQuanLyPhongTro.Models.CoSo

@{
    ViewData["Title"] = "Chi tiết cơ sở";
    Layout = "_Layout";
    var toaNhas = ViewBag.ToaNhas as List<HeThongQuanLyPhongTro.Models.ToaNha>;
    var isSuperAdmin = ViewBag.IsSuperAdmin == true;
}

<div class="max-w-4xl mx-auto space-y-6">
    <div class="bg-white rounded-xl shadow-md overflow-hidden">
        <div class="bg-gradient-to-r from-blue-600 to-indigo-700 px-6 py-4">
            <h2 class="text-xl font-bold text-white">📋 Chi tiết cơ sở</h2>
        </div>

        <div class="p-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="flex justify-between p-3 bg-gray-50 rounded-lg">
                    <span class="text-gray-600 font-medium">Mã cơ sở:</span>
                    <span class="font-semibold">@Model.MaCoSo</span>
                </div>
                <div class="flex justify-between p-3 bg-gray-50 rounded-lg">
                    <span class="text-gray-600 font-medium">Tên khu vực:</span>
                    <span class="font-semibold">@Model.TenCoSo</span>
                </div>
                <div class="flex justify-between p-3 bg-gray-50 rounded-lg">
                    <span class="text-gray-600 font-medium">Địa chỉ:</span>
                    <span class="font-semibold">@Model.DiaChi</span>
                </div>
                <div class="flex justify-between p-3 bg-gray-50 rounded-lg">
                    <span class="text-gray-600 font-medium">Mô tả:</span>
                    <span class="font-semibold">@(Model.MoTa ?? "Chưa có mô tả")</span>
                </div>
            </div>

            <!-- Danh sách tòa nhà thuộc cơ sở -->
            <div class="mt-6">
                <h3 class="text-lg font-semibold text-gray-800 mb-3 flex items-center">
                    <i class="fas fa-building text-blue-500 mr-2"></i>
                    Danh sách tòa nhà trong khu vực
                </h3>
                @if (toaNhas != null && toaNhas.Any())
                {
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm">
                            <thead class="bg-gray-100">
                                <tr class="border-b">
                                    <th class="p-2 text-left">Mã</th>
                                    <th class="p-2 text-left">Tên tòa nhà</th>
                                    <th class="p-2 text-left">Địa chỉ</th>
                                    <th class="p-2 text-left">Chủ trọ</th>
                                    <th class="p-2 text-center">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var toaNha in toaNhas)
                                {
                                    <tr class="border-b hover:bg-gray-50">
                                        <td class="p-2">@toaNha.MaToaNha</td>
                                        <td class="p-2 font-medium">@toaNha.TenToaNha</td>
                                        <td class="p-2">@toaNha.DiaChi</td>
                                        <td class="p-2">@toaNha.ChuTro?.TenDangNhap</td>
                                        <td class="p-2 text-center">
                                            <a asp-controller="ToaNha" asp-action="Details" asp-route-id="@toaNha.MaToaNha" class="text-blue-500 hover:text-blue-700">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-gray-400 text-center py-4">Chưa có tòa nhà nào trong khu vực này</p>
                }
            </div>

            <div class="flex gap-3 mt-6">
                @if (isSuperAdmin)
                {
                    <a asp-action="Edit" asp-route-id="@Model.MaCoSo" class="bg-yellow-500 hover:bg-yellow-600 text-white px-4 py-2 rounded-lg">
                        <i class="fas fa-edit mr-2"></i> Sửa
                    </a>
                }
                <a asp-action="Index" class="bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded-lg">
                    <i class="fas fa-arrow-left mr-2"></i> Quay lại
                </a>
            </div>
        </div>
    </div>
</div>