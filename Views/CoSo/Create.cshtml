@model HeThongQuanLyPhongTro.Models.CoSo

@{
    ViewData["Title"] = "Thêm cơ sở mới";
    Layout = "_Layout";
}

<div class="max-w-2xl mx-auto">

    <!-- Header -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="bg-gradient-to-r from-green-600 to-teal-600 px-6 py-5">
            <h2 class="text-xl font-bold text-white flex items-center gap-2">
                <i class="fas fa-plus-circle"></i> Thêm cơ sở khu vực mới
            </h2>
            <p class="text-green-100 text-sm mt-1">Cơ sở là đơn vị khu vực địa lý dùng để phân nhóm các tòa nhà</p>
        </div>

        <div class="p-6 space-y-5">
            <form asp-action="Create" method="post">

                <!-- Tên khu vực -->
                <div class="mb-5">
                    <label class="block text-sm font-semibold text-gray-700 mb-1">
                        <i class="fas fa-map-marked-alt mr-1 text-green-500"></i> Tên khu vực <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="TenCoSo"
                           class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-400 text-sm"
                           placeholder="VD: Cầu Giấy, Đống Đa, Thanh Xuân..." required />
                    <span asp-validation-for="TenCoSo" class="text-red-500 text-xs mt-1"></span>
                </div>

                <!-- Địa chỉ -->
                <div class="mb-5">
                    <label class="block text-sm font-semibold text-gray-700 mb-1">
                        <i class="fas fa-map-pin mr-1 text-green-500"></i> Địa chỉ cụ thể
                    </label>
                    <input asp-for="DiaChi"
                           class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-400 text-sm"
                           placeholder="VD: 219 Nguyễn Ngọc Vũ, Cầu Giấy, Hà Nội" />
                    <span asp-validation-for="DiaChi" class="text-red-500 text-xs mt-1"></span>
                </div>

                <!-- Mô tả -->
                <div class="mb-6">
                    <label class="block text-sm font-semibold text-gray-700 mb-1">
                        <i class="fas fa-align-left mr-1 text-green-500"></i> Mô tả khu vực
                    </label>
                    <textarea asp-for="MoTa" rows="4"
                              class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-400 text-sm resize-none"
                              placeholder="Mô tả vị trí, tiện ích xung quanh, đặc điểm nổi bật của khu vực..."></textarea>
                    <span asp-validation-for="MoTa" class="text-red-500 text-xs mt-1"></span>
                </div>

                <!-- Lưu ý nhỏ -->
                <div class="bg-blue-50 border border-blue-100 rounded-lg p-3 mb-5 text-sm text-blue-700 flex items-start gap-2">
                    <i class="fas fa-info-circle mt-0.5"></i>
                    <span>Sau khi thêm cơ sở, chủ trọ có thể chọn khu vực này khi tạo tòa nhà mới.</span>
                </div>

                <!-- Buttons -->
                <div class="flex gap-3">
                    <button type="submit"
                            class="flex-1 bg-green-500 hover:bg-green-600 text-white py-2.5 rounded-lg transition font-semibold text-sm">
                        <i class="fas fa-save mr-2"></i> Lưu cơ sở
                    </button>
                    <a asp-action="Index"
                       class="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 text-center py-2.5 rounded-lg transition font-semibold text-sm">
                        <i class="fas fa-arrow-left mr-2"></i> Hủy
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}