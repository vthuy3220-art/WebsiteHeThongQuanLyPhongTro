@model IEnumerable<HeThongQuanLyPhongTro.Models.CoSo>

@{
    ViewData["Title"] = "Quản lý cơ sở";
    Layout = "_Layout"; // Hoặc "_AdminLayout" tùy thuộc vào file layout admin của bạn
}

<div class="space-y-6">
    <div class="flex justify-between items-center">
       
        <a asp-action="Create" class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg transition-all flex items-center shadow-sm">
            <i class="fas fa-plus mr-2"></i> Thêm cơ sở mới
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 rounded shadow-sm">
            <i class="fas fa-check-circle mr-2"></i> @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 rounded shadow-sm">
            <i class="fas fa-exclamation-circle mr-2"></i> @TempData["Error"]
        </div>
    }

    <div class="bg-white rounded-xl shadow-md p-4 border border-gray-100">
        <form method="get" class="flex gap-4">
            <div class="flex-1">
                <input type="text" name="searchString" value="@ViewBag.SearchString"
                       placeholder="Tìm kiếm theo tên cơ sở hoặc địa chỉ..."
                       class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all">
            </div>
            <div>
                <button type="submit" class="bg-blue-500 text-white px-6 py-2 rounded-lg hover:bg-blue-600 transition-all shadow-sm flex items-center">
                    <i class="fas fa-search mr-2"></i> Tìm kiếm
                </button>
            </div>
        </form>
    </div>

    <div class="bg-white rounded-xl shadow-md overflow-hidden border border-gray-100">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead class="bg-gray-50 border-b border-gray-100">
                    <tr>
                        <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider w-24">Mã cơ sở</th>
                        <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider w-48">Tên cơ sở</th>
                        <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider w-64">Địa chỉ</th>
                        <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider">Mô tả</th>
                        <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider text-center w-32">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4 text-gray-600 font-medium">@item.MaCoSo</td>
                            <td class="px-6 py-4 font-bold text-gray-800">@item.TenCoSo</td>
                            <td class="px-6 py-4 text-gray-600 text-sm">@item.DiaChi</td>
                            <td class="px-6 py-4 text-gray-500 text-sm max-w-xs truncate" title="@item.MoTa">@item.MoTa</td>
                            <td class="px-6 py-4">
                                <div class="flex justify-end space-x-2">
                                    <a asp-action="Details" asp-route-id="@item.MaCoSo"
                                       class="flex items-center justify-center w-8 h-8 bg-blue-50 text-blue-600 hover:bg-blue-600 hover:text-white rounded-md transition-all shadow-sm"
                                       title="Chi tiết">
                                        <i class="fas fa-eye"></i>
                                    </a>

                                    <a asp-action="Edit" asp-route-id="@item.MaCoSo"
                                       class="flex items-center justify-center w-8 h-8 bg-yellow-50 text-yellow-500 hover:bg-yellow-500 hover:text-white rounded-md transition-all shadow-sm"
                                       title="Sửa">
                                        <i class="fas fa-pen"></i>
                                    </a>

                                    <a asp-action="Delete" asp-route-id="@item.MaCoSo"
                                       class="flex items-center justify-center w-8 h-8 bg-red-50 text-red-500 hover:bg-red-500 hover:text-white rounded-md transition-all shadow-sm"
                                       title="Xóa">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-12 bg-white">
                <i class="fas fa-building text-gray-200 text-5xl mb-3"></i>
                <p class="text-gray-500">Chưa có dữ liệu cơ sở nào</p>
                <a asp-action="Create" class="inline-block mt-3 text-blue-500 hover:underline text-sm font-semibold">Thêm cơ sở đầu tiên</a>
            </div>
        }
    </div>
</div>