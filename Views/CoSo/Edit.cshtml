@model HeThongQuanLyPhongTro.Models.CoSo

<div class="max-w-3xl mx-auto">
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold text-gray-800">Chỉnh sửa cơ sở</h1>
        <a asp-action="Index" class="text-gray-500 hover:text-gray-700"><i class="fas fa-times"></i></a>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8">
        <form asp-action="Edit" method="post" class="space-y-5">
            <input type="hidden" asp-for="MaCoSo" />

            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Tên cơ sở</label>
                <input asp-for="TenCoSo" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all" placeholder="Nhập tên cơ sở..." />
                <span asp-validation-for="TenCoSo" class="text-red-500 text-xs mt-1"></span>
            </div>

            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Địa chỉ</label>
                <input asp-for="DiaChi" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all" />
            </div>

            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Mô tả</label>
                <textarea asp-for="MoTa" rows="4" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all"></textarea>
            </div>

            <div class="flex space-x-4 pt-4">
                <button type="submit" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 rounded-xl shadow-lg shadow-blue-200 transition-all">
                    Lưu thay đổi
                </button>
                <a asp-action="Index" class="flex-1 bg-gray-50 text-gray-500 font-bold py-3 rounded-xl text-center hover:bg-gray-100 transition-all">
                    Hủy
                </a>
            </div>
        </form>
    </div>
</div>