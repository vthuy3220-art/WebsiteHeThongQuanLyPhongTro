@model IEnumerable<HeThongQuanLyPhongTro.Models.ThanhToan>

@{
    ViewData["Title"] = "Quản lý thanh toán";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold text-gray-800">Quản lý thanh toán</h1>
            <p class="text-gray-500 mt-1">Danh sách các giao dịch thanh toán</p>
        </div>
        <a asp-action="Create" class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg transition-all">
            <i class="fas fa-plus mr-2"></i> Thêm thanh toán
        </a>
    </div>

    <!-- Alert Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 rounded">
            <i class="fas fa-check-circle mr-2"></i> @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 rounded">
            <i class="fas fa-exclamation-circle mr-2"></i> @TempData["Error"]
        </div>
    }

    <!-- Bảng danh sách -->
    <div class="bg-white rounded-xl shadow-md overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Mã TT</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Hóa đơn</th>
                        <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Số tiền</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Ngày thanh toán</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Nội dung</th>
                        <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Trạng thái</th>
                        <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-gray-50 transition-all">
                            <!-- SỬA: Bỏ chữ TT, chỉ hiển thị số -->
                            <td class="px-4 py-3 font-medium">@item.MaThanhToan</td>
                            <td class="px-4 py-3">HD@(item.HoaDonNavigation?.MaHoaDon)</td>
                            <td class="px-4 py-3 text-right font-semibold text-green-600">@(item.SoTien?.ToString("N0") ?? "0") đ</td>
                            <td class="px-4 py-3">@(item.NgayThanhToan?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</td>
                            <td class="px-4 py-3">@(item.NoiDungChuyenKhoan ?? "---")</td>
                            <td class="px-4 py-3 text-center">
                                @if (item.TrangThai == "Thành công")
                                {
                                    <span class="px-2 py-1 bg-green-100 text-green-700 rounded-full text-xs">
                                        <i class="fas fa-check-circle"></i> Thành công
                                    </span>
                                }
                                else if (item.TrangThai == "Đang xử lý")
                                {
                                    <span class="px-2 py-1 bg-yellow-100 text-yellow-700 rounded-full text-xs">
                                        <i class="fas fa-spinner"></i> Đang xử lý
                                    </span>
                                }
                                else
                                {
                                    <span class="px-2 py-1 bg-red-100 text-red-700 rounded-full text-xs">
                                        <i class="fas fa-times-circle"></i> @item.TrangThai
                                    </span>
                                }
                            </td>
                            <td class="px-4 py-3 text-center">
                                <div class="flex justify-center space-x-2">
                                    <a asp-action="Details" asp-route-id="@item.MaThanhToan" class="text-blue-500 hover:text-blue-700" title="Chi tiết">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.MaThanhToan" class="text-yellow-500 hover:text-yellow-700" title="Sửa">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.MaThanhToan" class="text-red-500 hover:text-red-700" title="Xóa">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="bg-gray-50">
                    <tr>
                        <td colspan="7" class="px-4 py-3 text-right font-semibold">
                            Tổng số: @Model.Count() giao dịch
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-12">
                <i class="fas fa-money-bill-wave text-gray-300 text-5xl mb-3"></i>
                <p class="text-gray-500">Chưa có giao dịch thanh toán nào</p>
                <a asp-action="Create" class="inline-block mt-3 text-blue-500 hover:underline">Thêm thanh toán đầu tiên</a>
            </div>
        }
    </div>
</div>