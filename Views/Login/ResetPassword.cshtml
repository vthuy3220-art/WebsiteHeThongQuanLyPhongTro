<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-blue-50 to-gray-100 py-12 px-4">
    <div class="max-w-md w-full bg-white p-10 rounded-2xl shadow-xl border border-gray-100">
        <h2 class="text-2xl font-bold text-center text-gray-800 mb-6">Tạo mật khẩu mới</h2>

        @if (ViewBag.Error != null)
        {
            <div class="text-red-500 mb-4 text-sm font-bold text-center">@ViewBag.Error</div>
        }

        <form method="post" class="space-y-4">
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Mật khẩu mới</label>
                <input type="password" name="matKhauMoi" required class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none" placeholder="••••••••" />
            </div>
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Xác nhận mật khẩu</label>
                <input type="password" name="xacNhanMatKhau" required class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none" placeholder="••••••••" />
            </div>
            <button type="submit" class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-3 rounded-xl transition-all">Xác nhận đổi mật khẩu</button>
        </form>
    </div>
</div>
    

