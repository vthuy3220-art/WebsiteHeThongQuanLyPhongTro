@{
    Layout = null; // Bỏ Layout chung để không bị trùng lặp thanh điều hướng nếu dự án có sẵn _Layout
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng Nhập - Phòng Trọ Xinh</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body class="bg-gradient-to-br from-blue-50 to-gray-100">

    <div class="min-h-screen flex flex-col">

        <!-- Thanh điều hướng -->
        <nav class="bg-white border-b border-gray-200 font-semibold text-slate-700 text-sm w-full z-50 shadow-sm">
            <div class="w-full px-6 md:px-16">
                <div class="flex justify-between h-16 items-center">
                    <a asp-controller="Home" asp-action="Index" class="flex items-center space-x-2 text-blue-600 hover:text-blue-800 transition-colors">
                        <i class="fas fa-home text-2xl"></i>
                        <span class="text-xl font-bold text-gray-800">Trang Chủ</span>
                    </a>
                    <div class="flex space-x-6">
                        <a asp-controller="Home" asp-action="Index" class="hover:text-blue-600 transition-colors">Trang Chủ</a>
                        <a asp-controller="Login" asp-action="Index" class="text-blue-600 border-b-2 border-blue-600 pb-1">Đăng Nhập</a>
                    </div>
                </div>
            </div>
        </nav>

        <!-- Form đăng nhập -->
        <div class="flex-1 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
            <div class="max-w-md w-full bg-white p-10 rounded-2xl shadow-xl border border-gray-100 transition-all">

                <div class="text-center mb-8">
                    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-blue-100 text-blue-600 mb-4 shadow-sm">
                        <i class="fas fa-home text-3xl"></i>
                    </div>
                    <h2 class="text-3xl font-extrabold text-gray-900">Phòng Trọ Xinh</h2>
                    <p class="mt-2 text-sm text-gray-500">Chào mừng bạn quay lại hệ thống</p>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="bg-red-50 border-l-4 border-red-500 text-red-700 p-4 rounded-lg mb-6 flex items-center shadow-sm">
                        <i class="fas fa-exclamation-circle text-xl mr-3"></i>
                        <span class="text-sm font-medium">@ViewBag.Error</span>
                    </div>
                }

                <form method="post" class="space-y-6">
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2">Tên đăng nhập</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <i class="fas fa-user text-gray-400"></i>
                            </div>
                            <input type="text"
                                   id="usernameInput"
                                   name="tenDangNhap"
                                   required
                                   class="w-full pl-11 pr-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all text-gray-800"
                                   placeholder="Nhập tài khoản..." />
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2">Mật khẩu</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <i class="fas fa-lock text-gray-400"></i>
                            </div>
                            <input type="password"
                                   id="passwordInput"
                                   name="matKhau"
                                   required
                                   class="w-full pl-11 pr-12 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all text-gray-800"
                                   placeholder="••••••••" />
                            <button type="button"
                                    id="togglePassword"
                                    class="absolute inset-y-0 right-0 pr-4 flex items-center text-gray-400 hover:text-blue-600 focus:outline-none transition-colors">
                                <i class="fas fa-eye text-lg" id="eyeIcon"></i>
                            </button>
                        </div>
                    </div>

                    <div class="flex items-center justify-between">
                        <div class="flex items-center">
                            <input id="remember-me" name="remember-me" type="checkbox" class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded cursor-pointer">
                            <label for="remember-me" class="ml-2 block text-sm text-gray-600 cursor-pointer">Ghi nhớ tôi</label>
                        </div>
                        <div class="text-sm">
                            <a asp-controller="Login" asp-action="ForgotPassword" class="font-bold text-blue-600 hover:text-blue-500 transition-colors">Quên mật khẩu?</a>
                        </div>
                    </div>

                    <div>
                        <button type="submit"
                                class="w-full flex justify-center items-center py-3 px-4 border border-transparent rounded-xl shadow-md text-base font-bold text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-all">
                            Đăng Nhập
                            <i class="fas fa-sign-in-alt ml-2"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Footer liên hệ -->
    <div class="text-center mt-4 text-sm text-gray-600">
        Bạn muốn trở thành chủ trọ trên hệ thống?
        <a href="mailto:admin@phongtroxinh.com" class="text-blue-600 font-bold hover:underline">Liên hệ Admin ngay</a>
    </div>

    <script>
        // 1. LOGIC ẨN/HIỆN MẬT KHẨU (CON MẮT)
        document.getElementById('togglePassword').addEventListener('click', function () {
            const passwordInput = document.getElementById('passwordInput');
            const eyeIcon = document.getElementById('eyeIcon');

            const isPassword = passwordInput.getAttribute('type') === 'password';
            passwordInput.setAttribute('type', isPassword ? 'text' : 'password');

            if (isPassword) {
                eyeIcon.classList.remove('fa-eye');
                eyeIcon.classList.add('fa-eye-slash');
                eyeIcon.classList.add('text-blue-500');
            } else {
                eyeIcon.classList.remove('fa-eye-slash');
                eyeIcon.classList.add('fa-eye');
                eyeIcon.classList.remove('text-blue-500');
            }
        });

        // 2. LOGIC GHI NHỚ NHIỀU TÀI KHOẢN (NÂNG CẤP)
        document.addEventListener('DOMContentLoaded', function () {
            const userInput = document.getElementById('usernameInput');
            const passInput = document.getElementById('passwordInput');
            const rememberChk = document.getElementById('remember-me');
            const form = document.querySelector('form');

            // Tạo datalist cho gợi ý tài khoản đã lưu
            let dataList = document.createElement('datalist');
            dataList.id = 'savedUsersList';
            document.body.appendChild(dataList);
            userInput.setAttribute('list', 'savedUsersList');

            // Lấy danh sách tài khoản đã lưu từ localStorage
            let savedAccounts = JSON.parse(localStorage.getItem('ptx_accounts_list')) || {};

            function updateDropdown() {
                dataList.innerHTML = '';
                for (let user in savedAccounts) {
                    let option = document.createElement('option');
                    option.value = user;
                    dataList.appendChild(option);
                }
            }

            updateDropdown();

            // Khi người dùng nhập/chọn tài khoản
            userInput.addEventListener('input', function () {
                const typedUser = this.value.trim();
                if (savedAccounts[typedUser]) {
                    passInput.value = savedAccounts[typedUser];
                    rememberChk.checked = true;
                } else {
                    passInput.value = '';
                    rememberChk.checked = false;
                }
            });

            // Khi submit form, lưu lại thông tin
            form.addEventListener('submit', function () {
                const currentUser = userInput.value.trim();
                if (!currentUser) return;

                if (rememberChk.checked) {
                    savedAccounts[currentUser] = passInput.value;
                } else {
                    delete savedAccounts[currentUser];
                }

                localStorage.setItem('ptx_accounts_list', JSON.stringify(savedAccounts));
            });
        });
    </script>
</body>
</html>