@model IEnumerable<HeThongQuanLyPhongTro.Models.ThongBao>

@{
    ViewData["Title"] = "Tất cả thông báo";
}

<div class="bg-white p-6 rounded-2xl shadow-md max-w-4xl mx-auto mt-6 border border-gray-100">
    <!-- Header có chứa nút Quay lại Dashboard tiện lợi -->
    <div class="flex justify-between items-center mb-6 border-b pb-4">
        <h2 class="text-xl font-bold text-gray-800 flex items-center gap-2">
            <i class="fas fa-bell text-blue-600"></i> Trung tâm thông báo
        </h2>

        <!-- NÚT QUAY LẠI ĐƯỢC THÊM MỚI TẠI ĐÂY -->
        <a asp-controller="Dashboard" asp-action="Index" class="inline-flex items-center gap-2 px-4 py-2 border border-gray-200 text-sm font-semibold text-gray-600 rounded-xl hover:bg-gray-50 hover:text-blue-600 transition-all shadow-sm">
            <i class="fas fa-arrow-left text-xs"></i> Quay lại Dashboard
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="space-y-3">
            @foreach (var item in Model)
            {
                // Xác định giao diện cho thông báo đã đọc/chưa đọc
                var bgClass = item.DaXem ? "bg-white border border-gray-100" : "bg-blue-50/50 border border-blue-100/70";
                var textClass = item.DaXem ? "font-medium text-gray-700" : "font-bold text-gray-900";
                var contentClass = item.DaXem ? "text-gray-500" : "font-medium text-gray-700";
                var timeClass = item.DaXem ? "text-gray-400" : "text-blue-600 font-medium";

                var iconClass = "fa-bell text-blue-500";
                if (item.Loai == "success") iconClass = "fa-check-circle text-green-500";

                <div class="p-4 rounded-xl flex items-start gap-4 transition-all hover:bg-gray-50/80 @bgClass cursor-pointer"
                     onclick="viewNotification('@item.MaThongBao', '@item.DuongDan')">

                    <div class="mt-0.5 w-11 h-11 rounded-xl bg-white flex items-center justify-center shrink-0 shadow-sm border border-gray-100">
                        <i class="fas @iconClass text-xl"></i>
                    </div>

                    <div class="flex-1">
                        <h4 class="text-sm md:text-base @textClass tracking-wide">@item.TieuDe</h4>
                        <p class="text-xs md:text-sm mt-1 @contentClass leading-relaxed">@item.NoiDung</p>
                        <div class="text-[11px] mt-2 flex items-center @timeClass">
                            <i class="far fa-clock mr-1"></i> @item.NgayTao.ToString("dd/MM/yyyy HH:mm")
                        </div>
                    </div>

                    @if (!item.DaXem)
                    {
                        <div class="w-2.5 h-2.5 bg-blue-600 rounded-full mt-2.5 shrink-0 shadow-sm shadow-blue-500/50"></div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <!-- Trạng thái trống -->
        <div class="text-center py-16 text-gray-500">
            <div class="w-16 h-16 bg-gray-50 rounded-2xl flex items-center justify-center mx-auto mb-4 border border-gray-100 text-gray-300">
                <i class="fas fa-inbox text-3xl"></i>
            </div>
            <p class="font-medium text-gray-600">Hộp thư thông báo đang trống</p>
            <p class="text-xs text-gray-400 mt-1">Hệ thống chưa ghi nhận thông báo mới nào dành cho bạn.</p>
        </div>
    }

    <script>
        function viewNotification(id, duongDan) {
            // Gọi Ajax để đánh dấu đã đọc và lấy URL chuyển hướng
            $.ajax({
                url: '/ThongBao/MarkAsRead',
                type: 'POST',
                data: { id: id },
                success: function (response) {
                    if (response.success && response.url) {
                        window.location.href = response.url;
                    } else {
                        // Fallback: dùng đường dẫn gốc
                        window.location.href = duongDan;
                    }
                },
                error: function () {
                    // Fallback khi lỗi
                    window.location.href = duongDan;
                }
            });
        }
    </script>
</div>
