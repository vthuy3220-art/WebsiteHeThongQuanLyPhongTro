@model IEnumerable<HeThongQuanLyPhongTro.Models.BaiDang>

@{
    ViewData["Title"] = "Quản lý bài đăng";
    var role = Context.Session.GetString("Role");
}

<div class="space-y-6">
    <div class="flex justify-between items-center flex-wrap gap-3">
        @if (role == "ChuTro")
        {
            <a asp-action="Create" class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg transition-all">
                <i class="fas fa-plus mr-2"></i> Đăng tin mới
            </a>
        }
        else
        {
            <div class="text-gray-600 font-medium"><i class="fas fa-shield-alt mr-1"></i> Bảng kiểm duyệt bài đăng hệ thống</div>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 rounded">
            <i class="fas fa-check-circle mr-2"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 rounded">
            <i class="fas fa-exclamation-circle mr-2"></i> @TempData["Error"]
        </div>
    }

    <!-- Bộ lọc -->
    <div class="bg-white rounded-xl shadow-md p-4">
        <form method="get" class="flex gap-3">
            <input type="text" name="searchString" value="@ViewBag.SearchString"
                   placeholder="Tìm theo tiêu đề, tên phòng..."
                   class="flex-1 px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">

            <select name="trangThai" class="px-3 py-2 border rounded-lg">
                @foreach (var item in ViewBag.TrangThaiList)
                {
                    if (ViewBag.TrangThai == item)
                    {
                        <option value="@item" selected>@item</option>
                    }
                    else
                    {
                        <option value="@item">@item</option>
                    }
                }
            </select>

            <button type="submit" class="bg-blue-500 text-white px-4 py-2 rounded-lg">
                <i class="fas fa-search mr-2"></i> Tìm kiếm
            </button>
        </form>
    </div>

    <!-- Danh sách bài đăng dạng card -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var item in Model)
        {
            <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition-all border border-gray-100 flex flex-col justify-between">
                <div>
                    @if (!string.IsNullOrEmpty(item.HinhAnh))
                    {
                        <img src="@item.HinhAnh" alt="@item.TieuDe" class="w-full h-48 object-cover">
                    }
                    else
                    {
                        <div class="w-full h-48 bg-gray-200 flex items-center justify-center">
                            <i class="fas fa-image text-gray-400 text-5xl"></i>
                        </div>
                    }

                    <div class="p-4 pb-2">
                        <div class="flex justify-between items-start mb-2 gap-2">
                            <h3 class="font-bold text-lg text-gray-800 line-clamp-1 flex-1">@item.TieuDe</h3>

                            @if (item.TrangThai == "Approved")
                            {
                                <span class="px-2 py-1 bg-green-100 text-green-700 rounded-full text-[10px] font-semibold shrink-0">
                                    <i class="fas fa-check-circle"></i> Đã duyệt
                                </span>
                            }
                            else if (item.TrangThai == "Pending")
                            {
                                <span class="px-2 py-1 bg-yellow-100 text-yellow-700 rounded-full text-[10px] font-semibold shrink-0 animate-pulse">
                                    <i class="fas fa-clock"></i> Chờ duyệt
                                </span>
                            }
                            else
                            {
                                <span class="px-2 py-1 bg-red-100 text-red-700 rounded-full text-[10px] font-semibold shrink-0">
                                    <i class="fas fa-times-circle"></i> Từ chối
                                </span>
                            }
                        </div>

                        <p class="text-gray-500 text-sm mb-2">
                            <i class="fas fa-bed mr-1 text-blue-500"></i> Phòng: @item.PhongNavigation?.TenPhong
                            <span class="text-gray-400">(@item.PhongNavigation?.ToaNha?.TenToaNha)</span>
                        </p>

                        <p class="text-gray-600 text-sm line-clamp-2 mb-3">@item.MoTa</p>
                    </div>
                </div>

                <div class="p-4 pt-0 border-t border-gray-50 mt-auto">
                    <div class="flex justify-between items-center text-[11px] text-gray-400 py-2">
                        <span><i class="fas fa-calendar-alt mr-1"></i> Đăng lúc: @item.NgayDang?.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>

                    <div class="flex justify-between items-center pt-2">
                        <div class="flex space-x-3 items-center">
                            <a asp-action="Details" asp-route-id="@item.MaBaiDang" class="text-blue-500 hover:text-blue-700 text-sm font-medium" title="Xem chi tiết">
                                <i class="fas fa-eye mr-1"></i> Xem
                            </a>
                            @if (role == "ChuTro")
                            {
                                <a asp-action="Edit" asp-route-id="@item.MaBaiDang" class="text-yellow-500 hover:text-yellow-700 text-sm font-medium" title="Sửa">
                                    <i class="fas fa-edit mr-1"></i> Sửa
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.MaBaiDang" class="text-red-500 hover:text-red-700 text-sm font-medium" title="Xóa">
                                    <i class="fas fa-trash mr-1"></i> Xóa
                                </a>
                            }
                        </div>

                        @if (role == "Admin")
                        {
                            <div class="flex space-x-2">
                                @if (item.TrangThai == "Pending" || item.TrangThai == "Rejected")
                                {
                                    <button onclick="duyetBai(@item.MaBaiDang, 'Approve')" class="bg-green-500 hover:bg-green-600 text-white text-xs px-2.5 py-1.5 rounded font-medium transition-colors">
                                        <i class="fas fa-check mr-1"></i> Duyệt bài
                                    </button>
                                }
                                @if (item.TrangThai == "Pending" || item.TrangThai == "Approved")
                                {
                                    <button onclick="duyetBai(@item.MaBaiDang, 'Reject')" class="bg-red-500 hover:bg-red-600 text-white text-xs px-2.5 py-1.5 rounded font-medium transition-colors">
                                        <i class="fas fa-ban mr-1"></i> Từ chối
                                    </button>
                                }
                            </div>
                        }
                        else if (role == "ChuTro")
                        {
                            @if (item.TrangThai == "Approved")
                            {
                                <button onclick="toggleTrangThai(@item.MaBaiDang, this)" class="text-xs font-medium text-orange-500 hover:underline">
                                    <i class="fas fa-eye-slash mr-1"></i> Ẩn tin đăng
                                </button>
                            }
                            else if (item.TrangThai == "Rejected")
                            {
                                <button onclick="toggleTrangThai(@item.MaBaiDang, this)" class="text-xs font-medium text-green-500 hover:underline">
                                    <i class="fas fa-eye mr-1"></i> Kích hoạt lại
                                </button>
                            }
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="bg-white rounded-xl shadow-md p-12 text-center">
            <i class="fas fa-newspaper text-gray-300 text-5xl mb-3"></i>
            <p class="text-gray-500">Không tìm thấy bài đăng nào tương ứng</p>
            @if (role == "ChuTro")
            {
                <a asp-action="Create" class="inline-block mt-3 text-blue-500 hover:underline">Đăng tin đầu tiên</a>
            }
        </div>
    }
</div>

<!-- Thêm SweetAlert2 cho đẹp -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    // Hàm xử lý duyệt bài của Admin
    function duyetBai(id, actionType) {
    Swal.fire({
    title: actionType === 'Approve' ? 'Xác nhận duyệt bài này?' : 'Xác nhận từ chối bài này?',
    icon: 'question',
    showCancelButton: true,
    confirmButtonColor: actionType === 'Approve' ? '#10B981' : '#EF4444',
    cancelButtonColor: '#6B7280',
    confirmButtonText: 'Đồng ý',
    cancelButtonText: 'Hủy'
    }).then((result) => {
    if (result.isConfirmed) {
    fetch(`/BaiDang/DuyetBaiDang?id=${id}&actionType=${actionType}`, {
    method: 'POST',
    headers: {
    'Content-Type': 'application/json',
    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
    }
    })
    .then(res => res.json())
    .then(data => {
    if (data.success) {
    Swal.fire('Thành công!', 'Cập nhật trạng thái bài đăng thành công.', 'success')
    .then(() => location.reload());
    } else {
    Swal.fire('Lỗi!', data.message || 'Không thể thực thi.', 'error');
    }
    })
    .catch(() => {
    Swal.fire('Lỗi!', 'Có lỗi xảy ra khi kết nối server.', 'error');
    });
    }
    });
    }

    // Hàm ẩn/hiện của Chủ Trọ
    function toggleTrangThai(id, btn) {
    fetch(`@Url.Action("ToggleTrangThai", "BaiDang")?id=${id}`, {
    method: 'POST',
    headers: {
    'Content-Type': 'application/json',
    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
    }
    })
    .then(response => response.json())
    .then(data => {
    if (data.success) {
    location.reload();
    } else {
    Swal.fire('Lỗi!', data.message || 'Có lỗi xảy ra', 'error');
    }
    })
    .catch(() => {
    Swal.fire('Lỗi!', 'Có lỗi xảy ra khi kết nối server.', 'error');
    });
    }
</script>