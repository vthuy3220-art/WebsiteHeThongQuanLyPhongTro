@model HeThongQuanLyPhongTro.Models.BaiDang

@{
    ViewData["Title"] = "Chỉnh sửa bài đăng";
    var phongList = ViewBag.PhongList as List<HeThongQuanLyPhongTro.Models.Phong>;
}

<div class="max-w-3xl mx-auto">
    <div class="bg-white rounded-xl shadow-md overflow-hidden">
        <div class="bg-gradient-to-r from-yellow-500 to-yellow-600 px-6 py-4">
            <div class="flex justify-between items-center">
                <div>
                    <h1 class="text-xl font-bold text-white">Chỉnh sửa bài đăng</h1>
                    <p class="text-yellow-100">Mã bài đăng: @Model.MaBaiDang</p>
                </div>
                <a asp-action="Index" class="text-white hover:text-yellow-200">
                    <i class="fas fa-arrow-left mr-2"></i> Quay lại
                </a>
            </div>
        </div>

        <form asp-action="Edit" method="post" enctype="multipart/form-data" class="p-6 space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="MaBaiDang" />

            <div>
                <label asp-for="MaPhong" class="block text-sm font-medium text-gray-700 mb-2">Phòng <span class="text-red-500">*</span></label>
                <select asp-for="MaPhong" class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-yellow-500">
                    <option value="">-- Chọn phòng --</option>
                    @foreach (var phong in phongList ?? new List<HeThongQuanLyPhongTro.Models.Phong>())
                    {
                        if (phong.MaPhong == Model.MaPhong)
                        {
                            <option value="@phong.MaPhong" selected>@phong.TenPhong - @phong.ToaNha?.TenToaNha</option>
                        }
                        else
                        {
                            <option value="@phong.MaPhong">@phong.TenPhong - @phong.ToaNha?.TenToaNha</option>
                        }
                    }
                </select>
                <span asp-validation-for="MaPhong" class="text-red-500 text-sm"></span>
            </div>

            <div>
                <label asp-for="TieuDe" class="block text-sm font-medium text-gray-700 mb-2">Tiêu đề <span class="text-red-500">*</span></label>
                <input asp-for="TieuDe" class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-yellow-500" />
                <span asp-validation-for="TieuDe" class="text-red-500 text-sm"></span>
            </div>

            <div>
                <label asp-for="MoTa" class="block text-sm font-medium text-gray-700 mb-2">Mô tả</label>
                <textarea asp-for="MoTa" rows="6" class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-yellow-500"></textarea>
                <span asp-validation-for="MoTa" class="text-red-500 text-sm"></span>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Hình ảnh hiện tại</label>
                @if (!string.IsNullOrEmpty(Model.HinhAnh))
                {
                    <div class="mb-2">
                        <img src="@Model.HinhAnh" class="h-32 w-auto object-cover rounded-lg border" />
                    </div>
                }
                <input type="file" name="fileAnh" accept="image/*" class="w-full px-3 py-2 border rounded-lg" />
                <p class="text-xs text-gray-500 mt-1">Để trống nếu không muốn thay đổi ảnh</p>
            </div>

            <div>
                <label asp-for="TrangThai" class="block text-sm font-medium text-gray-700 mb-2">Trạng thái</label>
                <select asp-for="TrangThai" class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-yellow-500">
                    <option value="Hiển thị">Hiển thị</option>
                    <option value="Ẩn">Ẩn</option>
                </select>
                <span asp-validation-for="TrangThai" class="text-red-500 text-sm"></span>
            </div>

            <div class="flex justify-end space-x-3 pt-4">
                <a asp-action="Index" class="px-4 py-2 border rounded-lg hover:bg-gray-50">Hủy</a>
                <button type="submit" class="px-4 py-2 bg-yellow-500 text-white rounded-lg hover:bg-yellow-600">
                    <i class="fas fa-save mr-2"></i> Cập nhật
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}