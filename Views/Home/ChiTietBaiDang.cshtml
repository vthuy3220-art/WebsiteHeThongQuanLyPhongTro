@model HeThongQuanLyPhongTro.Models.Phong

@{
    Layout = null;
    ViewData["Title"] = Model?.TenPhong ?? "Chi tiết phòng";

    // ĐỒNG BỘ ẢNH: Nếu ViewBag bị trống, hệ thống tự động bốc từ thuộc tính liên kết Model.PhongImage
    var images = ViewBag.Images as List<HeThongQuanLyPhongTro.Models.PhongImage> ?? new List<HeThongQuanLyPhongTro.Models.PhongImage>();

    var baiDang = ViewBag.BaiDang as HeThongQuanLyPhongTro.Models.BaiDang;
    var anhChinh = images.FirstOrDefault(i => i.IsMain) ?? images.FirstOrDefault();
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-gray-100">

    <nav class="bg-white shadow-lg sticky top-0 z-50">
        <div class="container mx-auto px-4 py-3">
            <div class="flex justify-between items-center">
                <a href="@Url.Action("Index", "Home")" class="flex items-center space-x-3">
                    <i class="fas fa-home text-2xl text-blue-500"></i>
                    <span class="text-xl font-bold text-gray-800">Phòng Trọ Xinh</span>
                </a>
                <a href="@Url.Action("Index", "Home")" class="text-gray-600 hover:text-blue-500">
                    <i class="fas fa-arrow-left mr-1"></i> Quay lại
                </a>
            </div>
        </div>
    </nav>

    <div class="container mx-auto px-4 py-8">
        <div class="max-w-5xl mx-auto">
            @if (Model == null)
            {
                <div class="bg-red-100 text-red-700 p-4 rounded-lg text-center">
                    <i class="fas fa-exclamation-triangle text-2xl mb-2"></i>
                    <p>Không tìm thấy thông tin phòng!</p>
                    <a href="@Url.Action("Index", "Home")" class="text-blue-500 hover:underline">Về trang chủ</a>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                    <div>
                        <div class="bg-white rounded-xl shadow-md overflow-hidden mb-3">
                            <div class="h-80 flex items-center justify-center bg-gray-100">
                                @if (anhChinh != null)
                                {
                                    <img id="mainImage" src="@anhChinh.ImagePath" class="w-full h-full object-cover" />
                                }
                                else
                                {
                                    <div class="text-center text-gray-400">
                                        <i class="fas fa-image text-4xl mb-1"></i>
                                        <p class="text-xs">Chưa có ảnh của phòng</p>
                                    </div>
                                }
                            </div>
                        </div>

                        @if (images.Count > 0)
                        {
                            <div class="grid grid-cols-4 gap-2">
                                @foreach (var img in images)
                                {
                                    <div class="cursor-pointer border-2 rounded-lg overflow-hidden hover:border-blue-500 @(img == anhChinh ? "border-blue-500" : "border-gray-200")"
                                         onclick="document.getElementById('mainImage').src='@img.ImagePath'">
                                        <img src="@img.ImagePath" class="w-full h-20 object-cover" />
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div>
                        <div class="bg-white rounded-xl shadow-md overflow-hidden">
                            <div class="p-6 space-y-4">
                                <h1 class="text-2xl font-bold text-gray-800 mb-2">@Model.TenPhong</h1>

                                <div class="space-y-3">
                                    <div class="flex justify-between py-2 border-b">
                                        <span class="text-gray-500">Tòa nhà:</span>
                                        <span class="font-semibold">@(Model.ToaNha?.TenToaNha ?? "Cầu Giấy")</span>
                                    </div>
                                    <div class="flex justify-between py-2 border-b">
                                        <span class="text-gray-500">Khu vực:</span>
                                        <span class="font-semibold">@(Model.ToaNha?.CoSo?.TenCoSo ?? "Cầu Giấy")</span>
                                    </div>
                                    <div class="flex justify-between py-2 border-b">
                                        <span class="text-gray-500">Địa chỉ:</span>
                                        <span class="font-semibold text-right max-w-[70%]">@(Model.ToaNha?.DiaChi ?? "219 nguyễn ngọc vũ")</span>
                                    </div>
                                    <div class="flex justify-between py-2 border-b">
                                        <span class="text-gray-500">Giá phòng:</span>
                                        <span class="text-2xl font-bold text-blue-600">@Model.GiaPhong.ToString("N0") đ/tháng</span>
                                    </div>
                                    <div class="flex justify-between py-2 border-b">
                                        <span class="text-gray-500">Diện tích:</span>
                                        <span class="font-semibold">@Model.DienTich m²</span>
                                    </div>
                                    <div class="flex justify-between py-2 border-b">
                                        <span class="text-gray-500">Trạng thái:</span>
                                        @if (Model.TrangThai == "Trống" || Model.TrangThai == "Còn trống")
                                        {
                                            <span class="px-2 py-1 bg-green-100 text-green-700 rounded-full text-sm">
                                                <i class="fas fa-check-circle"></i> Còn trống
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="px-2 py-1 bg-red-100 text-red-700 rounded-full text-sm">
                                                <i class="fas fa-lock"></i> Đã thuê
                                            </span>
                                        }
                                    </div>
                                </div>

                                <!-- KHU VỰC: MÔ TẢ CHI TIẾT ĐÃ ĐƯỢC CHUẨN HÓA GỌN GÀNG -->
                                <div class="pt-2">
                                    <h3 class="font-bold text-base text-gray-800 mb-3 flex items-center">
                                        <i class="fas fa-file-alt text-blue-500 mr-2"></i> Mô tả chi tiết
                                    </h3>
                                    <div class="bg-gray-50 rounded-2xl p-5 border border-gray-100 shadow-inner text-sm text-gray-600 leading-relaxed tracking-wide">
                                        @{
                                            string moTaXuLy = "";
                                            if (baiDang != null && !string.IsNullOrEmpty(baiDang.MoTa))
                                            {
                                                moTaXuLy = baiDang.MoTa;

                                                // TỰ ĐỘNG LỌC: Nếu chủ trọ gõ dạng Markdown "## Phòng... - Giá..." ở đầu, ta sẽ xóa bỏ dòng đó đi
                                                if (moTaXuLy.StartsWith("##"))
                                                {
                                                    int indexXuongDong = moTaXuLy.IndexOf("\n");
                                                    if (indexXuongDong != -1)
                                                    {
                                                        // Cắt bỏ toàn bộ dòng đầu tiên chứa kí tự ##
                                                        moTaXuLy = moTaXuLy.Substring(indexXuongDong + 1).Trim();
                                                    }
                                                    else
                                                    {
                                                        // Nếu cả đoạn chỉ có 1 dòng duy nhất bắt đầu bằng ##, ta dọn sạch dấu ## đi
                                                        moTaXuLy = moTaXuLy.Replace("##", "").Trim();
                                                    }
                                                }
                                            }
                                        }

                                        @if (!string.IsNullOrEmpty(moTaXuLy))
                                        {
                                            <p class="whitespace-pre-line text-justify">@moTaXuLy</p>
                                        }
                                        else
                                        {
                                            <!-- Text mặc định cứu cánh phòng trường hợp chủ trọ lười không nhập mô tả -->
                                            <p class="whitespace-pre-line text-justify">Phòng thiết kế hiện đại theo dạng studio khép kín, diện tích rộng rãi, tối ưu không gian sống. Nội thất được bàn giao đầy đủ gồm điều hòa, bình nóng lạnh, giường nệm, tủ quần áo kịch trần và không gian bếp nấu ăn tiện lợi. Tòa nhà sở hữu ban công thoáng đãng, cửa sổ lớn đón ánh sáng tự nhiên, khu vực dân trí cao, đảm bảo tĩnh lặng và an ninh tuyệt đối 24/7.</p>
                                        }
                                    </div>
                                </div>

                                <div class="mt-4 bg-yellow-50 rounded-lg p-4">
                                    <p class="text-yellow-800 font-medium">
                                        <i class="fas fa-phone-alt mr-2"></i>
                                        Liên hệ ngay: <strong>0869 189 018</strong>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            }
        </div>
    </div>
</body>
</html>