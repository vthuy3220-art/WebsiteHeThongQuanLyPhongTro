@model HeThongQuanLyPhongTro.Models.Phong

@{
    Layout = null;
    ViewData["Title"] = Model?.TenPhong ?? "Chi tiết phòng";

    var images = ViewBag.Images as List<HeThongQuanLyPhongTro.Models.PhongImage> ?? new List<HeThongQuanLyPhongTro.Models.PhongImage>();

    var baiDang = ViewBag.BaiDang as HeThongQuanLyPhongTro.Models.BaiDang;
    var csvcList = ViewBag.CSVCNhanh as List<HeThongQuanLyPhongTro.Models.CoSoVatChat>
                   ?? Model?.CoSoVatChats?.ToList();

    var anhChinh = images.FirstOrDefault(i => i.IsMain) ?? images.FirstOrDefault();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        .main-image {
            height: 400px;
            background: #f3f4f6;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .thumbnail {
            height: 80px;
            object-fit: cover;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

            .thumbnail:hover {
                transform: scale(1.05);
                box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            }

        .active-thumb {
            border: 2px solid #3b82f6;
            box-shadow: 0 0 0 2px rgba(59,130,246,0.3);
        }
    </style>
</head>
<body class="bg-gray-100 font-sans">

    <nav class="bg-white shadow-lg sticky top-0 z-50">
        <div class="container mx-auto px-4 py-3">
            <div class="flex justify-between items-center">
                <a href="@Url.Action("Index", "Home")" class="flex items-center space-x-3">
                    <i class="fas fa-home text-2xl text-blue-500"></i>
                    <span class="text-xl font-bold text-gray-800">Phòng Trọ Xinh</span>
                </a>
                <a href="@Url.Action("Index", "Home")" class="text-gray-600 hover:text-blue-500 font-medium">
                    <i class="fas fa-arrow-left mr-2"></i> Quay lại
                </a>
            </div>
        </div>
    </nav>

    <div class="container mx-auto px-4 py-8">
        <div class="max-w-6xl mx-auto">
            @if (Model == null)
            {
                <div class="bg-red-100 text-red-700 p-4 rounded-lg text-center shadow-sm">
                    <i class="fas fa-exclamation-triangle text-2xl mb-2"></i>
                    <p class="font-semibold">Không tìm thấy thông tin phòng!</p>
                    <a href="@Url.Action("Index", "Home")" class="text-blue-500 hover:underline text-sm">Về trang chủ</a>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

                    <div class="space-y-4">
                        <div class="bg-white rounded-xl shadow-md overflow-hidden">
                            <div class="main-image">
                                @if (anhChinh != null)
                                {
                                    <img id="mainImage" src="@anhChinh.ImagePath" class="w-full h-full object-cover" />
                                }
                                else
                                {
                                    <div class="text-center text-gray-400">
                                        <i class="fas fa-image text-6xl mb-1"></i>
                                        <p class="text-xs">Chưa có ảnh của phòng</p>
                                    </div>
                                }
                            </div>
                        </div>

                        @if (images.Count > 0)
                        {
                            <div class="grid grid-cols-4 gap-3">
                                @foreach (var img in images)
                                {
                                    <div class="cursor-pointer" onclick="changeImage('@img.ImagePath', this)">
                                        <img src="@img.ImagePath" class="thumbnail w-full object-cover @(img == anhChinh ? "active-thumb" : "")" />
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div>
                        <div class="bg-white rounded-xl shadow-md overflow-hidden">
                            <div class="p-6 space-y-4">
                                <h1 class="text-2xl font-bold text-gray-800 border-b pb-2">@Model.TenPhong</h1>

                                <div class="space-y-3 text-sm">
                                    <div class="flex justify-between py-2 border-b border-gray-100">
                                        <span class="text-gray-500">Tòa nhà</span>
                                        <span class="font-semibold text-gray-800">@(Model.ToaNha?.TenToaNha ?? "Cầu Giấy")</span>
                                    </div>
                                    <div class="flex justify-between py-2 border-b border-gray-100">
                                        <span class="text-gray-500">Khu vực</span>
                                        <span class="font-semibold text-gray-800">@(Model.ToaNha?.CoSo?.TenCoSo ?? "Cầu Giấy")</span>
                                    </div>
                                    <div class="flex justify-between py-2 border-b border-gray-100">
                                        <span class="text-gray-500">Địa chỉ</span>
                                        <span class="font-semibold text-gray-700 text-right max-w-[70%]">@(Model.ToaNha?.DiaChi ?? "219 nguyễn ngọc vũ")</span>
                                    </div>
                                    <div class="flex justify-between py-2 border-b border-gray-100 items-center">
                                        <span class="text-gray-500">Giá phòng</span>
                                        <span class="text-xl font-bold text-blue-600">@Model.GiaPhong.ToString("N0") đ/tháng</span>
                                    </div>
                                    <div class="flex justify-between py-2 border-b border-gray-100">
                                        <span class="text-gray-500">Diện tích</span>
                                        <span class="font-bold text-gray-800">@Model.DienTich m²</span>
                                    </div>
                                    <div class="flex justify-between py-2 border-b border-gray-100 items-start">
                                        <span class="text-gray-500 shrink-0">Cơ sở vật chất</span>
                                        <span class="font-semibold text-right text-gray-700 max-w-[70%] leading-relaxed text-xs">
                                            @if (csvcList != null && csvcList.Any())
                                            {
                                                @string.Join(", ", csvcList.Select(c => c.TenThietBi))
                                            }
                                            else
                                            {
                                                <span>Điều hòa, Tủ lạnh, Bình nóng lạnh, Giường, Tủ quần áo, Quạt, Bàn ghế</span>
                                            }
                                        </span>
                                    </div>
                                    <div class="flex justify-between py-2 border-b border-gray-100 items-center">
                                        <span class="text-gray-500">Trạng thái</span>
                                        @if (Model.TrangThai == "Trống" || Model.TrangThai == "Còn trống")
                                        {
                                            <span class="px-2.5 py-1 bg-green-100 text-green-700 rounded-full text-xs font-bold">
                                                <i class="fas fa-check-circle"></i> Còn trống
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="px-2.5 py-1 bg-red-100 text-red-700 rounded-full text-xs font-bold">
                                                <i class="fas fa-lock"></i> Đã thuê
                                            </span>
                                        }
                                    </div>
                                </div>


                                <div class="pt-2">
                                    <h3 class="font-bold text-base text-gray-800 mb-3 flex items-center">
                                        <i class="fas fa-file-alt text-blue-500 mr-2"></i> Mô tả chi tiết
                                    </h3>
                                    <div class="bg-gray-50 rounded-2xl p-5 border border-gray-100 shadow-inner text-sm text-gray-600 leading-relaxed tracking-wide">
                                        @{
                                            string moTaXuLy = "";
                                            if (baiDang != null && !string.IsNullOrEmpty(baiDang.MoTa))
                                            {
                                                moTaXuLy = baiDang.MoTa;

                                                // TỰ ĐỘNG LỌC: Nếu có kí tự Markdown "##" ở dòng đầu, hệ thống tự động cắt bỏ
                                                if (moTaXuLy.StartsWith("##"))
                                                {
                                                    int indexXuongDong = moTaXuLy.IndexOf("\n");
                                                    if (indexXuongDong != -1)
                                                    {
                                                        moTaXuLy = moTaXuLy.Substring(indexXuongDong + 1).Trim();
                                                    }
                                                    else
                                                    {
                                                        moTaXuLy = moTaXuLy.Replace("##", "").Trim();
                                                    }
                                                }
                                            }
                                        }

                                        @if (!string.IsNullOrEmpty(moTaXuLy))
                                        {
                                            <p class="whitespace-pre-line text-justify">@moTaXuLy</p>
                                        }
                                        else
                                        {
                                            <p class="whitespace-pre-line text-justify">Phòng thiết kế hiện đại theo dạng studio khép kín, diện tích rộng rãi, tối ưu không gian sống. Nội thất được bàn giao đầy đủ gồm điều hòa, bình nóng lạnh, giường nệm, tủ quần áo kịch trần và không gian bếp nấu ăn tiện lợi. Tòa nhà sở hữu ban công thoáng đãng, cửa sổ lớn đón ánh sáng tự nhiên, khu vực dân trí cao, đảm bảo tĩnh lặng và an ninh tuyệt đối 24/7.</p>
                                        }
                                    </div>
                                </div>

                                <div class="bg-yellow-50 rounded-xl p-4 border border-yellow-100 mt-2">
                                    <p class="text-yellow-800 flex items-center font-medium text-sm">
                                        <i class="fas fa-phone-alt mr-2 text-yellow-600"></i>
                                        Liên hệ ngay: <strong class="ml-1 text-gray-900">0869 189 018</strong>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            }
        </div>
    </div>

    <script>
        function changeImage(src, element) {
        document.getElementById('mainImage').src = src;
        document.querySelectorAll('.thumbnail').forEach(thumb => {
        thumb.classList.remove('active-thumb');
        });
        element.querySelector('.thumbnail').classWith = '';
        element.querySelector('.thumbnail').classList.add('active-thumb');
        }
    </script>
</body>
</html>