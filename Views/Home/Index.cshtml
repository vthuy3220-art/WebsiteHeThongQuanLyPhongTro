@model List<HeThongQuanLyPhongTro.Models.Phong>
@{
    ViewData["Title"] = "Phòng Trọ Xinh - Tìm phòng trọ giá rẻ";
    Layout = null;
    var danhSachPhongNoiBat = Model;
    var danhSachCoSo = ViewBag.DanhSachCoSo as List<HeThongQuanLyPhongTro.Models.CoSo>;
    var dictAnh = ViewBag.DictAnh as Dictionary<int, string>;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        .hero-bg {
            background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80');
            background-size: cover;
            background-position: center;
        }

        .search-card {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
        }

        .room-card {
            transition: all 0.3s ease;
            border: 1px solid #e5e7eb;
        }

            .room-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1);
                border-color: #3b82f6;
            }

        .price-tag {
            color: #dc2626;
            font-weight: bold;
        }

        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
    </style>
</head>
<body class="bg-gray-100">

    <nav class="bg-white shadow-md sticky top-0 z-50">
        <div class="w-full px-6 md:px-16 py-3">
            <div class="flex justify-between items-center h-10">

                <a href="@Url.Action("Index", "Home")" class="flex items-center space-x-2 text-blue-500 hover:text-blue-700 transition-colors">
                    <i class="fas fa-home text-2xl"></i>
                    <span class="text-xl font-bold text-gray-800">Trang Chủ</span>
                </a>

                <div class="flex space-x-6 font-semibold text-sm items-center">
                    <a href="@Url.Action("Index", "Home")" class="text-gray-600 hover:text-blue-500 transition-colors">Trang Chủ</a>
                    <a href="@Url.Action("Index", "Login")" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-1.5 rounded-xl text-xs font-bold transition shadow-sm flex items-center space-x-1">
                        <i class="fas fa-sign-in-alt"></i>
                        <span>Đăng Nhập</span>
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <section class="hero-bg py-16">
        <div class="container mx-auto px-4">
            <div class="text-center text-white mb-8">
                <h1 class="text-4xl md:text-5xl font-bold mb-4">Tìm Phòng Trọ Ưng Ý Nhất!</h1>
                <p class="text-xl opacity-90">Hàng ngàn phòng trọ chất lượng, giá tốt nhất thị trường</p>
            </div>

            <div class="max-w-4xl mx-auto">
                <div class="search-card p-6 shadow-2xl">
                    <form method="get" class="space-y-4" id="searchForm">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">
                                    <i class="fas fa-map-marker-alt mr-1 text-blue-500"></i> Chọn khu vực
                                </label>
                                <select name="maKhuVuc" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                                    <option value="">-- Tất cả khu vực --</option>
                                    @{
                                        var danhSachKhuVuc = ViewBag.DanhSachKhuVuc as List<HeThongQuanLyPhongTro.Models.CoSo>;
                                        var maKhuVucHienTai = ViewBag.MaKhuVuc as int?;
                                    }
                                    @if (danhSachKhuVuc != null && danhSachKhuVuc.Any())
                                    {
                                        foreach (var coSo in danhSachKhuVuc)
                                        {
                                            if (maKhuVucHienTai == coSo.MaCoSo)
                                            {
                                                <option value="@coSo.MaCoSo" selected>@coSo.TenCoSo</option>
                                            }
                                            else
                                            {
                                                <option value="@coSo.MaCoSo">@coSo.TenCoSo</option>
                                            }
                                        }
                                    }
                                    else
                                    {
                                        <option value="">Hoàn Kiếm</option>
                                        <option value="">Ba Đình</option>
                                        <option value="">Đống Đa</option>
                                        <option value="">Hai Bà Trưng</option>
                                        <option value="">Hoàng Mai</option>
                                        <option value="">Thanh Xuân</option>
                                        <option value="">Cầu Giấy</option>
                                        <option value="">Nam Từ Liêm</option>
                                        <option value="">Bắc Từ Liêm</option>
                                        <option value="">Hà Đông</option>
                                    }
                                </select>
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">
                                    <i class="fas fa-dollar-sign mr-1 text-blue-500"></i> Giá từ (VNĐ)
                                </label>
                                <select name="giaTu" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white text-gray-700 text-sm">
                                    <option value="">-- Không giới hạn --</option>
                                    @{
                                        var giaTu = ViewBag.GiaTu as int?;
                                    }
                                    <option value="1000000" selected="@(giaTu == 1000000)">1.000.000 đ</option>
                                    <option value="2000000" selected="@(giaTu == 2000000)">2.000.000 đ</option>
                                    <option value="3000000" selected="@(giaTu == 3000000)">3.000.000 đ</option>
                                    <option value="4000000" selected="@(giaTu == 4000000)">4.000.000 đ</option>
                                    <option value="5000000" selected="@(giaTu == 5000000)">5.000.000 đ</option>
                                    <option value="7000000" selected="@(giaTu == 7000000)">7.000.000 đ</option>
                                    <option value="9000000" selected="@(giaTu == 9000000)">9.000.000 đ</option>
                                    <option value="12000000" selected="@(giaTu == 12000000)">12.000.000 đ</option>
                                    <option value="15000000" selected="@(giaTu == 15000000)">15.000.000 đ</option>
                                    <option value="20000000" selected="@(giaTu == 20000000)">20.000.000 đ</option>
                                </select>
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">
                                    <i class="fas fa-dollar-sign mr-1 text-blue-500"></i> Giá đến (VNĐ)
                                </label>
                                <select name="giaDen" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white text-gray-700 text-sm">
                                    <option value="">-- Không giới hạn --</option>
                                    <option value="1000000" selected="@(giaTu == 1000000)">1.000.000 đ</option>
                                    <option value="2000000" selected="@(giaTu == 2000000)">2.000.000 đ</option>
                                    <option value="3000000" selected="@(giaTu == 3000000)">3.000.000 đ</option>
                                    <option value="4000000" selected="@(giaTu == 4000000)">4.000.000 đ</option>
                                    <option value="5000000" selected="@(giaTu == 5000000)">5.000.000 đ</option>
                                    <option value="7000000" selected="@(giaTu == 7000000)">7.000.000 đ</option>
                                    <option value="9000000" selected="@(giaTu == 9000000)">9.000.000 đ</option>
                                    <option value="12000000" selected="@(giaTu == 12000000)">12.000.000 đ</option>
                                    <option value="15000000" selected="@(giaTu == 15000000)">15.000.000 đ</option>
                                    <option value="20000000" selected="@(giaTu == 20000000)">20.000.000 đ</option>
                                </select>
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">
                                    <i class="fas fa-search mr-1 text-blue-500"></i> Tìm kiếm
                                </label>
                                <input type="text" name="searchString" value="@ViewBag.SearchString"
                                       placeholder="Tên phòng, tòa nhà, khu vực, tiện ích..."
                                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                            </div>
                        </div>

                        <button type="submit" class="w-full bg-blue-500 hover:bg-blue-600 text-white py-3 rounded-lg transition font-semibold">
                            <i class="fas fa-search mr-2"></i> Tìm kiếm phòng trọ
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <section class="container mx-auto px-4 py-8">
        <div class="bg-gradient-to-r from-blue-500 to-purple-600 rounded-2xl shadow-lg p-8 text-center text-white">
            <h2 class="text-2xl font-bold mb-2">Bạn đang có phòng trọ / căn hộ cho thuê?</h2>
            <p class="mb-4 opacity-90">Đăng tin ngay để tiếp cận hàng ngàn khách thuê tiềm năng</p>

            <a href="@Url.Action("Index", "Login", new { returnUrl = "/BaiDang/Create" })" class="inline-block bg-white text-blue-600 hover:bg-gray-100 px-6 py-3 rounded-xl font-semibold transition">
                <i class="fas fa-plus-circle mr-2"></i> Đăng tin
            </a>
        </div>
    </section>

    <section class="container mx-auto px-4 py-8">
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-2xl font-bold text-gray-800">🏠 Danh sách phòng trọ</h2>
            <span class="text-sm text-gray-500">@(ViewBag.TongSo ?? 0) kết quả</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @if (danhSachPhongNoiBat != null && danhSachPhongNoiBat.Any())
            {
                @foreach (var phong in danhSachPhongNoiBat)
                {
                    <div class="room-card bg-white rounded-xl overflow-hidden">
                        <div class="h-48 bg-gradient-to-r from-blue-400 to-purple-500 flex items-center justify-center">
                            @{
                                var anhPhong = dictAnh != null && dictAnh.ContainsKey(phong.MaPhong) ? dictAnh[phong.MaPhong] : null;
                            }
                            @if (!string.IsNullOrEmpty(anhPhong))
                            {
                                <img src="@anhPhong" class="w-full h-full object-cover" />
                            }
                            else
                            {
                                <i class="fas fa-building text-white text-6xl opacity-50"></i>
                            }
                        </div>
                        <div class="p-4">
                            <h3 class="font-bold text-lg text-gray-800 mb-1">@phong.TenPhong</h3>
                            <p class="text-gray-500 text-sm mb-2">
                                <i class="fas fa-map-marker-alt mr-1 text-red-500"></i>
                                @phong.ToaNha?.CoSo?.TenCoSo (@phong.ToaNha?.DiaChi)
                            </p>
                            <p class="price-tag text-xl mb-2">@phong.GiaPhong.ToString("N0") <span class="text-sm">đ/tháng</span></p>
                            <div class="flex items-center justify-between text-gray-500 text-sm mb-3">
                                <span><i class="fas fa-ruler-combined mr-1"></i> @phong.DienTich m²</span>

                            </div>
                            <a href="@Url.Action("ChiTietPhong", "Home", new { id = phong.MaPhong })"
                               class="block text-center bg-blue-500 hover:bg-blue-600 text-white py-2 rounded-lg transition">
                                Xem chi tiết <i class="fas fa-arrow-right ml-1"></i>
                            </a>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-span-3 text-center py-16">
                    <i class="fas fa-inbox text-gray-300 text-5xl mb-3"></i>
                    <p class="text-gray-500">Không tìm thấy phòng trọ nào</p>
                </div>
            }
        </div>
    </section>

    <footer class="bg-gray-800 text-white py-6 mt-8">
        <div class="container mx-auto px-4 text-center">
            <p>&copy; 2024 Phòng Trọ Xinh - Tìm phòng trọ giá rẻ</p>
            <p class="text-gray-400 text-sm mt-2">Hotline: 0869 189 018 | Email: phongtro@gmail.com</p>
        </div>
    </footer>

</body>
</html>