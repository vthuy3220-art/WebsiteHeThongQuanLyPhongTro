@model HeThongQuanLyPhongTro.Models.YeuCauSuaChua

@{
    ViewData["Title"] = "Chi tiết yêu cầu sửa chữa";
    var isAjax = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest";
    if (isAjax)
    {
        Layout = null;
    }
    else
    {
        Layout = "_Layout";
    }
}

<div class="max-w-3xl mx-auto bg-white rounded-xl shadow-md overflow-hidden">
    <div class="bg-gradient-to-r from-orange-500 to-red-600 px-6 py-4">
        <h2 class="text-xl font-bold text-white flex items-center gap-2">
            <i class="fas fa-tools"></i> Chi tiết yêu cầu sửa chữa
        </h2>
    </div>

    <div class="p-6">
        <!-- Thông tin cơ bản -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
            <div class="p-3 bg-gray-50 rounded-lg">
                <span class="text-gray-500 text-sm">Mã yêu cầu:</span>
                <p class="font-semibold">@Model.MaYeuCau</p>
            </div>
            <div class="p-3 bg-gray-50 rounded-lg">
                <span class="text-gray-500 text-sm">Phòng:</span>
                <p class="font-semibold">@Model.PhongNavigation?.TenPhong</p>
            </div>
            <div class="p-3 bg-gray-50 rounded-lg">
                <span class="text-gray-500 text-sm">Ngày gửi:</span>
                <p class="font-semibold">@Model.NgayTao.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
            <div class="p-3 bg-gray-50 rounded-lg">
                <span class="text-gray-500 text-sm">Trạng thái:</span>
                @if (Model.TrangThai == "Chờ xử lý")
                {
                    <span class="px-2 py-1 bg-yellow-100 text-yellow-700 rounded-full text-xs">Chờ xử lý</span>
                }
                else if (Model.TrangThai == "Đã tiếp nhận")
                {
                    <span class="px-2 py-1 bg-blue-100 text-blue-700 rounded-full text-xs">Đã tiếp nhận</span>
                }
                else
                {
                    <span class="px-2 py-1 bg-green-100 text-green-700 rounded-full text-xs">Đã hoàn thành</span>
                }
            </div>
        </div>

        <!-- Tiêu đề và nội dung -->
        <div class="mb-4">
            <label class="block text-gray-700 font-semibold mb-1">Tiêu đề</label>
            <div class="p-3 bg-gray-50 rounded-lg">@Model.TieuDe</div>
        </div>

        <div class="mb-4">
            <label class="block text-gray-700 font-semibold mb-1">Nội dung</label>
            <div class="p-3 bg-gray-50 rounded-lg whitespace-pre-wrap">@Model.NoiDung</div>
        </div>

        <!-- Hình ảnh -->
        @if (!string.IsNullOrEmpty(Model.HinhAnh))
        {
            <div class="mb-4">
                <label class="block text-gray-700 font-semibold mb-1">Hình ảnh</label>
                <img src="@Model.HinhAnh" class="max-w-full rounded-lg border" style="max-height: 300px;" />
            </div>
        }

        <!-- Phản hồi từ chủ trọ -->
        @if (!string.IsNullOrEmpty(Model.GhiChuXuLy))
        {
            <div class="mb-4">
                <label class="block text-gray-700 font-semibold mb-1">Phản hồi từ chủ trọ</label>
                <div class="p-3 bg-blue-50 rounded-lg text-blue-800">@Model.GhiChuXuLy</div>
                @if (Model.NgayXuLy.HasValue)
                {
                    <p class="text-xs text-gray-500 mt-1">@Model.NgayXuLy.Value.ToString("dd/MM/yyyy HH:mm")</p>
                }
            </div>
        }

        <!-- Chi phí phát sinh -->
        @if (Model.ChiPhiPhatSinh.HasValue && Model.ChiPhiPhatSinh.Value > 0)
        {
            <div class="mb-4 bg-yellow-50 p-3 rounded-lg">
                <label class="block text-yellow-800 font-semibold mb-1">💰 Chi phí phát sinh</label>
                <p class="text-yellow-800 text-lg font-bold">@String.Format("{0:N0} ", Model.ChiPhiPhatSinh.Value) đ</p>
                <p class="text-xs text-yellow-600">Số tiền này sẽ được cộng vào hóa đơn tháng hiện tại</p>
            </div>
        }

        <!-- Nút quay lại -->
        <div class="flex gap-3 mt-6">
            <a asp-action="YeuCauCuaToi" class="flex-1 bg-gray-500 hover:bg-gray-600 text-white text-center py-2 rounded-lg transition-all">
                <i class="fas fa-arrow-left mr-2"></i> Quay lại
            </a>
            @if (Model.TrangThai != "Đã hoàn thành")
            {
                <a asp-action="TaoYeuCau" class="flex-1 bg-orange-500 hover:bg-orange-600 text-white text-center py-2 rounded-lg transition-all">
                    <i class="fas fa-plus mr-2"></i> Tạo yêu cầu mới
                </a>
            }
        </div>
    </div>
</div>