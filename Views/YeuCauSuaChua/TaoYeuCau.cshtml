@{
    ViewData["Title"] = "Gửi yêu cầu sửa chữa";
}

<div class="max-w-2xl mx-auto">
    <div class="bg-white rounded-xl shadow-md overflow-hidden">
        <div class="bg-gradient-to-r from-orange-500 to-orange-600 px-6 py-4">
            <h1 class="text-xl font-bold text-white">🔧 Gửi yêu cầu sửa chữa</h1>
            <p class="text-orange-100">Vui lòng mô tả chi tiết vấn đề cần sửa</p>
        </div>

        <form method="post" enctype="multipart/form-data" class="p-6 space-y-4">
            @Html.AntiForgeryToken()

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Tiêu đề <span class="text-red-500">*</span></label>
                <input type="text" name="tieuDe" class="w-full px-3 py-2 border rounded-lg" placeholder="VD: Hỏng điều hòa, Thay bóng đèn..." required />
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Mô tả chi tiết <span class="text-red-500">*</span></label>
                <textarea name="noiDung" rows="5" class="w-full px-3 py-2 border rounded-lg" placeholder="Mô tả cụ thể vấn đề..." required></textarea>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Hình ảnh (nếu có)</label>
                <input type="file" name="fileAnh" accept="image/*" class="w-full px-3 py-2 border rounded-lg" />
            </div>

            <div class="bg-yellow-50 rounded-lg p-4">
                <p class="text-sm text-yellow-700">
                    <i class="fas fa-info-circle mr-2"></i>
                    Sau khi gửi yêu cầu, chủ trọ sẽ xử lý và thông báo lại cho bạn.
                </p>
            </div>

            <div class="flex justify-end space-x-3 pt-4">
                <a asp-action="Dashboard" asp-controller="KhachHang" class="px-4 py-2 border rounded-lg">Hủy</a>
                <button type="submit" class="px-4 py-2 bg-orange-500 text-white rounded-lg hover:bg-orange-600">
                    <i class="fas fa-paper-plane mr-2"></i> Gửi yêu cầu
                </button>
            </div>
        </form>
    </div>
</div>