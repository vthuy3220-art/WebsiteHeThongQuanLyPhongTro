@model HeThongQuanLyPhongTro.Models.HoaDon

@{
    ViewData["Title"] = "Chi tiết hóa đơn";
    var hopDong = ViewBag.HopDong as HeThongQuanLyPhongTro.Models.HopDong;
    var phong = hopDong?.PhongNavigation;
    var soNguoi = ViewBag.SoNguoi ?? 1;
    var chiTietHoaDons = ViewBag.ChiTietHoaDons as List<HeThongQuanLyPhongTro.Models.ChiTietHoaDon>;

    var chiSoDienCu = ViewBag.ChiSoDienCu ?? 0;
    var chiSoDienMoi = ViewBag.ChiSoDienMoi ?? 0;
    var chiSoNuocCu = ViewBag.ChiSoNuocCu ?? 0;
    var chiSoNuocMoi = ViewBag.ChiSoNuocMoi ?? 0;
    var giaDien = ViewBag.GiaDien ?? 3500;
    var giaNuoc = ViewBag.GiaNuoc ?? 15000;
    var tienPhatSinh = ViewBag.TienPhatSinh ?? 0;

    var soDien = Math.Max(0, chiSoDienMoi - chiSoDienCu);
    var soNuoc = Math.Max(0, chiSoNuocMoi - chiSoNuocCu);
    var tienDien = soDien * giaDien;
    var tienNuoc = soNuoc * giaNuoc;
    var tienDichVu = soNguoi * 200000;
}

<div style="max-width: 900px; margin: 0 auto;">

    <!-- THÔNG BÁO -->
    @if (TempData["Success"] != null)
    {
        <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-3 mb-3 rounded">
            <i class="fas fa-check-circle mr-2"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="bg-yellow-100 border-l-4 border-yellow-500 text-yellow-700 p-3 mb-3 rounded">
            <i class="fas fa-exclamation-triangle mr-2"></i> @TempData["Warning"]
        </div>
    }
    @if (TempData["EmailSent"] != null)
    {
        <div class="bg-blue-100 border-l-4 border-blue-500 text-blue-700 p-3 mb-3 rounded">
            <i class="fas fa-envelope mr-2"></i> @TempData["EmailSent"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-3 mb-3 rounded">
            <i class="fas fa-exclamation-circle mr-2"></i> @TempData["Error"]
        </div>
    }

    @if (Model.TrangThai == "Đã thanh toán")
    {
        <div style="background: #d4edda; padding: 10px; margin-bottom: 20px; text-align: center; border-radius: 5px;">
            ✅ Hóa đơn này đã được thanh toán.
        </div>
    }

    <!-- FORM CẬP NHẬT CHỈ SỐ (CHỦ TRỌ) -->
    @if (Context.Session.GetString("Role") == "Admin" && Model.TrangThai == "Chưa thanh toán")
    {
        <div style="background: #f8f9fa; padding: 15px; margin-bottom: 20px; border-radius: 8px; border: 1px solid #ddd;">
            <h4 style="margin: 0 0 10px 0;">⚡ Cập nhật chỉ số điện nước</h4>
            <form asp-action="CapNhatChiTietHoaDon" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="maHoaDon" value="@Model.MaHoaDon" />
                <input type="hidden" name="soNguoi" value="@soNguoi" />
                <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-bottom: 10px;">
                    <div style="background: #e9ecef; padding: 8px; border-radius: 4px;">
                        <label>Điện cũ (kWh)</label>
                        <input type="text" class="w-full p-2 bg-gray-100 border rounded" value="@chiSoDienCu" readonly disabled />
                    </div>
                    <div>
                        <label>Điện mới (kWh)</label>
                        <input type="number" name="chiSoDienMoi" id="chiSoDienMoi" class="w-full p-2 border rounded" value="@chiSoDienMoi" />
                    </div>
                    <div style="background: #e9ecef; padding: 8px; border-radius: 4px;">
                        <label>Nước cũ (m³)</label>
                        <input type="text" class="w-full p-2 bg-gray-100 border rounded" value="@chiSoNuocCu" readonly disabled />
                    </div>
                    <div>
                        <label>Nước mới (m³)</label>
                        <input type="number" name="chiSoNuocMoi" id="chiSoNuocMoi" class="w-full p-2 border rounded" value="@chiSoNuocMoi" />
                    </div>
                    <div>
                        <label>Đơn giá điện (đ/kWh)</label>
                        <input type="number" name="giaDien" id="giaDien" class="w-full p-2 border rounded" value="@giaDien" />
                    </div>
                    <div>
                        <label>Đơn giá nước (đ/m³)</label>
                        <input type="number" name="giaNuoc" id="giaNuoc" class="w-full p-2 border rounded" value="@giaNuoc" />
                    </div>
                    <div>
                        <label>Phí phát sinh (VNĐ)</label>
                        <input type="number" name="tienPhatSinh" id="tienPhatSinh" class="w-full p-2 border rounded" value="@tienPhatSinh" />
                    </div>
                </div>
                <button type="submit" class="bg-blue-500 text-white px-4 py-2 rounded">Cập nhật</button>
            </form>
        </div>
    }

    <!-- QR CODE CHO KHÁCH -->
    @if (Context.Session.GetString("Role") == "Khach" && Model.TrangThai == "Chưa thanh toán")
    {
        <div class="bg-white rounded-lg shadow p-4 text-center mb-4">
            <h3 class="font-bold text-lg mb-3">📱 Quét mã QR để thanh toán</h3>
            <img src="/images/qr_code.jpg" class="mx-auto w-48 h-48" />
            <div class="mt-4 text-left bg-gray-50 p-3 rounded-lg">
                <p><strong>Ngân hàng:</strong> Techcombank</p>
                <p><strong>Số tài khoản:</strong> 19072789933016</p>
                <p><strong>Chủ tài khoản:</strong> Vũ Thị Thanh Thúy</p>
                <p><strong>Nội dung:</strong> TT_HD@Model.MaHoaDon_@Model.Thang@Model.Nam</p>
                <p><strong>Số tiền:</strong> <span class="font-bold text-red-600">@(Model.TongTien?.ToString("N0") ?? "0") đ</span></p>
            </div>
        </div>
    }

    <!-- NÚT KHÁCH XÁC NHẬN -->
    @if (Context.Session.GetString("Role") == "Khach" && Model.TrangThai == "Chưa thanh toán" && Model.KhachXacNhan != true)
    {
        <div class="bg-yellow-50 rounded-lg p-4 mb-4">
            <p class="text-yellow-800 mb-2">⚠️ Sau khi chuyển khoản thành công, bấm nút bên dưới để xác nhận!</p>
            <form method="post" asp-action="KhachXacNhan" asp-controller="HoaDon">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.MaHoaDon" />
                <button type="submit" class="bg-blue-500 text-white px-4 py-2 rounded-lg w-full">
                    <i class="fas fa-check-circle mr-2"></i> Tôi đã chuyển khoản
                </button>
            </form>
        </div>
    }

    <!-- NÚT CHỦ TRỌ XÁC NHẬN -->
    @if (Context.Session.GetString("Role") == "Admin" && Model.KhachXacNhan == true && Model.TrangThai == "Chưa thanh toán")
    {
        <div class="bg-green-50 rounded-lg p-4 mb-4">
            <p class="text-green-800 mb-2">✅ Khách đã xác nhận chuyển khoản. Vui lòng kiểm tra tài khoản!</p>
            <form method="post" asp-action="ChuXacNhan" asp-controller="HoaDon">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.MaHoaDon" />
                <button type="submit" class="bg-green-500 text-white px-4 py-2 rounded-lg w-full">
                    <i class="fas fa-money-bill-wave mr-2"></i> Xác nhận đã nhận tiền
                </button>
            </form>
        </div>
    }

    @if (Model.TrangThai == "Đã thanh toán")
    {
        <div class="bg-green-100 rounded-lg p-4 text-center mb-4">
            <i class="fas fa-check-circle text-green-500 text-2xl mb-2"></i>
            <p class="text-green-700 font-semibold">✅ Hóa đơn đã được thanh toán</p>
        </div>
    }

    <!-- HÓA ĐƠN -->
    <div id="hoaDon" style="background: white; border: 1px solid #ddd; padding: 20px;">
        <div style="text-align: center; margin-bottom: 20px;">
            <h1 style="margin: 0; font-size: 22px;">PHÒNG TRỌ XINH</h1>
            <p style="margin: 5px 0; font-size: 12px;">Quản lý phòng trọ</p>
            <hr />
            <h2 style="margin: 10px 0;">HÓA ĐƠN TIỀN PHÒNG</h2>
            <p><strong>Mã hóa đơn: @Model.MaHoaDon.ToString("00000")</strong></p>
        </div>

        <div style="margin-bottom: 20px;">
            <table style="width: 100%;">
                <tr><td style="width: 120px;"><strong>Phòng:</strong></td><td>@phong?.TenPhong</td></tr>
                <tr><td><strong>Khách hàng:</strong></td><td>@hopDong?.KhachHangNavigation?.HoTen</td></tr>
                <tr><td><strong>Email:</strong></td><td>@hopDong?.KhachHangNavigation?.Email</td></tr>
                <tr><td><strong>Số điện thoại:</strong></td><td>@hopDong?.KhachHangNavigation?.SoDienThoai</td></tr>
                <tr><td><strong>Ngày lập:</strong></td><td>@(Model.NgayTao?.ToString("dd/MM/yyyy") ?? DateTime.Now.ToString("dd/MM/yyyy"))</td></tr>
                <tr><td><strong>Hạn thanh toán:</strong></td><td style="color: red;">@(Model.NgayTao?.AddDays(7).ToString("dd/MM/yyyy") ?? DateTime.Now.AddDays(7).ToString("dd/MM/yyyy"))</td></tr>
            </table>
        </div>

        <table style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr><th style="padding: 8px; text-align: left;">Tiêu đề</th><th style="padding: 8px; text-align: left;">Mô tả</th><th style="padding: 8px; text-align: right;">Giá</th><th style="padding: 8px; text-align: right;">Tổng</th></tr>
            </thead>
            <tbody>
                <tr style="border-bottom: 1px solid #eee;"><td style="padding: 8px;">Tiền phòng</td><td>@phong?.TenPhong - tháng @Model.Thang/@Model.Nam</td><td style="text-align: right;">@(phong?.GiaPhong.ToString("N0") ?? "0") đ</td><td style="text-align: right;">@(phong?.GiaPhong.ToString("N0") ?? "0") đ</td></tr>
                <tr style="border-bottom: 1px solid #eee;"><td style="padding: 8px;">Tiền điện</td><td>Số điện: @soDien kWh × @giaDien.ToString("N0") đ</td><td style="text-align: right;">@tienDien.ToString("N0") đ</td><td style="text-align: right;">@tienDien.ToString("N0") đ</td></tr>
                <tr style="border-bottom: 1px solid #eee;"><td style="padding: 8px;">Tiền nước</td><td>Số nước: @soNuoc m³ × @giaNuoc.ToString("N0") đ</td><td style="text-align: right;">@tienNuoc.ToString("N0") đ</td><td style="text-align: right;">@tienNuoc.ToString("N0") đ</td></tr>
                <tr style="border-bottom: 1px solid #eee;"><td style="padding: 8px;">Phí dịch vụ</td><td>@soNguoi người × 200.000đ</td><td style="text-align: right;">@tienDichVu.ToString("N0") đ</td><td style="text-align: right;">@tienDichVu.ToString("N0") đ</td></tr>
                @if (tienPhatSinh > 0)
                {
                    <tr style="border-bottom: 1px solid #eee;"><td style="padding: 8px;">Phí phát sinh</td><td>Sửa chữa/phát sinh</td><td style="text-align: right;">@tienPhatSinh.ToString("N0") đ</td><td style="text-align: right;">@tienPhatSinh.ToString("N0") đ</td></tr>
                }
            </tbody>
            <tfoot>
                <tr style="border-top: 2px solid #ddd;"><td colspan="3" style="padding: 8px; text-align: right; font-weight: bold;">Tổng cộng:</td><td style="padding: 8px; text-align: right; font-weight: bold; font-size: 16px;" id="tongCongTd">@(Model.TongTien?.ToString("N0") ?? "0") đ</td></tr>
            </tfoot>
        </table>

        <div style="margin-top: 20px; padding-top: 10px; border-top: 1px solid #ddd; text-align: center;">
            <p>Cảm ơn bạn đã hợp tác kinh doanh với chúng tôi!</p>
            <p><strong>Phòng Trọ Xinh</strong> - Nơi an cư, nghiệp vững</p>
        </div>
    </div>

    <div style="text-align: center; margin-top: 20px;">
        <a href="@Url.Action("XuatPdf", "HoaDon", new { id = Model.MaHoaDon })" target="_blank" class="bg-red-500 text-white px-4 py-2 rounded inline-block">Xuất PDF</a>
    </div>
</div>

<script>
    function tinhTien() {
        let dienMoi = parseFloat(document.getElementById('chiSoDienMoi')?.value) || 0;
        let nuocMoi = parseFloat(document.getElementById('chiSoNuocMoi')?.value) || 0;
        let gDien = parseFloat(document.getElementById('giaDien')?.value) || 0;
        let gNuoc = parseFloat(document.getElementById('giaNuoc')?.value) || 0;
        let phatSinh = parseFloat(document.getElementById('tienPhatSinh')?.value) || 0;

        let dienCu = @chiSoDienCu;
        let nuocCu = @chiSoNuocCu;

        let soDien = Math.max(0, dienMoi - dienCu);
        let soNuoc = Math.max(0, nuocMoi - nuocCu);
        let tienDien = soDien * gDien;
        let tienNuoc = soNuoc * gNuoc;
        let tienDichVu = @soNguoi * 200000;
        let tong = @(phong?.GiaPhong ?? 0) + tienDien + tienNuoc + tienDichVu + phatSinh;

        let tongTd = document.getElementById('tongCongTd');
        if (tongTd) tongTd.innerText = tong.toLocaleString('vi-VN') + ' đ';
    }

    var inputs = ['chiSoDienMoi', 'chiSoNuocMoi', 'giaDien', 'giaNuoc', 'tienPhatSinh'];
    inputs.forEach(function(id) {
        var el = document.getElementById(id);
        if (el) el.addEventListener('input', tinhTien);
    });
</script>