@model HeThongQuanLyPhongTro.Models.CoSoVatChat

@{
    ViewData["Title"] = "Thêm thiết bị";
}

<div class="max-w-2xl mx-auto">
    <div class="bg-white rounded-xl shadow-md overflow-hidden">
        <div class="bg-gradient-to-r from-blue-500 to-blue-600 px-6 py-4">
            <h1 class="text-xl font-bold text-white">Thêm thiết bị mới</h1>
            <p class="text-blue-100 text-sm">Nhập thông tin thiết bị cơ sở vật chất</p>
        </div>

        <form asp-action="Create" class="p-6 space-y-4">
            <div asp-validation-summary="ModelOnly" class="text-red-500"></div>

            <div>
                <label asp-for="MaPhong" class="block text-sm font-medium">Phòng <span class="text-red-500">*</span></label>
                <select asp-for="MaPhong" class="w-full border rounded-lg p-2" asp-items="ViewBag.MaPhong">
                    <option value="">-- Chọn phòng --</option>
                </select>
                <span asp-validation-for="MaPhong" class="text-red-500 text-sm"></span>
            </div>

            <div>
                <label asp-for="TenThietBi" class="block text-sm font-medium">Tên thiết bị <span class="text-red-500">*</span></label>
                <input asp-for="TenThietBi" class="w-full border rounded-lg p-2" placeholder="VD: Máy lạnh, Tủ lạnh, Quạt..." />
                <span asp-validation-for="TenThietBi" class="text-red-500 text-sm"></span>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label asp-for="SoLuong" class="block text-sm font-medium">Số lượng</label>
                    <input asp-for="SoLuong" type="number" class="w-full border rounded-lg p-2" value="1" />
                    <span asp-validation-for="SoLuong" class="text-red-500 text-sm"></span>
                </div>
                <div>
                    <label asp-for="TinhTrang" class="block text-sm font-medium">Tình trạng</label>
                    <select asp-for="TinhTrang" class="w-full border rounded-lg p-2">
                        <option value="Tốt">Tốt</option>
                        <option value="Trung bình">Trung bình</option>
                        <option value="Hư">Hư</option>
                        <option value="Cần bảo trì">Cần bảo trì</option>
                    </select>
                    <span asp-validation-for="TinhTrang" class="text-red-500 text-sm"></span>
                </div>
            </div>

            <div class="flex justify-end space-x-3 pt-4">
                <a asp-action="Index" class="px-4 py-2 border rounded-lg">Hủy</a>
                <button type="submit" class="px-4 py-2 bg-blue-500 text-white rounded-lg">Lưu</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}