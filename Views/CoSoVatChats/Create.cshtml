@model HeThongQuanLyPhongTro.Models.CoSoVatChat

@{
    ViewData["Title"] = "Thêm cơ sở vật chất";
    Layout = "_Layout";
    var phongList = ViewBag.PhongList as List<HeThongQuanLyPhongTro.Models.Phong>;
}

<div class="container mx-auto px-4 py-8">
    <div class="max-w-2xl mx-auto bg-white rounded-xl shadow-md overflow-hidden">
        <div class="bg-gradient-to-r from-blue-600 to-indigo-700 px-6 py-4">
            <h2 class="text-xl font-bold text-white flex items-center gap-2">
                <i class="fas fa-microchip"></i> Thêm cơ sở vật chất
            </h2>
        </div>

        <div class="p-6">
            <form asp-action="Create" method="post">
                <div class="mb-4">
                    <label class="block text-gray-700 font-medium mb-2">Chọn phòng *</label>
                    <select name="MaPhong" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" required>
                        <option value="">-- Chọn phòng --</option>
                        @if (phongList != null)
                        {
                            foreach (var phong in phongList)
                            {
                                <option value="@phong.MaPhong">@phong.TenPhong - @phong.GiaPhong.ToString("N0") đ/tháng</option>
                            }
                        }
                    </select>
                </div>

                <div class="mb-4">
                    <label class="block text-gray-700 font-medium mb-2">Tên thiết bị *</label>
                    <input type="text" name="TenThietBi" class="w-full px-4 py-2 border rounded-lg" required />
                </div>

                <div class="mb-4">
                    <label class="block text-gray-700 font-medium mb-2">Số lượng</label>
                    <input type="number" name="SoLuong" value="1" class="w-full px-4 py-2 border rounded-lg" />
                </div>

                <div class="mb-4">
                    <label class="block text-gray-700 font-medium mb-2">Tình trạng</label>
                    <select name="TinhTrang" class="w-full px-4 py-2 border rounded-lg">
                        <option value="Tốt">Tốt</option>
                        <option value="Mới">Mới</option>
                        <option value="Cũ">Cũ</option>
                        <option value="Hỏng">Hỏng</option>
                        <option value="Cần bảo trì">Cần bảo trì</option>
                    </select>
                </div>

                <div class="flex gap-3">
                    <button type="submit" class="flex-1 bg-green-500 hover:bg-green-600 text-white py-2 rounded-lg transition-all">
                        <i class="fas fa-save mr-2"></i> Thêm
                    </button>
                    <a asp-action="Index" class="flex-1 bg-gray-300 hover:bg-gray-400 text-gray-700 text-center py-2 rounded-lg transition-all">
                        <i class="fas fa-arrow-left mr-2"></i> Hủy
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>