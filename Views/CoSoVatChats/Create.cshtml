@model HeThongQuanLyPhongTro.Models.CoSoVatChat

@{
    ViewData["Title"] = "Thêm cơ sở vật chất";
    Layout = "_Layout";
    var phongList = ViewBag.PhongList as List<HeThongQuanLyPhongTro.Models.Phong>;
    var role = Context.Session.GetString("Role");
}

<div class="container mx-auto px-4 py-8">
    <div class="max-w-2xl mx-auto bg-white rounded-xl shadow-md overflow-hidden">
        <div class="bg-gradient-to-r from-blue-600 to-indigo-700 px-6 py-4">
            <h2 class="text-xl font-bold text-white flex items-center gap-2">
                <i class="fas fa-microchip"></i> Thêm cơ sở vật chất
            </h2>
            <p class="text-blue-100 text-sm mt-1">Nhập thông tin thiết bị cho phòng</p>
        </div>

        <div class="p-6">
            @if (TempData["Error"] != null)
            {
                <div class="mb-4 p-3 bg-red-100 border-l-4 border-red-500 text-red-700 rounded">
                    <i class="fas fa-exclamation-circle mr-2"></i> @TempData["Error"]
                </div>
            }

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-4">
                    <label class="block text-gray-700 font-medium mb-2">Chọn phòng <span class="text-red-500">*</span></label>
                    <select name="MaPhong" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" required>
                        <option value="">-- Chọn phòng --</option>
                        @if (phongList != null)
                        {
                            foreach (var phong in phongList)
                            {
                                <option value="@phong.MaPhong">@phong.TenPhong - @phong.GiaPhong.ToString("N0") đ/tháng</option>
                            }
                        }
                    </select>
                    <p class="text-xs text-gray-400 mt-1">Chỉ hiển thị phòng thuộc quyền quản lý của bạn</p>
                </div>

                <div class="mb-4">
                    <label class="block text-gray-700 font-medium mb-2">Tên thiết bị <span class="text-red-500">*</span></label>
                    <input type="text" name="TenThietBi" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="VD: Máy lạnh, Tủ lạnh, Quạt, Bình nóng lạnh..." required />
                </div>

                <div class="grid grid-cols-2 gap-4 mb-4">
                    <div>
                        <label class="block text-gray-700 font-medium mb-2">Số lượng</label>
                        <input type="number" name="SoLuong" value="1" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                    </div>
                    <div>
                        <label class="block text-gray-700 font-medium mb-2">Tình trạng</label>
                        <select name="TinhTrang" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                            <option value="Tốt">✅ Tốt</option>
                            <option value="Mới">🆕 Mới</option>
                            <option value="Trung bình">⚠️ Trung bình</option>
                            <option value="Cũ">📦 Cũ</option>
                            <option value="Cần bảo trì">🔧 Cần bảo trì</option>
                            <option value="Hỏng">❌ Hỏng</option>
                        </select>
                    </div>
                </div>

                <div class="bg-blue-50 p-3 rounded-lg mb-4">
                    <div class="flex items-start">
                        <i class="fas fa-info-circle text-blue-500 mt-0.5 mr-2"></i>
                        <div class="text-xs text-blue-700">
                            <p class="font-semibold">Lưu ý:</p>
                            <ul class="list-disc list-inside">
                                <li>Thiết bị sẽ được gắn với phòng đã chọn</li>
                                <li>Có thể thêm nhiều thiết bị cho cùng một phòng</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="flex gap-3">
                    <button type="submit" class="flex-1 bg-green-500 hover:bg-green-600 text-white py-2 rounded-lg transition-all">
                        <i class="fas fa-save mr-2"></i> Thêm thiết bị
                    </button>
                    <a asp-action="Index" class="flex-1 bg-gray-300 hover:bg-gray-400 text-gray-700 text-center py-2 rounded-lg transition-all">
                        <i class="fas fa-arrow-left mr-2"></i> Hủy
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}