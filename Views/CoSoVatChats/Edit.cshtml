@model HeThongQuanLyPhongTro.Models.CoSoVatChat

@{
    ViewData["Title"] = "Sửa cơ sở vật chất";
    Layout = "_Layout";
    var phongList = ViewBag.PhongList as List<HeThongQuanLyPhongTro.Models.Phong>;
}

<div class="container mx-auto px-4 py-8">
    <div class="max-w-2xl mx-auto bg-white rounded-xl shadow-md overflow-hidden">
        <div class="bg-gradient-to-r from-yellow-500 to-orange-600 px-6 py-4">
            <h2 class="text-xl font-bold text-white">✏️ Sửa cơ sở vật chất</h2>
        </div>

        <div class="p-6">
            <form method="post">
                <input type="hidden" name="id" value="@Model.MaCSVC" />

                <div class="mb-4">
                    <label class="block text-gray-700 font-medium mb-2">Chọn phòng</label>
                    <select name="MaPhong" class="w-full px-4 py-2 border rounded-lg" required>
                        <option value="">-- Chọn phòng --</option>
                        @if (phongList != null)
                        {
                            foreach (var phong in phongList)
                            {
                                <option value="@phong.MaPhong" selected="@(Model.MaPhong == phong.MaPhong)">
                                    @phong.TenPhong
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="mb-4">
                    <label class="block text-gray-700 font-medium mb-2">Tên thiết bị</label>
                    <input type="text" name="TenThietBi" value="@Model.TenThietBi" class="w-full px-4 py-2 border rounded-lg" required />
                </div>

                <div class="mb-4">
                    <label class="block text-gray-700 font-medium mb-2">Số lượng</label>
                    <input type="number" name="SoLuong" value="@Model.SoLuong" class="w-full px-4 py-2 border rounded-lg" />
                </div>

                <div class="mb-4">
                    <label class="block text-gray-700 font-medium mb-2">Tình trạng</label>
                    <select name="TinhTrang" class="w-full px-4 py-2 border rounded-lg">
                        <option value="Tốt" selected="@(Model.TinhTrang == "Tốt")">Tốt</option>
                        <option value="Mới" selected="@(Model.TinhTrang == "Mới")">Mới</option>
                        <option value="Cũ" selected="@(Model.TinhTrang == "Cũ")">Cũ</option>
                        <option value="Hỏng" selected="@(Model.TinhTrang == "Hỏng")">Hỏng</option>
                    </select>
                </div>

                <div class="flex gap-3">
                    <button type="submit" class="flex-1 bg-green-500 hover:bg-green-600 text-white py-2 rounded-lg">
                        <i class="fas fa-save mr-2"></i> Lưu
                    </button>
                    <a asp-action="Index" class="flex-1 bg-gray-300 hover:bg-gray-400 text-gray-700 text-center py-2 rounded-lg">
                        <i class="fas fa-arrow-left mr-2"></i> Hủy
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>