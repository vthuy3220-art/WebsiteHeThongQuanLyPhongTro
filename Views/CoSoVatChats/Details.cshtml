@model HeThongQuanLyPhongTro.Models.CoSoVatChat

@{
    ViewData["Title"] = "Chi tiết cơ sở vật chất";
    Layout = "_Layout";
}

<div class="container mx-auto px-4 py-8">
    <div class="max-w-2xl mx-auto bg-white rounded-xl shadow-md overflow-hidden">
        <div class="bg-gradient-to-r from-blue-600 to-indigo-700 px-6 py-4">
            <h2 class="text-xl font-bold text-white">📋 Chi tiết cơ sở vật chất</h2>
        </div>

        <div class="p-6">
            <div class="grid grid-cols-1 gap-4">
                <div class="flex justify-between p-3 bg-gray-50 rounded-lg">
                    <span class="font-semibold">Mã CSVC:</span>
                    <span>@Model.MaCSVC</span>
                </div>
                <div class="flex justify-between p-3 bg-gray-50 rounded-lg">
                    <span class="font-semibold">Phòng:</span>
                    <span>@Model.PhongNavigation?.TenPhong</span>
                </div>
                <div class="flex justify-between p-3 bg-gray-50 rounded-lg">
                    <span class="font-semibold">Tên thiết bị:</span>
                    <span>@Model.TenThietBi</span>
                </div>
                <div class="flex justify-between p-3 bg-gray-50 rounded-lg">
                    <span class="font-semibold">Số lượng:</span>
                    <span>@Model.SoLuong</span>
                </div>
                <div class="flex justify-between p-3 bg-gray-50 rounded-lg">
                    <span class="font-semibold">Tình trạng:</span>
                    <span class="px-2 py-1 rounded-full text-xs @(Model.TinhTrang == "Tốt" ? "bg-green-100 text-green-700" : "bg-yellow-100 text-yellow-700")">
                        @Model.TinhTrang
                    </span>
                </div>
            </div>

            <div class="flex gap-3 mt-6">
                <a asp-action="Edit" asp-route-id="@Model.MaCSVC" class="flex-1 bg-yellow-500 hover:bg-yellow-600 text-white text-center py-2 rounded-lg">
                    <i class="fas fa-edit mr-2"></i> Sửa
                </a>
                <a asp-action="Index" class="flex-1 bg-gray-500 hover:bg-gray-600 text-white text-center py-2 rounded-lg">
                    <i class="fas fa-arrow-left mr-2"></i> Quay lại
                </a>
            </div>
        </div>
    </div>
</div>