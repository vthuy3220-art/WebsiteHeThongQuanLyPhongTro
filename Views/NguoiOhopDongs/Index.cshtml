@model IEnumerable<HeThongQuanLyPhongTro.Models.NguoiOHopDong>

@{
    ViewData["Title"] = "Quản lý người ở";
}

<div class="space-y-6">
 

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-100 text-green-700 p-3 rounded">@TempData["Success"]</div>
    }

    <div class="bg-white rounded-xl shadow overflow-hidden">
        <table class="w-full">
            <thead class="bg-gray-50">
                <tr>
                    <th class="p-3">Mã</th>
                    <th class="p-3">Hợp đồng</th>
                    <th class="p-3">Họ tên</th>
                    <th class="p-3">CCCD</th>
                    <th class="p-3">SĐT</th>
                    <th class="p-3">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="border-b">
                        <td class="p-3">@item.MaNguoiO</td>
                        <td class="p-3">@item.HopDongNavigation?.MaHopDong</td>
                        <td class="p-3">@item.HoTen</td>
                        <td class="p-3">@item.CCCD</td>
                        <td class="p-3">@item.SoDienThoai</td>
                        <td class="p-3">
                            <a asp-action="Details" asp-route-id="@item.MaNguoiO" class="text-blue-500"><i class="fas fa-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@item.MaNguoiO" class="text-yellow-500 mx-2"><i class="fas fa-edit"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.MaNguoiO" class="text-red-500"><i class="fas fa-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>