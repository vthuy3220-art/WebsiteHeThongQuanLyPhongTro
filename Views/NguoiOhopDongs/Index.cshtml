@model IEnumerable<HeThongQuanLyPhongTro.Models.NguoiOHopDong>

@{
    ViewData["Title"] = "Quản lý người ở";
}
<div class="space-y-6">
    <div class="flex justify-between items-center">
        <a asp-controller="NguoiOhopDongs" asp-action="Create" class="bg-blue-500 text-white px-4 py-2 rounded-lg">+ Thêm người ở</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-100 text-green-700 p-3 rounded">@TempData["Success"]</div>
    }

    <div class="bg-white rounded-xl shadow overflow-hidden">
        <table class="w-full">
            <thead class="bg-gray-50">
                <tr>
                    <th class="p-3 text-left">Mã</th>
                    <th class="p-3 text-left">Hợp đồng</th>
                    <th class="p-3 text-left">Họ tên</th>
                    <th class="p-3 text-left">CCCD</th>
                    <th class="p-3 text-left">SĐT</th>
                    <th class="p-3 text-left">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="border-b">
                        <td class="p-3">@item.MaNguoiO</td>

                        <!-- SỬA LẠI CỘT NÀY ĐỂ HIỂN THỊ TÊN PHÒNG VÀ NGƯỜI ĐẠI DIỆN -->
                        <td class="p-3">
                            @if (item.HopDongNavigation?.PhongNavigation != null)
                            {
                                <div class="font-semibold text-blue-600">
                                    @item.HopDongNavigation.PhongNavigation.TenPhong
                                </div>
                                <div class="text-xs text-gray-500 mt-0.5">
                                Đại diện: @(item.HopDongNavigation.KhachHangNavigation?.HoTen ?? "Chưa rõ")
                                </div>
                                <div class="text-[11px] text-gray-400 font-mono">
                                    (HĐ #@item.MaHopDong)
                                </div>
                            }
                            else
                            {
                                <span class="text-gray-400 italic">Không xác định</span>
                            }
                        </td>

                        <td class="p-3 font-medium">@item.HoTen</td>
                        <td class="p-3 font-mono text-sm">@item.CCCD</td>
                        <td class="p-3 text-sm">@item.SoDienThoai</td>
                        <td class="p-3">
                            <a asp-controller="NguoiOhopDongs" asp-action="Details" asp-route-id="@item.MaNguoiO" class="text-blue-500"><i class="fas fa-eye"></i></a>
                            <a asp-controller="NguoiOhopDongs" asp-action="Edit" asp-route-id="@item.MaNguoiO" class="text-yellow-500 mx-2"><i class="fas fa-edit"></i></a>
                            <a asp-controller="NguoiOhopDongs" asp-action="Delete" asp-route-id="@item.MaNguoiO" class="text-red-500"><i class="fas fa-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>