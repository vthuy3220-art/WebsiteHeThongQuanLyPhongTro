@model HeThongQuanLyPhongTro.Models.DashboardViewModel

@{
    ViewData["Title"] = "Thống kê";
    Layout = "_Layout";

}
<style>
    /* NHỚ DÙNG @@media THAY VÌ @@media NHÉ */
    @@media print {
        /* 1. Tàng hình toàn bộ thanh Menu trái, Header trên cùng và các nút bấm */
        aside, nav, header, footer, .sidebar, .main-header, button

    {
        display: none !important;
    }

    /* 2. Ép phần nội dung chính tràn viền 100% khổ giấy A4, xóa margin */
    body, main, .content-wrapper, .main-content {
        margin: 0 !important;
        padding: 0 !important;
        width: 100% !important;
        background-color: white !important;
    }

    /* 3. Lớp class đặc biệt để ẩn cục chứa tiêu đề và nút "In báo cáo" */
    .hide-on-print {
        display: none !important;
    }

    /* 4. Xóa đổ bóng (shadow) của các thẻ div để bản in không bị lem nhem */
    * {
        box-shadow: none !important;
        -webkit-box-shadow: none !important;
    }

    /* 5. Ép biểu đồ in ra màu nét nhất */
    canvas {
        max-width: 100% !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
    }

    }
</style>

<div class="space-y-6">
    <!-- Header -->
    <div class="flex justify-between items-center bg-white p-5 rounded-xl shadow-sm border border-gray-50 hide-on-print">
        <div>
            <h1 class="text-2xl font-extrabold text-gray-800 flex items-center">
                <i class="fas fa-chart-pie text-blue-600 mr-3"></i> Thống kê & Báo cáo
            </h1>
            <p class="text-gray-500 mt-1 text-sm">Báo cáo chi tiết hoạt động hệ thống</p>
        </div>
        <button onclick="window.print()" class="bg-blue-600 hover:bg-blue-700 text-white font-medium px-5 py-2.5 rounded-lg transition-all flex items-center shadow-md focus:ring-2 focus:ring-blue-300">
            <i class="fas fa-print mr-2"></i> In báo cáo
        </button>
    </div>

    <!-- 4 Cards chính -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5">
            <p class="text-gray-500 text-sm">Tổng số phòng</p>
            <p class="text-3xl font-bold text-gray-800">@Model.TongSoPhong</p>
            <div class="flex gap-3 mt-2 text-xs">
                <span class="text-green-600">Đã thuê: @Model.SoPhongDaThue</span>
                <span class="text-yellow-600">Trống: @Model.SoPhongTrong</span>
            </div>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5">
            <p class="text-gray-500 text-sm">Khách hàng</p>
            <p class="text-3xl font-bold text-gray-800">@Model.TongSoKhachHang</p>
            <p class="text-xs text-gray-400 mt-2">HĐ hiệu lực: @Model.SoHopDongHieuLuc</p>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5">
            <p class="text-gray-500 text-sm">Doanh thu tháng @DateTime.Now.Month</p>
            <p class="text-3xl font-bold text-gray-800">@Model.DoanhThuThangNay.ToString("N0") đ</p>
            <p class="text-xs text-gray-400 mt-2">Hôm nay: @Model.DoanhThuHomNay.ToString("N0") đ</p>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5">
            <p class="text-gray-500 text-sm">Công nợ</p>
            <p class="text-3xl font-bold text-red-500">@Model.TongNoHienTai.ToString("N0") đ</p>
            <p class="text-xs text-gray-400 mt-2">@Model.SoHoaDonChuaThanhToan hóa đơn chưa TT</p>
        </div>
    </div>

    <!-- Biểu đồ -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5">
            <h3 class="font-semibold text-gray-800 mb-4">📈 Doanh thu 12 tháng</h3>
            <canvas id="doanhThuChart" style="height: 280px;"></canvas>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5">
            <h3 class="font-semibold text-gray-800 mb-4">🥧 Trạng thái phòng</h3>
            <canvas id="trangThaiPhongChart" style="height: 280px;"></canvas>
        </div>
    </div>

    <!-- Top khách hàng -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100">
            <h3 class="font-semibold text-gray-800">🏆 Top khách hàng (Theo tổng tiền đã thanh toán)</h3>
        </div>
        <div class="p-4">
            @if (Model.TopKhachHangList != null && Model.TopKhachHangList.Any())
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead class="bg-gray-50 text-gray-500">
                            <tr class="border-b">
                                <th class="text-left py-3 px-3">#</th>
                                <th class="text-left py-3 px-3">Họ tên</th>
                                <th class="text-left py-3 px-3">Số điện thoại</th>
                                <th class="text-right py-3 px-3">Số hóa đơn</th>
                                <th class="text-right py-3 px-3">Tổng tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.TopKhachHangList.Count; i++)
                            {
                                var item = Model.TopKhachHangList[i];
                                <tr class="border-b hover:bg-gray-50">
                                    <td class="py-2 px-3">@(i + 1)</td>
                                    <td class="py-2 px-3">@item.HoTen</td>
                                    <td class="py-2 px-3">@item.SoDienThoai</td>
                                    <td class="py-2 px-3 text-right">@item.SoHoaDonDaThanhToan</td>
                                    <td class="py-2 px-3 text-right font-medium text-green-600">@item.TongTienDaThanhToan.ToString("N0") đ</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-gray-400 text-center py-6">Chưa có dữ liệu</p>
            }
        </div>
    </div>

    <!-- Hợp đồng sắp hết hạn -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100">
            <h3 class="font-semibold text-gray-800">⚠️ Hợp đồng sắp hết hạn (dưới 30 ngày)</h3>
        </div>
        <div class="p-4">
            @if (Model.HopDongSapHetHanList != null && Model.HopDongSapHetHanList.Any())
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead class="bg-gray-50 text-gray-500">
                            <tr class="border-b">
                                <th class="text-left py-3 px-3">Phòng</th>
                                <th class="text-left py-3 px-3">Khách hàng</th>
                                <th class="text-left py-3 px-3">Ngày kết thúc</th>
                                <th class="text-center py-3 px-3">Còn lại</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.HopDongSapHetHanList)
                            {
                                <tr class="border-b hover:bg-gray-50">
                                    <td class="py-2 px-3">@item.TenPhong</td>
                                    <td class="py-2 px-3">@item.TenKhachHang</td>
                                    <td class="py-2 px-3">@item.NgayKetThuc.ToString("dd/MM/yyyy")</td>
                                    <td class="py-2 px-3 text-center">
                                        <span class="bg-red-100 text-red-600 px-2 py-0.5 rounded-full text-xs">@item.SoNgayConLai ngày</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-gray-400 text-center py-6">Không có hợp đồng nào sắp hết hạn</p>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Doanh thu 12 tháng
        var doanhThuData = @Html.Raw(Json.Serialize(Model.DoanhThuTheoThangList));
        var labels1 = [], data1 = [];
        for (var i = 0; i < doanhThuData.length; i++) {
            labels1.push(doanhThuData[i].tenThang);
            data1.push(doanhThuData[i].doanhThu);
        }
        new Chart(document.getElementById('doanhThuChart'), {
            type: 'bar',
            data: { labels: labels1, datasets: [{ label: 'Doanh thu (đ)', data: data1, backgroundColor: '#3b82f6', borderRadius: 6 }] },
            options: { responsive: true, maintainAspectRatio: true, scales: { y: { beginAtZero: true, ticks: { callback: function(v) { return v.toLocaleString('vi-VN') + ' đ'; } } } } }
        });

        // Trạng thái phòng
        var trangThaiData = @Html.Raw(Json.Serialize(Model.TrangThaiPhongList));
        var labels2 = [], data2 = [];
        for (var i = 0; i < trangThaiData.length; i++) {
            labels2.push(trangThaiData[i].trangThai);
            data2.push(trangThaiData[i].soLuong);
        }
        new Chart(document.getElementById('trangThaiPhongChart'), {
            type: 'doughnut',
            data: { labels: labels2, datasets: [{ data: data2, backgroundColor: ['#10b981', '#f59e0b'] }] },
            options: { responsive: true, maintainAspectRatio: true, plugins: { legend: { position: 'bottom' } } }
        });
    </script>
}