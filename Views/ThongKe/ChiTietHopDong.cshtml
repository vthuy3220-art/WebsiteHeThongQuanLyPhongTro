@model IEnumerable<HeThongQuanLyPhongTro.Models.ChiTietHopDongViewModel>
@{
    ViewData["Title"] = "Chi tiết Hợp Đồng";
    Layout = "_Layout";
    int tongSo = ViewBag.TongSo ?? 0;
    int dangHieuLuc = ViewBag.DangHieuLuc ?? 0;
    int hetHan = ViewBag.HetHan ?? 0;
    int daHuy = ViewBag.DaHuy ?? 0;
}

<div class="bg-slate-50 min-h-screen p-6">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold text-gray-800">Thống kê trạng thái Hợp đồng</h1>
        <div>
            <a href="@Url.Action("XuatPDFChiTietHopDong", "ThongKe")" class="bg-teal-600 text-white px-4 py-2 rounded shadow hover:bg-teal-700 transition mr-2" style="text-decoration:none;">Xuất PDF</a>
            <a asp-action="Index" asp-controller="ThongKe" class="bg-gray-200 text-gray-700 px-4 py-2 rounded shadow hover:bg-gray-300 transition" style="text-decoration:none;">Quay lại Dashboard</a>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
        <div class="bg-white p-6 rounded-lg shadow col-span-1 border border-gray-100 flex flex-col justify-center">
            <h3 class="font-bold text-gray-500 mb-4 text-center">Tổng hợp đồng: <span class="text-2xl text-indigo-600">@tongSo</span></h3>
            <div class="space-y-4">
                <div class="flex justify-between items-center border-b pb-2">
                    <span class="flex items-center gap-2"><div class="w-3 h-3 rounded-full bg-teal-500"></div> Đang hiệu lực</span>
                    <span class="font-bold text-teal-600">@dangHieuLuc</span>
                </div>
                <div class="flex justify-between items-center border-b pb-2">
                    <span class="flex items-center gap-2"><div class="w-3 h-3 rounded-full bg-gray-400"></div> Hết hạn</span>
                    <span class="font-bold text-gray-600">@hetHan</span>
                </div>
                <div class="flex justify-between items-center border-b pb-2">
                    <span class="flex items-center gap-2"><div class="w-3 h-3 rounded-full bg-rose-500"></div> Đã hủy</span>
                    <span class="font-bold text-rose-600">@daHuy</span>
                </div>
            </div>
        </div>

        <div class="bg-white p-6 rounded-lg shadow col-span-2 border border-gray-100">
            <h3 class="font-bold text-gray-700 mb-4">Biểu đồ phân bổ trạng thái hợp đồng</h3>
            <div style="height: 250px; position: relative;" class="flex justify-center">
                <canvas id="hopDongChart"></canvas>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-lg shadow overflow-hidden border border-gray-100">
        <div class="p-4 bg-slate-100 border-b flex justify-between items-center">
            <h3 class="font-bold text-gray-700">DANH SÁCH HỢP ĐỒNG</h3>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead class="bg-gray-50 text-gray-600">
                    <tr>
                        <th class="p-4 border-b text-center" style="width: 5%;">STT</th>
                        <th class="p-4 border-b" style="width: 15%;">Mã HĐ</th>
                        <th class="p-4 border-b" style="width: 20%;">Khách thuê</th>
                        <th class="p-4 border-b" style="width: 15%;">Phòng</th>
                        <th class="p-4 border-b text-center" style="width: 15%;">Thời hạn</th>
                        <th class="p-4 border-b text-center" style="width: 15%;">Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int stt = 1;
                        foreach (var item in Model)
                        {
                            <tr class="hover:bg-gray-50 border-b">
                                <td class="p-4 text-center font-medium">@(stt++)</td>
                                <td class="p-4 font-bold text-gray-600">@item.MaHopDong</td>
                                <td class="p-4 text-gray-800">@item.TenKhachThue</td>
                                <td class="p-4 font-medium text-indigo-600">@item.TenPhong</td>
                                <td class="p-4 text-center text-sm text-gray-500">
                                    @(item.NgayBatDau?.ToString("dd/MM/yy")) - @(item.NgayKetThuc?.ToString("dd/MM/yy"))
                                </td>
                                <td class="p-4 text-center">
                                    @if (item.TrangThai == "Đang hiệu lực")
                                    {
                                        <span class="bg-teal-100 text-teal-700 px-3 py-1 rounded-full text-xs font-bold">Đang hiệu lực</span>
                                    }
                                    else if (item.TrangThai == "Hết hạn")
                                    {
                                        <span class="bg-gray-200 text-gray-700 px-3 py-1 rounded-full text-xs font-bold">Hết hạn</span>
                                    }
                                    else
                                    {
                                        <span class="bg-rose-100 text-rose-700 px-3 py-1 rounded-full text-xs font-bold">Đã hủy</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="p-6 text-center text-gray-500">Hệ thống chưa có dữ liệu hợp đồng.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        var ctx = document.getElementById('hopDongChart').getContext('2d');
        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['Đang hiệu lực', 'Hết hạn', 'Đã hủy'],
                datasets: [{
                    data: [@dangHieuLuc, @hetHan, @daHuy],
                    backgroundColor: ['#14b8a6', '#9ca3af', '#f43f5e'], // Teal, Gray, Rose
                    borderWidth: 2,
                    borderColor: '#ffffff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '65%',
                plugins: {
                    legend: { position: 'right' }
                }
            }
        });
    </script>
}