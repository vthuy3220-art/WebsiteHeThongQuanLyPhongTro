@model IEnumerable<HeThongQuanLyPhongTro.Models.ChiTietHopDongViewModel>
@{
    Layout = null;

    // ĐÃ SỬA: Đếm trực tiếp từ Model để không bao giờ bị rớt dữ liệu bằng 0 nữa
    int tongSo = Model?.Count() ?? 0;
    int dangHieuLuc = Model?.Count(x => x.TrangThai == "Đang hiệu lực") ?? 0;
    int hetHan = Model?.Count(x => x.TrangThai == "Hết hạn") ?? 0;
    int daHuy = Model?.Count(x => x.TrangThai == "Đã hủy") ?? 0;

    // Lấy tên người lập từ Controller truyền sang
    string nguoiLap = ViewBag.Username as string ?? "...................................";

    // Link tạo ảnh biểu đồ tự động
    string chartJson = "{type:'doughnut',data:{labels:['Đang hiệu lực','Hết hạn','Đã hủy'],datasets:[{data:[" + dangHieuLuc + "," + hetHan + "," + daHuy + "],backgroundColor:['#0d9488','#94a3b8','#e11d48']}]}}";
    string chartUrl = "https://quickchart.io/chart?w=450&h=220&c=" + Uri.EscapeDataString(chartJson);
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>Báo Cáo Hợp Đồng PDF</title>
    <style>
        body {
            font-family: 'Times New Roman', serif;
            color: black;
            font-size: 14px;
            margin: 0;
            padding: 0;
            line-height: 1.5;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }

        th, td {
            border: 1px solid black;
            padding: 8px;
        }

        th {
            background-color: #f2f2f2;
            text-align: center;
            font-weight: bold;
        }

        .summary-box {
            border: 2px solid #333;
            padding: 10px;
            text-align: center;
            margin-bottom: 20px;
            font-size: 16px;
            font-weight: bold;
            background: #e6f4ea;
        }

        .chart-container {
            text-align: center;
            margin-bottom: 30px;
        }
    </style>
</head>
<body>
    <table style="border: none; margin-bottom: 20px;">
        <tr style="border: none;">
            <td style="border: none; text-align: left; width: 40%; vertical-align: top;">
                <b>HỆ THỐNG QUẢN LÝ TRỌ</b><br />Người lập: @nguoiLap
            </td>
            <td style="border: none; text-align: center; width: 60%;">
                <b style="font-size: 16px;">CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</b><br />
                <u style="font-weight: bold;">Độc lập - Tự do - Hạnh phúc</u>
            </td>
        </tr>
    </table>

    <h2 style="text-align: center; text-transform: uppercase;">BÁO CÁO TÌNH TRẠNG HỢP ĐỒNG</h2>
    <p style="text-align: center; font-style: italic; margin-bottom: 20px;">(Ngày trích xuất: @DateTime.Now.ToString("dd/MM/yyyy HH:mm"))</p>

    <div class="summary-box">
        TỔNG SỐ HỢP ĐỒNG: @tongSo | ĐANG HIỆU LỰC: @dangHieuLuc | HẾT HẠN: @hetHan | ĐÃ HỦY: @daHuy
    </div>

    <div class="chart-container">
        <h3 style="text-align: center; margin-bottom: 10px; font-size: 15px;">Biểu đồ phân bổ trạng thái hợp đồng</h3>
        <img src="@chartUrl" width="450" height="220" style="display: block; margin: 0 auto;" />
    </div>

    <table>
        <thead>
            <tr>
                <th style="width: 5%;">STT</th>
                <th style="width: 15%;">Mã HĐ</th>
                <th style="width: 25%;">Khách thuê</th>
                <th style="width: 15%;">Phòng</th>
                <th style="width: 25%;">Thời hạn</th>
                <th style="width: 15%;">Trạng thái</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                int stt = 1;
                foreach (var item in Model)
                {
                    <tr>
                        <td style="text-align: center;">@(stt++)</td>
                        <td style="text-align: center; font-weight: bold;">@item.MaHopDong</td>
                        <td>@item.TenKhachThue</td>
                        <td style="text-align: center;">@item.TenPhong</td>
                        <td style="text-align: center;">
                            @(item.NgayBatDau?.ToString("dd/MM/yyyy")) - @(item.NgayKetThuc?.ToString("dd/MM/yyyy"))
                        </td>
                        <td style="text-align: center;">@item.TrangThai</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" style="text-align: center;">Chưa có dữ liệu hợp đồng.</td>
                </tr>
            }
        </tbody>
    </table>

    <table style="border: none; margin-top: 40px; page-break-inside: avoid;">
        <tr style="border: none;">
            <td style="border: none; width: 55%;"></td>
            <td style="border: none; width: 45%; text-align: center;">
                <i>Ngày @DateTime.Now.Day tháng @DateTime.Now.Month năm @DateTime.Now.Year</i><br />
                <b style="font-size: 15px;">Người lập biểu</b><br />
                <i style="font-size: 12px; color: #555;">(Ký, ghi rõ họ tên)</i><br /><br /><br /><br />
                <b style="font-size: 15px;">@nguoiLap</b>
            </td>
        </tr>
    </table>
</body>
</html>