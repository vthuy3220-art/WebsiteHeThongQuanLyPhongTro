@model IEnumerable<HeThongQuanLyPhongTro.Models.ThongKeCoSoViewModel>
@{
    ViewData["Title"] = "Chi tiết Phòng theo Tòa nhà";
    Layout = "_Layout";
    int tongPhong = ViewBag.TongPhong ?? 0;
    int tongDaThue = ViewBag.TongDaThue ?? 0;
    int tongTrong = ViewBag.TongTrong ?? 0;

    var danhSachToaNha = ViewBag.DanhSachToaNha as IEnumerable<HeThongQuanLyPhongTro.Models.ToaNha>;
    int? selectedMaToaNha = ViewBag.SelectedMaToaNha as int?;
}

<div class="bg-slate-50 min-h-screen p-6">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4">
        <h1 class="text-2xl font-bold text-gray-800">Tình trạng lấp đầy phòng theo Tòa nhà</h1>

        <div class="flex gap-2 flex-wrap items-center">
            <form method="get" asp-action="ChiTietPhong" asp-controller="ThongKe" class="flex gap-2 items-center">
                <select name="maToaNha" class="border border-gray-300 rounded px-3 py-2 bg-white shadow-sm font-medium text-gray-700">
                    <option value="">-- Tất cả tòa nhà --</option>
                    @if (danhSachToaNha != null)
                    {
                        foreach (var t in danhSachToaNha)
                        {
                            <option value="@t.MaToaNha" selected="@(selectedMaToaNha == t.MaToaNha ? "selected" : null)">
                                @t.TenToaNha
                            </option>
                        }
                    }
                </select>
                <button type="submit" class="bg-indigo-600 text-white px-4 py-2 rounded shadow hover:bg-indigo-700 transition">Lọc</button>
            </form>

            <a href="@Url.Action("XuatPDFChiTietPhong", "ThongKe", new { maToaNha = selectedMaToaNha })" class="bg-teal-600 text-white px-4 py-2 rounded shadow hover:bg-teal-700 transition" style="text-decoration:none;">Xuất PDF</a>
            <a asp-action="Index" asp-controller="ThongKe" class="bg-gray-200 text-gray-700 px-4 py-2 rounded shadow hover:bg-gray-300 transition" style="text-decoration:none;">Trở về</a>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
        <div class="bg-white p-6 rounded-lg shadow col-span-1 border border-gray-100">
            <h3 class="font-bold text-gray-700 mb-4 text-center">Tổng quan hệ thống</h3>
            <div style="height: 250px; position: relative;">
                <canvas id="tongQuanChart"></canvas>
            </div>
            <div class="mt-4 text-center">
                <span class="text-lg font-bold text-teal-600">Tổng: @tongPhong phòng</span>
            </div>
        </div>

        <div class="bg-white p-6 rounded-lg shadow col-span-2 border border-gray-100">
            <h3 class="font-bold text-gray-700 mb-4">Biểu đồ lấp đầy từng tòa nhà</h3>
            <div style="height: 280px;">
                <canvas id="toaNhaChart"></canvas>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-lg shadow overflow-hidden border border-gray-100">
        <div class="p-4 bg-slate-100 border-b">
            <h3 class="font-bold text-gray-700">Chi tiết số liệu từng tòa nhà</h3>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead class="bg-gray-50 text-gray-600">
                    <tr>
                        <th class="p-4 border-b">Tên Tòa nhà</th>
                        <th class="p-4 border-b text-center">Tổng phòng</th>
                        <th class="p-4 border-b text-center text-teal-600">Đã thuê</th>
                        <th class="p-4 border-b text-center text-rose-500">Phòng trống</th>
                        <th class="p-4 border-b text-right text-indigo-600">Tần suất sử dụng</th>
                        <th class="p-4 border-b text-right">Tỷ lệ lấp đầy</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-gray-50 border-b">
                            <td class="p-4 font-medium text-gray-800">@item.TenCoSo</td>
                            <td class="p-4 text-center font-bold">@item.TongSoPhong</td>
                            <td class="p-4 text-center text-teal-600 font-medium">@item.SoPhongDaThue</td>
                            <td class="p-4 text-center text-rose-500 font-medium">@item.SoPhongTrong</td>
                            <td class="p-4 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <span class="text-sm font-bold text-indigo-600">@item.TyLeSuDung%</span>
                                    <div class="w-16 bg-gray-200 rounded-full h-2">
                                        <div class="bg-indigo-500 h-2 rounded-full" style="width: @(item.TyLeSuDung)%"></div>
                                    </div>
                                </div>
                            </td>
                            <td class="p-4 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <span class="text-sm font-bold">@item.TyLeSuDung%</span>
                                    <div class="w-24 bg-gray-200 rounded-full h-2.5">
                                        <div class="bg-teal-500 h-2.5 rounded-full" style="width: @(item.TyLeSuDung)%"></div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // 1. Biểu đồ tròn (Tổng quan)
        var ctxTong = document.getElementById('tongQuanChart').getContext('2d');
        new Chart(ctxTong, {
        type: 'doughnut',
        data: {
        labels: ['Đã thuê', 'Trống'],
        datasets: [{
        data: [@tongDaThue, @tongTrong],
        backgroundColor: ['#0d9488', '#f43f5e'],
        borderWidth: 0
        }]
        },
        options: { responsive: true, maintainAspectRatio: false, cutout: '70%' }
        });

        // 2. Biểu đồ cột (Từng Tòa nhà)
        var toaNhaLabels = [];
        var daThueData = [];
        var trongData = [];

        @foreach (var item in Model)
        {
                <text>
                    toaNhaLabels.push('@Html.Raw(item.TenCoSo)');
                    daThueData.push(@item.SoPhongDaThue);
                    trongData.push(@item.SoPhongTrong);
                </text>
        }

        var ctxToaNha = document.getElementById('toaNhaChart').getContext('2d');
        new Chart(ctxToaNha, {
        type: 'bar',
        data: {
        labels: toaNhaLabels,
        datasets: [
        { label: 'Đã thuê', data: daThueData, backgroundColor: '#0d9488', borderRadius: 4, maxBarThickness: 80 },
        { label: 'Phòng trống', data: trongData, backgroundColor: '#f43f5e', borderRadius: 4, maxBarThickness: 80 }
        ]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: {
        x: { stacked: true },
        y: {
        stacked: true,
        beginAtZero: true,
        ticks: { stepSize: 1 } // Hiển thị số nguyên cho số phòng
        }
        }
        }
        });
    </script>
}